;; The prelude of the module proofs.sh writes.
(language bend)

(law (cong [- A : Type] [- B : Type] [- f : (-> A B)] [- a : A] [- b : A] [e : (== a b A)]) (== (f a) (f b) B))
(def (cong A B f a b e) (rewrite e (== (f a) (f _) B) refl))

(type Nat Data [Z] [S [pred : Nat]])
(type (Sigma [- A : Type] [- B : (-> [- x : A] Type)]) Type [Tuple [fst : A] [snd : (B fst)]])

(law (Pair [- A : Type] [- B : Type]) Type)
(def (Pair A B) (Sigma A (fn (_) B)))
(law (Cpy [- A : Type] [- x : A]) Type)
(def (Cpy A x) (Sigma A (fn (y) (== x y A))))
(law (Cpyable [- T : Type]) Type)
(def (Cpyable T) (-> [x : T] (Pair (Cpy T x) (Cpy T x))))

(law (Equal.cong2 [- A : Type] [- B : Type] [- C : Type] [- f : (-> A [y : B] C)] [- a : A] [- c : A] [- b : B] [- d : B] [ea : (== a c A)] [eb : (== b d B)]) (== (f a b) (f c d) C))
(def (Equal.cong2 A B C f a c b d ea eb) (rewrite eb (== (f a b) (f c _) C) (rewrite ea (== (f a b) (f _ b) C) refl)))

(law (add [a : Nat] [b : Nat]) Nat)
(def (add a b) (match a [Z b] [(S a) (S (add a b))]))
(law (Nat.cpy [n : Nat]) (Pair (Cpy Nat n) (Cpy Nat n)))
(law (Nat.cpy.succ [- p : Nat] [c : (Pair (Cpy Nat p) (Cpy Nat p))]) (Pair (Cpy Nat (S p)) (Cpy Nat (S p))))
(def (Nat.cpy.succ p c)
  (match c [(Tuple (Tuple a ea) (Tuple b eb))
            (Tuple (Tuple (S a) (cong Nat Nat (fn (x) (S x)) p a ea)) (Tuple (S b) (cong Nat Nat (fn (x) (S x)) p b eb)))]))
(def (Nat.cpy n) (match n [Z (Tuple (Tuple Z refl) (Tuple Z refl))] [(S p) (Nat.cpy.succ p (Nat.cpy p))]))
(law (add_zero [a : Nat]) (== (add a Z) a Nat))
(def (add_zero a) (match a [Z refl] [(S a) (rewrite (add_zero a) (== (S (add a Z)) (S _) Nat) refl)]))
(law (add_succ [a : Nat] [- b : Nat]) (== (S (add a b)) (add a (S b)) Nat))
(def (add_succ a b) (match a [Z refl] [(S a) (rewrite (add_succ a b) (== (S (S (add a b))) (S _) Nat) refl)]))
(law (add_comm [a : Nat] [+ b : Nat]) (== (add a b) (add b a) Nat))
(def (add_comm a b)
  (match a
    [Z (rewrite (add_zero b) (== _ (add b Z) Nat) refl)]
    [(S a) (rewrite (add_succ b a) (== (S (add a b)) _ Nat) (rewrite (add_comm a b) (== (S (add a b)) (S _) Nat) refl))]))
