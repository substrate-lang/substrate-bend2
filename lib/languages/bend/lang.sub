;; Bend's forms: Bend2's dependently typed, affine language, in s-expressions.

(require %bend-rt "runtime.sub")

;; A program's main is Substrate code: (define (main) (print e) ...).
(provide [type bend-type] [def bend-def] [law bend-law] [match bend-match] [fn bend-fn] [-> bend-arrow]
         [let bend-let] [split bend-split] [absurd bend-absurd] [== bend-eql] [refl bend-refl]
         [rewrite bend-rewrite] [the bend-the] [? bend-hole] [nat bend-nat] [Kind bend-kind] [meet bend-meet]
         [Type bend-Type] [Data bend-Data] [Quant bend-Quant] [&0 bend-q0] [&1 bend-q1] [&2 bend-q2]
         [print bend-print] [live-nodes bend-live-nodes] [#%datum bend-datum] [#%module-begin bend-module-begin]
         define printf)

(require macros "../../../compiler/macros.sub" define-macro)
(begin-for-syntax
  (require-unqualified macros "../../../compiler/macros.sub")
  (require-unqualified core "core.sub")
  (require-unqualified lower "lower.sub")

  (define (bend-fail [stx datum] [form string] [args datum]) -> (ptr term)
    (raise-syntax-error 'bend (format-message form args) stx)
    0)

  (define (list1 [x datum]) -> datum (cons x nil))
  (define (plural [n u32]) -> datum (if (== n 1) `"" `"s"))

  ;; ---- what a name is ----

  (define keywords (ptr hash-table) 0)
  (define (keyword! [id datum] [n u32]) (hash-set! keywords (cast u64 (identifier-name id)) n))

  (define kw-fn u32 1) (define kw-arrow u32 2) (define kw-let u32 3) (define kw-match u32 4)
  (define kw-split u32 5) (define kw-absurd u32 6) (define kw-eql u32 7) (define kw-refl u32 8)
  (define kw-rewrite u32 9) (define kw-the u32 10) (define kw-hole u32 11) (define kw-nat u32 12)
  (define kw-kind u32 13) (define kw-meet u32 14) (define kw-Type u32 15) (define kw-Data u32 16)
  (define kw-Quant u32 17) (define kw-q0 u32 18) (define kw-q1 u32 19) (define kw-q2 u32 20)

  (struct kind [what u32] [n u32] [g u32])
  (define kinds (ptr hash-table) 0)
  (define home (ptr arena) 0)
  (define generation u32 1)

  (define (new-kind [what u32] [n u32] [g u32]) -> (ptr kind)
    (let ([k (cast (ptr kind) (arena-alloc home (sizeof kind)))])
      (set! (-> k what) what)
      (set! (-> k n) n)
      (set! (-> k g) g)
      k))

  (define (kind! [name datum] [what u32] [n u32] [g u32])
    (hash-set! kinds (cast u64 name) (cast u32 (new-kind what n g)))
    (+= generation 1))

  (define (name-kind [name datum]) -> (ptr kind)
    (let ([known (cast (ptr kind) (hash-ref kinds (cast u64 name)))])
      (if (!= known 0)
          (if (== (-> known what) 0) 0 known)
          (let ([k (fact-kind name)])
            (hash-set! kinds (cast u64 name) (cast u32 (if (!= k 0) k (new-kind 0 0 0))))
            k))))

  (define (fact-kind [name datum]) -> (ptr kind)
    (let ([fs (name-facts name)])
      (for/each ([f fs])
        (let ([c (cursor-of f)])
          (case (dec-byte (& c))
            [(1) (let* ([n (dec-u (& c))] [g (dec-u (& c))]) (return (new-kind 2 n g)))]
            [(2) (dec-sym (& c)) (return (new-kind 3 (dec-u (& c)) 0))]
            [(3) (return (new-kind 1 0 0))]
            [(5) (return (new-kind 4 (dec-u (& c)) 0))]
            [else 0])))
      0))

  (define (name-facts [name datum]) -> datum
    (let ([fs (syntax-local-facts (name-identifier name))] [out nil])
      (for/each ([f fs])
        (let ([v (caddr f)]) (when (and (pair? v) (bytes? (car v))) (set! out (cons v out)))))
      (reverse out)))

  ;; what: 0 for nothing of Bend's, a name's kind, or 10 + k for keyword k.
  (struct idinfo [what u32] [n u32] [g u32] [name datum] [generation u32])
  (define ids (ptr hash-table) 0)

  (define (classify [id datum]) -> (ptr idinfo)
    (let* ([key (bit-or (<< (cast u64 (syntax-e id)) 32) (cast u64 (cast u32 (syntax-scopes id))))]
           [known (cast (ptr idinfo) (hash-ref ids key))])
      (if (and (!= known 0) (or (!= (-> known what) 0) (== (-> known generation) generation)))
          known
          (let ([info (cast (ptr idinfo) (arena-alloc home (sizeof idinfo)))] [name (identifier-name id)])
            (set! (-> info what) 0)
            (set! (-> info name) name)
            (set! (-> info generation) generation)
            (unless (== name 0)
              (let ([k (hash-ref keywords (cast u64 name))])
                (if (!= k 0)
                    (set! (-> info what) (+ 10 k))
                    (let ([nk (name-kind name)])
                      (unless (== nk 0)
                        (set! (-> info what) (-> nk what))
                        (set! (-> info n) (-> nk n))
                        (set! (-> info g) (-> nk g)))))))
            (hash-set! ids key (cast u32 info))
            info))))

  (define (keyword-of [id datum]) -> u32
    (let ([w (-> (classify id) what)]) (if (> w 10) (- w 10) 0)))

  (define (base-prefix) -> datum
    (let* ([name (symbol->string (identifier-name #'bend-type))] [n (-> name length)] [i u32 0] [dir u32 0])
      (while (and (< i n) (!= (@ name i) #\:))
        (when (== (@ name i) #\/) (set! dir (+ i 1)))
        (+= i 1))
      (fmt "~abase.sub:" (string->datum (slice name 0 dir)))))

  (define (start!)
    (when (== keywords 0)
      (set! home (current-arena))
      (book-start!)
      (set-lookup! lookup)
      (set-rewrite! template-call)
      (set! templates (make-table))
      (set! instances (make-table))
      (set! counts (make-table))
      (set! required (make-table))
      (set! codes (make-table))
      (lower-start! code-of (base-prefix))
      (set! gen (syntax-local-introduce (datum->syntax #'here 'bend 0)))
      (set! keywords (make-table))
      (set! kinds (make-table))
      (set! ids (make-table))
      (keyword! #'bend-fn kw-fn) (keyword! #'bend-arrow kw-arrow) (keyword! #'bend-let kw-let)
      (keyword! #'bend-match kw-match) (keyword! #'bend-split kw-split) (keyword! #'bend-absurd kw-absurd)
      (keyword! #'bend-eql kw-eql) (keyword! #'bend-refl kw-refl) (keyword! #'bend-rewrite kw-rewrite)
      (keyword! #'bend-the kw-the) (keyword! #'bend-hole kw-hole) (keyword! #'bend-nat kw-nat)
      (keyword! #'bend-kind kw-kind) (keyword! #'bend-meet kw-meet) (keyword! #'bend-Type kw-Type)
      (keyword! #'bend-Data kw-Data) (keyword! #'bend-Quant kw-Quant) (keyword! #'bend-q0 kw-q0)
      (keyword! #'bend-q1 kw-q1) (keyword! #'bend-q2 kw-q2)
      (keyword! #'bend-type 30) (keyword! #'bend-def 31) (keyword! #'bend-law 32) (keyword! #'bend-datum 33)))

  ;; ---- reading terms ----

  (struct local [k datum] [i i32] [hidden i32] [next (ptr local)])

  (define (bind [ev (ptr local)] [k datum] [i i32] [hidden i32]) -> (ptr local)
    (let ([l (cast (ptr local) (arena-alloc (current-arena) (sizeof local)))])
      (set! (-> l k) k)
      (set! (-> l i) i)
      (set! (-> l hidden) hidden)
      (set! (-> l next) ev)
      l))

  (define (local-of [ev (ptr local)] [k datum]) -> (ptr local)
    (while (!= ev 0)
      (when (and (== (-> ev k) k) (not (-> ev hidden))) (return ev))
      (set! ev (-> ev next)))
    0)

  (define (loc [e datum]) -> (ptr srcloc) (syntax-srcloc e))

  (define (read-term [e datum] [ev (ptr local)]) -> (ptr term)
    (if (identifier? e)
        (read-identifier e ev)
        (let ([l (syntax->list e)])
          (cond [(and (!= l 0) (pair? l)) (read-form e l ev)]
                [(integer? (syntax-e e))
                 (read-u32 e)]
                [else (bend-fail e "this is not a Bend term" nil)]))))

  (define (read-identifier [e datum] [ev (ptr local)]) -> (ptr term)
    (let ([v (local-of ev (syntax-e e))])
      (if (!= v 0)
          (new-term (Var (syntax-e e) (-> v i) 0 (loc e)))
          (let ([info (classify e)])
            (cond [(> (-> info what) 10) (read-keyword (- (-> info what) 10) e (list1 e) ev)]
                  [(> (-> info what) 0) (read-name info e e nil ev)]
                  [else (bend-fail e "~a is not a variable or a definition of Bend" (list1 (syntax-e e)))])))))

  (define (apps [s (ptr srcloc)] [f (ptr term)] [args datum] [ev (ptr local)]) -> (ptr term)
    (for/each ([arg args])
      (set! f (new-term (App f (read-term arg ev) s))))
    f)

  (define (read-form [e datum] [l datum] [ev (ptr local)]) -> (ptr term)
    (let ([h (car l)])
      (if (identifier? h)
          (let ([v (local-of ev (syntax-e h))])
            (if (!= v 0)
                (apps (loc e) (new-term (Var (syntax-e h) (-> v i) 0 (loc h))) (cdr l) ev)
                (let ([info (classify h)])
                  (cond [(> (-> info what) 10) (read-keyword (- (-> info what) 10) e l ev)]
                        [(> (-> info what) 0) (read-name info h e (cdr l) ev)]
                        [else (bend-fail h "~a is not a variable or a definition of Bend" (list1 (syntax-e h)))]))))
          (apps (loc e) (read-term h ev) (cdr l) ev))))

  (define (read-name [info (ptr idinfo)] [h datum] [e datum] [args datum] [ev (ptr local)]) -> (ptr term)
    (let ([name (-> info name)])
      (case (-> info what)
        [(1) (apps (loc e) (new-term (Ref name (loc h))) args ev)]
        [(4) (set! template-read 1) (apps (loc e) (new-term (Ref name (loc h))) args ev)]
        [(2)
         (if (and (null? args) (> (-> info n) 0))
             (new-term (Ref name (loc e)))
             (let* ([given (length args)] [fill (if (== (+ given (-> info g)) (-> info n)) (-> info g) 0)]
                    [n (+ given fill)] [xs (term-array n)] [a args])
               (for ([j u32 0]) (< j fill) (+= j 1) (set! (@ xs j) (new-term (Qua 1 (loc e)))))
               (for ([j u32 fill]) (< j n) (+= j 1)
                 (set! (@ xs j) (read-term (car a) ev))
                 (set! a (cdr a)))
               (new-term (ADT name n xs nil (loc e)))))]
        [else
         (let* ([n (length args)] [xs (term-array n)] [a args])
           (for ([j u32 0]) (< j n) (+= j 1)
             (set! (@ xs j) (read-term (car a) ev))
             (set! a (cdr a)))
           (new-term (Ctr name n xs (loc e))))])))

  (define (parts [e datum] [l datum] [n u32] [expected string]) -> datum
    (unless (== (length l) (+ n 1)) (bend-fail e expected nil))
    (cdr l))

  (define (read-keyword [kw u32] [e datum] [l datum] [ev (ptr local)]) -> (ptr term)
    (case kw
      [(1) (let ([p (parts e l 2 "expected (fn (x ...) t)")])
             (let ([xs (syntax->list (car p))])
               (when (or (== xs 0) (null? xs)) (bend-fail e "expected (fn (x ...) t), with a variable" nil))
               (read-fn xs (cadr p) ev)))]
      [(2) (when (< (length l) 3) (bend-fail e "expected (-> A ... B), with a domain" nil))
           (read-arrow (arrow-specs (cdr l)) (last-of l) ev (loc e))]
      [(3) (read-let e l ev)]
      [(4) (bend-fail e "expected a match only as a body, a definition's or a case's: a term splits with split" nil)]
      [(5) (let* ([p (parts e l 3 "expected (split C h m)")] [c (car p)])
             (unless (and (identifier? c) (== (-> (classify c) what) 3)) (bend-fail c "expected a constructor" nil))
             (new-term (Mat (-> (classify c) name) (read-term (cadr p) ev) (read-term (caddr p) ev) (loc e))))]
      [(6) (new-term (Efq (loc e)))]
      [(7) (let ([p (parts e l 3 "expected (== a b T)")])
             (new-term (Eql (read-term (car p) ev) (read-term (cadr p) ev) (read-term (caddr p) ev) (loc e))))]
      [(8) (new-term (Rfl (loc e)))]
      [(9) (let* ([p (parts e l 3 "expected (rewrite e P f)")] [i (fresh!)] [j (fresh!)]
                  [pev (bind (bind ev '_ i 0) 'e j 1)])
             (new-term (Rwt (read-term (car p) ev)
                            (new-term (Lam '_ i (new-term (Lam 'e j (read-term (cadr p) pev) 0 (loc e))) 0 (loc e)))
                            (read-term (caddr p) ev)
                            (loc e))))]
      [(10) (let ([p (parts e l 2 "expected (the T x)")])
              (new-term (Ann (read-term (cadr p) ev) (read-term (car p) ev) (loc e))))]
      [(11) (let ([p (parts e l 1 "expected (? name)")])
              (unless (identifier? (car p)) (bend-fail e "expected (? name)" nil))
              (new-term (Hol (syntax-e (car p)) (loc e))))]
      [(12) (read-nat e l)]
      [(13) (let ([p (parts e l 1 "expected (Kind g)")]) (new-term (Typ (read-term (car p) ev) (loc e))))]
      [(14) (let ([p (parts e l 2 "expected (meet a b)")])
              (new-term (Min (read-term (car p) ev) (read-term (cadr p) ev) (loc e))))]
      [(15) (new-term (Typ (new-term (Qua 1 (loc e))) (loc e)))]
      [(16) (new-term (Typ (new-term (Qua 2 (loc e))) (loc e)))]
      [(17) (new-term (Qnt (loc e)))]
      [(18) (new-term (Qua 0 (loc e)))]
      [(19) (new-term (Qua 1 (loc e)))]
      [(20) (new-term (Qua 2 (loc e)))]
      [else (bend-fail e "this is not a Bend term" nil)]))

  (define (last-of [l datum]) -> datum
    (while (pair? (cdr l)) (set! l (cdr l)))
    (car l))

  (define (read-fn [xs datum] [body datum] [ev (ptr local)]) -> (ptr term)
    (if (null? xs)
        (read-term body ev)
        (let ([x (car xs)] [i (fresh!)])
          (unless (identifier? x) (bend-fail x "expected (fn (x ...) t)" nil))
          (new-term (Lam (syntax-e x) i (read-fn (cdr xs) body (bind ev (syntax-e x) i 0)) 0 (loc x))))))

  (struct spec [q u32] [x datum] [A datum])

  (define (new-spec [q u32] [x datum] [A datum]) -> (ptr spec)
    (let ([s (cast (ptr spec) (arena-alloc (current-arena) (sizeof spec)))])
      (set! (-> s q) q)
      (set! (-> s x) x)
      (set! (-> s A) A)
      s))

  (define (named-symbol? [d datum] [name datum]) -> i32 (and (identifier? d) (== (syntax-e d) name)))

  (define (bind-spec [b datum]) -> (ptr spec)
    (let ([l (syntax->list b)])
      (cond [(or (== l 0) (null? l)) 0]
            [(and (== (length l) 3) (identifier? (car l)) (named-symbol? (cadr l) ':))
             (new-spec 1 (car l) (caddr l))]
            [(and (== (length l) 4) (identifier? (cadr l)) (named-symbol? (caddr l) ':))
             (cond [(named-symbol? (car l) '-) (new-spec 0 (cadr l) (cadddr l))]
                   [(named-symbol? (car l) '+) (new-spec 2 (cadr l) (cadddr l))]
                   [(named-symbol? (car l) '~) (new-spec 3 (cadr l) (cadddr l))]
                   [else 0])]
            [else 0])))

  (define (arrow-specs [l datum]) -> datum
    (let ([out nil])
      (while (pair? (cdr l))
        (let ([s (bind-spec (car l))])
          (set! out (cons (cast datum (if (!= s 0) s (new-spec 1 0 (car l)))) out)))
        (set! l (cdr l)))
      (reverse out)))

  (define (read-arrow [specs datum] [B datum] [ev (ptr local)] [s (ptr srcloc)]) -> (ptr term)
    (if (null? specs)
        (read-term B ev)
        (let* ([sp (cast (ptr spec) (car specs))] [i (fresh!)] [named (!= (-> sp x) 0)]
               [k (if named (syntax-e (-> sp x)) '_)])
          (when (== (-> sp q) 3)
            (bend-fail (-> sp x) "expected ~ only on a def's first parameters, which make it a template" nil))
          (new-term (All (-> sp q) k i (read-term (-> sp A) ev)
                         (read-arrow (cdr specs) B (bind ev k i (not named)) s) 0
                         (if named (loc (-> sp x)) s))))))

  (define (read-let [e datum] [l datum] [ev (ptr local)]) -> (ptr term)
    (unless (== (length l) 3) (bend-fail e "expected (let ([q x v] ...) t)" nil))
    (let* ([bs (syntax->list (cadr l))] [n (if (== bs 0) 0 (length bs))]
           [ks (cast (ptr datum) (arena-alloc (current-arena) (* n 4)))] [is (cast (ptr i32) (arena-alloc (current-arena) (* n 4)))]
           [qs (cast (ptr u32) (arena-alloc (current-arena) (* n 4)))] [vs (term-array n)] [bev ev])
      (when (== n 0) (bend-fail e "expected (let ([q x v] ...) t), with a binding" nil))
      (for ([j u32 0]) (< j n) (+= j 1)
        (let* ([b (syntax->list (car bs))] [q u32 1] [x datum 0] [v datum 0])
          (cond [(and (!= b 0) (== (length b) 2) (identifier? (car b))) (set! x (car b)) (set! v (cadr b))]
                [(and (!= b 0) (== (length b) 3) (identifier? (cadr b)) (named-symbol? (car b) '-))
                 (set! q 0) (set! x (cadr b)) (set! v (caddr b))]
                [(and (!= b 0) (== (length b) 3) (identifier? (cadr b)) (named-symbol? (car b) '+))
                 (set! q 2) (set! x (cadr b)) (set! v (caddr b))]
                [else (bend-fail (car bs) "expected a binding: [q x v]" nil)])
          (set! (@ ks j) (syntax-e x))
          (set! (@ is j) (fresh!))
          (set! (@ qs j) q)
          (set! (@ vs j) (read-term v ev))
          (set! bev (bind bev (syntax-e x) (@ is j) 0)))
        (set! bs (cdr bs)))
      (new-term (Let n ks is qs vs (read-term (caddr l) bev) 0 (loc e)))))

  (define (read-nat [e datum] [l datum]) -> (ptr term)
    (let ([p (parts e l 1 "expected (nat n), n a natural number")])
      (unless (and (integer? (syntax-e (car p))) (>= (integer-value (syntax-e (car p))) 0)
                   (< (integer-value (syntax-e (car p))) 4294967296))
        (bend-fail e "expected (nat n), n a natural number below 2^32" nil))
      (new-term (Nat (constructor-named e 'Zero) (constructor-named e 'Succ)
                     (cast u32 (integer-value (syntax-e (car p)))) (loc e)))))

  (define (read-u32 [e datum]) -> (ptr term)
    (let ([n (integer-value (syntax-e e))])
      (unless (and (>= n 0) (< n 4294967296)) (bend-fail e "expected a U32, a number from 0 to 4294967295" nil))
      (let* ([wcon (constructor-named e 'WCon)] [one (constructor-named e 'True)]
             [nought (constructor-named e 'False)] [w (new-term (Ctr (constructor-named e 'WNil) 0 0 (loc e)))]
             [xs (term-array 1)])
        (for ([i i32 31]) (>= i 0) (-= i 1)
          (let ([ys (term-array 2)])
            (set! (@ ys 0) (new-term (Ctr (if (!= (bit-and (>> n i) 1) 0) one nought) 0 0 (loc e))))
            (set! (@ ys 1) w)
            (set! w (new-term (Ctr wcon 2 ys (loc e))))))
        (set! (@ xs 0) w)
        (new-term (Ctr (constructor-named e 'u32) 1 xs (loc e))))))

  (define (constructor-named [e datum] [k datum]) -> datum
    (let* ([id (datum->syntax e k e)] [info (classify id)])
      (unless (== (-> info what) 3) (bend-fail id "~a is not a variable or a definition of Bend" (list1 k)))
      (-> info name)))

  ;; ---- bodies ----

  (define (read-body [e datum] [ev (ptr local)]) -> (ptr term)
    (let ([l (syntax->list e)])
      (if (and (!= l 0) (pair? l) (identifier? (car l)) (== (local-of ev (syntax-e (car l))) 0)
               (== (keyword-of (car l)) kw-match))
          (read-match e (cdr l) ev)
          (read-term e ev))))

  (define (read-match [e datum] [l datum] [ev (ptr local)]) -> (ptr term)
    (let ([es nil] [rows nil] [n u32 0])
      (while (and (pair? l) (identifier? (car l)))
        (set! es (cons (cast datum (read-term (car l) ev)) es))
        (+= n 1)
        (set! l (cdr l)))
      (when (== n 0)
        (bend-fail (if (pair? l) (car l) e)
                   "expected a parameter or field scrutinee (a match cannot scrutinize a computed value: give it its own def)" nil))
      (for/each ([row l])
        (let ([r (syntax->list row)] [rev ev] [ps nil] [binds nil])
          (unless (and (!= r 0) (== (length r) 2)) (bend-fail row "expected a row [pattern body]" nil))
          (set! pluses nil)
          (let ([pl (if (== n 1) (list1 (car r)) (syntax->list (car r)))])
            (when (== pl 0) (bend-fail (car r) "expected (pattern ...)" nil))
            (unless (== (length pl) n) (bend-fail row "expected ~a pattern~a" `(,(make-integer n) ,(plural n))))
            (for/each ([pat pl])
              (let ([pr (read-pattern pat rev)])
                (set! ps (cons (cast datum (-> pr p)) ps))
                (set! rev (-> pr ev)))))
          (let ([q (reverse pluses)])
            (set! pluses nil)
            (for/each ([plus q])
              (let ([x (car plus)] [j (fresh!)])
                (set! rev (bind rev (syntax-e x) j 0))
                (set! binds (cons `(,x ,(cdr plus) ,(make-integer j)) binds)))))
          (set! rows (cons (cast datum (new-row (reverse ps) (plus-wrap (read-body (cadr r) rev) (reverse binds)))) rows))))
      (new-term (Match (reverse es) (reverse rows) (loc e)))))

  (define pluses datum 0)

  (define (plus-wrap [b (ptr term)] [binds datum]) -> (ptr term)
    (cond [(null? binds) b]
          [(Match? b)
           (let ([es datum 0] [rs datum 0] [s (ptr srcloc) 0] [out nil])
             (match b [(Match me mr ms) (set! es me) (set! rs mr) (set! s ms)] [_ 0])
             (for/each ([r rs])
               (let ([rw (cast (ptr row) r)])
                 (set! out (cons (cast datum (new-row (-> rw ps) (plus-wrap (-> rw body) binds))) out))))
             (new-term (Match es (reverse out) s)))]
          [else
           (let* ([n (length binds)] [ks (cast (ptr datum) (arena-alloc (current-arena) (* n 4)))]
                  [is (cast (ptr i32) (arena-alloc (current-arena) (* n 4)))] [qs (cast (ptr u32) (arena-alloc (current-arena) (* n 4)))]
                  [vs (term-array n)] [l binds])
             (for ([j u32 0]) (< j n) (+= j 1)
               (let ([x (car (car l))])
                 (set! (@ ks j) (syntax-e x))
                 (set! (@ is j) (cast i32 (integer-value (caddr (car l)))))
                 (set! (@ qs j) 2)
                 (set! (@ vs j) (new-term (Var (syntax-e x) (cast i32 (integer-value (cadr (car l)))) 0 (loc x)))))
               (set! l (cdr l)))
             (new-term (Let n ks is qs vs b 0 (term-s b))))]))

  (struct patread [p (ptr pat)] [ev (ptr local)])

  (define (read-pattern [p datum] [ev (ptr local)]) -> patread
    (let ([out patread])
      (set! (-> out ev) ev)
      (cond
        [(identifier? p)
         (let ([info (if (== (syntax-e p) '_) 0 (classify p))])
           (cond [(== info 0) (set! (-> out p) (new-pat (PVar '_ (fresh!) (loc p))))]
                 [(== (-> info what) 3)
                  (unless (== (-> info n) 0)
                    (bend-fail p "expected a ~a pattern with ~a field~a" `(,(syntax-e p) ,(make-integer (-> info n)) ,(plural (-> info n)))))
                  (set! (-> out p) (new-pat (PCtr (-> info name) nil (loc p))))]
                 [else
                  (let ([i (fresh!)])
                    (set! (-> out p) (new-pat (PVar (syntax-e p) i (loc p))))
                    (set! (-> out ev) (bind ev (syntax-e p) i 0)))]))]
        [(let ([l (syntax->list p)])
           (and (!= l 0) (pair? l) (identifier? (car l)) (== (keyword-of (car l)) kw-nat)))
         (let* ([l (syntax->list p)] [n i64 0] [pr patread] [q (ptr pat) 0])
           (unless (and (or (== (length l) 2) (== (length l) 3)) (integer? (syntax-e (cadr l))) (>= (integer-value (syntax-e (cadr l))) 0))
             (bend-fail p "expected (nat n) or (nat n p), n a natural number" nil))
           (set! n (integer-value (syntax-e (cadr l))))
           (if (== (length l) 3)
               (begin (set! pr (read-pattern (caddr l) ev)) (set! q (-> pr p)) (set! (-> out ev) (-> pr ev)))
               (set! q (new-pat (PCtr (constructor-named p 'Zero) nil (loc p)))))
           (let ([succ (constructor-named p 'Succ)])
             (while (> n 0)
               (set! q (new-pat (PCtr succ (list1 (cast datum q)) (loc p))))
               (-= n 1)))
           (set! (-> out p) q))]
        [(let ([l (syntax->list p)])
           (and (!= l 0) (== (length l) 2) (named-symbol? (car l) '+) (identifier? (cadr l))))
         (let* ([x (cadr (syntax->list p))] [i (fresh!)])
           (set! (-> out p) (new-pat (PVar (syntax-e x) i (loc x))))
           (set! (-> out ev) (bind ev (syntax-e x) i 1))
           (set! pluses (cons (cons x (make-integer i)) pluses)))]
        [else
         (let ([l (syntax->list p)])
           (unless (and (!= l 0) (pair? l) (identifier? (car l)))
             (bend-fail p "expected a pattern: a variable, _, C or (C pattern ...)" nil))
           (let ([info (classify (car l))] [qs nil] [rev ev])
             (unless (== (-> info what) 3) (bend-fail (car l) "~a is not a constructor" (list1 (syntax-e (car l)))))
             (unless (== (length (cdr l)) (-> info n))
               (bend-fail p "expected a ~a pattern with ~a field~a"
                          `(,(syntax-e (car l)) ,(make-integer (-> info n)) ,(plural (-> info n)))))
             (let ([q (cdr l)])
               (for/each ([x q])
                 (let ([pr (read-pattern x rev)])
                   (set! qs (cons (cast datum (-> pr p)) qs))
                   (set! rev (-> pr ev)))))
             (set! (-> out p) (new-pat (PCtr (-> info name) (reverse qs) (loc p))))
             (set! (-> out ev) rev)))])
      out))

  ;; ---- definitions ----
  ;; A fact's first byte: 1 a datatype, 2 a constructor, 3 a definition or law, 4 a fill of a law,
  ;; 5 a template, 6 an instance of a template.

  (define (fact [id datum] [b (ptr buffer)]) -> datum
    (let ([s (bytes->datum (buffer-bytes b))])
      (buffer-free! b)
      #`(#%fact #,id '#,(datum->syntax #'here (cons s (enc-names)) 0))))

  (define (def-specs [bs datum] [law i32]) -> datum
    (let ([out nil] [leading 1])
      (for/each ([b bs])
        (let ([s (bind-spec b)])
          (when (== s 0) (bend-fail b "expected a parameter: [q x : A]" nil))
          (when (== (-> s q) 3)
            (when law (bend-fail b "expected ~ only on a def's first parameters, which make it a template" nil))
            (unless leading (set! (-> s q) 0)))
          (unless (== (-> s q) 3) (set! leading 0))
          (set! out (cons (cast datum s) out))))
      (reverse out)))

  (define (leading-templates [specs datum]) -> u32
    (let ([m u32 0])
      (while (and (pair? specs) (== (-> (cast (ptr spec) (car specs)) q) 3))
        (+= m 1)
        (set! specs (cdr specs)))
      m))

  (define (erase-templates! [specs datum])
    (for/each ([d specs])
      (let ([sp (cast (ptr spec) d)]) (when (== (-> sp q) 3) (set! (-> sp q) 0)))))
  (define (read-value [xs datum] [body datum]) -> (ptr term)
    (let ([ev (ptr local) 0] [vars nil])
      (for/each ([x xs])
        (let ([i (fresh!)])
          (unless (identifier? x) (bend-fail x "expected a parameter name" nil))
          (set! vars (cons (cast datum (new-pat (PVar (syntax-e x) i (loc x)))) vars))
          (set! ev (bind ev (syntax-e x) i 0))))
      (set! vars (reverse vars))
      (let ([b (read-body body ev)])
        (in-module-arena!)
        (flatten-definition b vars))))

  (define (spec-names [specs datum]) -> datum
    (for/list ([d specs])
      (-> (cast (ptr spec) d) x)))

  (define (all-identifiers? [l datum]) -> i32
    (for/each ([x l])
      (unless (identifier? x) (return 0)))
    1)

  (define (fill-info [s datum] [f datum] [xs datum] [body datum]) -> datum
    (let ([info (classify f)])
      (unless (== (-> info what) 1) (bend-fail f "~a is not a law to fill" (list1 (syntax-e f))))
      (begin-check!)
      (where! s)
      (check-in-scratch!)
      (reset-fresh! 0)
      (set! template-read 0)
      (let* ([name (-> info name)] [v (resolved (read-value xs body))] [b (make-buffer)] [law (book-tld name)]
             [code (function! name (defd-n law) (defd-T law) (validate-fill! name (higher v)) 0)])
        (end-check!)
        (enc-start!)
        (buffer-add-byte! (& b) 4)
        (enc-term (& b) v)
        (enc-code (& b) name code)
        (fact f (& b)))))

  ;; ---- code ----

  (define gen datum 0)
  (define codes (ptr hash-table) 0)

  (define (generated [d datum]) -> datum (syntax-local-introduce (core-syntax gen d #'here)))

  (define (lift-code! [form datum]) (syntax-local-lift-definition (generated form)))

  (define (copy-code [d datum]) -> datum
    (cond [(pair? d) (cons (copy-code (car d)) (copy-code (cdr d)))]
          [(integer? d) (make-integer (integer-value d))]
          [(string? d) (string->datum (datum->string d))]
          [else d]))

  (define (function! [name datum] [n u32] [T (ptr term)] [e (ptr term)] [borrow i32]) -> datum
    (if (erased-type? T)
        0
        (let ([fsym (fresh-global (string->symbol (datum->string (short name))))])
          (hash-set! codes (cast u64 name) (cast u32 fsym))
          (let* ([code (def-function name fsym n T e borrow)] [helpers (lowered-forms!)])
            (in-module-arena!)
            (lift-code! (copy-code `(begin ,@helpers ,code)))
            (identifier-name (datum->syntax gen fsym 0))))))

  (define (enc-code [b (ptr buffer)] [name datum] [code datum])
    (cond [(== code 0) (buffer-add-byte! b 0)]
          [(== (borrow-mask name) 0) (buffer-add-byte! b 1) (enc-sym b code)]
          [else (buffer-add-byte! b 2) (enc-sym b code) (enc-u b (borrow-mask name))]))

  (define (dec-code! [name datum] [c (ptr cursor)])
    (let ([kind (dec-byte c)])
      (unless (== kind 0)
        (code! name (dec-sym c))
        (set-borrow-mask! name (if (== kind 2) (dec-u c) 0)))))

  (define (code-of [name datum]) -> datum
    (when (== (hash-ref codes (cast u64 name)) 0) (book-tld name))
    (let ([c (cast datum (hash-ref codes (cast u64 name)))])
      (when (== c 0)
        (bend-fail (where) "~a has no code: it is a law no module has filled, or a datatype" (list1 (short name))))
      c))

  (define (code! [name datum] [code datum]) (hash-set! codes (cast u64 name) (cast u32 (name-identifier code))))

  (define (constructor-name [c datum]) -> datum
    (cond [(identifier? c) c]
          [else (let ([l (syntax->list c)])
                  (unless (and (!= l 0) (pair? l) (identifier? (car l))) (bend-fail c "expected a constructor: [C field ...]" nil))
                  (car l))]))

  (define (constructor-fields [c datum]) -> datum
    (if (identifier? c)
        nil
        (let ([fs (cdr (syntax->list c))] [out nil])
          (for/each ([f fs])
            (let ([b (bind-spec f)])
              (when (or (== b 0) (== (-> b q) 3)) (bend-fail f "expected a field: [q x : A]" nil))
              (set! out (cons (cast datum b) out))))
          (reverse out))))

  (define (param-specs [ps datum]) -> datum
    (let ([out nil])
      (for/each ([p ps])
        (let ([b (bind-spec p)])
          (cond [(!= b 0) (set! out (cons (cast datum b) out))]
                [(identifier? p) (set! out (cons (cast datum (new-spec 0 p #'bend-Quant)) out))]
                [else (bend-fail p "expected a parameter: [q x : A], or x, a quantity" nil)])))
      (reverse out)))

  (define (leading-quantities [ps datum]) -> u32
    (let ([n u32 0])
      (while (and (pair? ps) (let ([A (-> (cast (ptr spec) (car ps)) A)]) (and (identifier? A) (== (keyword-of A) kw-Quant))))
        (+= n 1)
        (set! ps (cdr ps)))
      n))

  ;; ---- templates ----

  (struct tmpl [m u32] [n u32] [T (ptr term)] [v (ptr term)] [where datum])

  (define templates (ptr hash-table) 0)
  (define template-read i32 0)

  (define (new-tmpl [m u32] [n u32] [T (ptr term)] [v (ptr term)] [where datum]) -> (ptr tmpl)
    (let ([t (cast (ptr tmpl) (arena-alloc home (sizeof tmpl)))])
      (set! (-> t m) m)
      (set! (-> t n) n)
      (set! (-> t T) T)
      (set! (-> t v) v)
      (set! (-> t where) where)
      t))

  (define (template-of [k datum]) -> (ptr tmpl)
    (let ([known (cast (ptr tmpl) (hash-ref templates (cast u64 k)))] [nk (ptr kind) 0])
      (when (!= known 0) (return known))
      (set! nk (name-kind k))
      (when (or (== nk 0) (!= (-> nk what) 4)) (return 0))
      (let ([fs (name-facts k)] [t (ptr tmpl) 0] [saved (use-arena home)])
        (for/each ([f fs])
          (let ([c (cursor-of f)])
            (when (== (dec-byte (& c)) 5)
              (set! (-> c locs) 1)
              (let* ([m (dec-u (& c))] [n (dec-u (& c))] [T (dec-term (& c))] [v (dec-term (& c))])
                (set! t (new-tmpl m n T v 0))))))
        (use-arena saved)
        (hash-set! templates (cast u64 k) (cast u32 t))
        t)))

  (define (resolved [t (ptr term)]) -> (ptr term)
    (if template-read
        (let* ([saved (use-arena home)] [r (rewrite-calls t)])
          (use-arena saved)
          r)
        t))

  (define (template-call [k datum] [xs (ptr (ptr term))] [n u32] [t (ptr term)]) -> (ptr term)
    (let ([tp (template-of k)])
      (if (== tp 0)
          0
          (let ([m (-> tp m)])
            (when (< n m)
              (call-fail t "expected ~a applied to its ~a template argument~a first" `(,(short k) ,(make-integer m) ,(plural m))))
            (for ([j u32 0]) (< j m) (+= j 1)
              (unless (closed? (@ xs j) 0)
                (call-fail t "expected closed template arguments to ~a: this one uses a local variable, which only a run-time argument can"
                           (list1 (short k)))))
            (let ([name (instance k tp xs)])
              (took! m)
              (new-term (Ref name (term-s t))))))))

  (define (call-fail [t (ptr term)] [form string] [args datum])
    (raise-syntax-error 'bend (format-message form args)
                        (if (== (term-s t) 0)
                            (where)
                            (make-syntax (string->symbol (datum->string (term-show-string t))) no-scopes (term-s t) nil))))

  (define instances (ptr hash-table) 0)
  (define counts (ptr hash-table) 0)
  (define required (ptr hash-table) 0)

  (define (instance [k datum] [tp (ptr tmpl)] [xs (ptr (ptr term))]) -> datum
    (let ([b (make-buffer)] [key datum 0] [known datum 0])
      (buffer-add-string! (& b) (symbol->string k))
      (buffer-add-byte! (& b) 0)
      (for ([j u32 0]) (< j (-> tp m)) (+= j 1) (term-key! (& b) (@ xs j)))
      (set! key (string->symbol (buffer-string (& b))))
      (buffer-free! (& b))
      (set! known (cast datum (hash-ref instances (cast u64 key))))
      (when (and (== known 0) (== (-> tp where) 0)) (set! known (required-instance k key)))
      (if (!= known 0) known (make-instance k tp xs key))))

  (define (required-instance [k datum] [key datum]) -> datum
    (let ([t (cast (ptr hash-table) (hash-ref required (cast u64 k)))])
      (when (== t 0)
        (let ([saved (use-arena home)] [fs (name-facts k)])
          (set! t (make-table))
          (for/each ([f fs])
            (let ([c (cursor-of f)])
              (when (== (dec-byte (& c)) 6)
                (let* ([n (dec-u (& c))] [kk (string->symbol (cast string (slice (-> c p) n)))])
                  (+= (-> c p) n)
                  (hash-set! t (cast u64 kk) (cast u32 (dec-sym (& c))))))))
          (hash-set! required (cast u64 k) (cast u32 t))
          (use-arena saved)))
      (cast datum (hash-ref t (cast u64 key)))))

  (define (make-instance [k datum] [tp (ptr tmpl)] [xs (ptr (ptr term))] [key datum]) -> datum
    (let ([m (-> tp m)] [size u32 0])
      (for ([j u32 0]) (< j m) (+= j 1) (+= size (+ 1 (-> (datum->string (term-show-string (@ xs j))) length))))
      (when (> size 2048)
        (bend-fail (where) "expected the template arguments of ~a to stop growing: each call makes an instance" (list1 (short k))))
      (let* ([i (hash-ref counts (cast u64 k))]
             [sym (fresh-global (string->symbol (format-message "~a~a~a" `(,(short k) "~" ,(make-integer i)))))]
             [n (- (-> tp n) m)])
        (hash-set! counts (cast u64 k) (+ i 1))
        (lift-code! `(global ,sym i32 (i32.const 0)))
        (let ([name (identifier-name (datum->syntax gen sym 0))]
              [T (term-instantiate (-> tp T) xs m)]
              [v (term-instantiate (-> tp v) xs m)])
          (hash-set! instances (cast u64 key) (cast u32 name))
          (when (or (== T 0) (== v 0))
            (bend-fail (if (!= (-> tp where) 0) (-> tp where) (where))
                       "expected ~a's template parameters to be its first, and not matched" (list1 (short k))))
          (set! T (rewrite-calls T))
          (set! v (rewrite-calls v))
          (begin-check!)
          (when (!= (-> tp where) 0) (where! (-> tp where)))
          (reset-fresh! 0)
          (let* ([Th (higher T)] [code (function! name n Th (validate-def! name n Th (higher v)) 1)] [b (make-buffer)])
            (end-check!)
            (enc-start!)
            (buffer-add-byte! (& b) 3)
            (enc-u (& b) n)
            (enc-term (& b) T)
            (buffer-add-byte! (& b) 1)
            (enc-term (& b) v)
            (enc-code (& b) name code)
            (syntax-local-lift-definition (fact (generated sym) (& b)))
            (enc-start!)
            (set! b (make-buffer))
            (buffer-add-byte! (& b) 6)
            (enc-u (& b) (-> (symbol->string key) length))
            (buffer-add-string! (& b) (symbol->string key))
            (enc-sym (& b) name)
            (syntax-local-lift-definition (fact (syntax-local-introduce (name-identifier k)) (& b)))
            name)))))

  ;; ---- other modules' definitions ----

  (define (lookup [name datum]) -> (ptr tld)
    (let ([fs (name-facts name)] [info datum 0] [fill datum 0])
      (for/each ([f fs])
        (let ([kind (@ (datum->bytes (car f)) 0)])
          (cond [(and (== kind 4) (== fill 0)) (set! fill f)]
                [(and (== kind 4) (not (equal? f fill))) (bend-fail (where) "law ~a is filled twice" (list1 (short name)))]
                [(and (!= kind 4) (== info 0)) (set! info f)])))
      (if (== info 0) 0 (tld-of name info fill))))

  (define (cursor-of [v datum]) -> cursor
    (let ([c cursor] [s (datum->bytes (car v))] [names (cdr v)] [n (length (cdr v))])
      (set! (-> c p) (-> s items))
      (set! (-> c end) (+ (-> s items) (-> s length)))
      (set! (-> c locs) 0)
      (set! (-> c names) (cast (ptr datum) (arena-alloc (current-arena) (* (+ n 1) 4))))
      (for ([j u32 0]) (< j n) (+= j 1)
        (set! (@ (-> c names) j) (car names))
        (set! names (cdr names)))
      c))

  (define (decoded [c (ptr cursor)]) -> (ptr term) (higher (dec-term c)))

  (define (tld-of [name datum] [info datum] [fill datum]) -> (ptr tld)
    (let ([c (cursor-of info)])
      (case (dec-byte (& c))
        [(1)
         (let* ([n (dec-u (& c))] [g (dec-u (& c))] [T (decoded (& c))] [nc (dec-u (& c))]
                [cs (cast (ptr (ptr tld)) (arena-alloc (current-arena) (* nc 4)))])
           (for ([j u32 0]) (< j nc) (+= j 1)
             (let* ([k (dec-sym (& c))] [m (dec-u (& c))] [ct (decoded (& c))])
               (set! (@ cs j) (new-tld (CtrD k m ct)))))
           (new-tld (AdtD n g T nc cs)))]
        [(2) (let* ([k (dec-sym (& c))] [m (dec-u (& c))] [ct (decoded (& c))]) (new-tld (CtrD k m ct)))]
        [(3)
         (let* ([n (dec-u (& c))] [T (decoded (& c))] [has (dec-byte (& c))] [v (ptr term) 0])
           (cond [has (set! v (decoded (& c))) (dec-code! name (& c))]
                 [(!= fill 0)
                  (let ([fc (cursor-of fill)])
                    (dec-byte (& fc))
                    (set! v (decoded (& fc)))
                    (dec-code! name (& fc)))])
           (new-tld (DefD n T v)))]
        [else 0])))

  ;; ---- names and keywords ----

  (define (bend-name [s datum]) -> datum
    (start!)
    (let* ([l (syntax->list s)] [applied (and (!= l 0) (pair? l))] [info (classify (if applied (car l) s))])
      (unless (and applied (== (-> info what) 1))
        (bend-fail s "expected, in Substrate code, a definition called with its live arguments, (f x ...), or (print e)" nil))
      (unless (or (erased-def? (-> info name)) (substrate-callable? (-> info name)))
        (bend-fail s "expected, in Substrate code, a call of a definition whose parameters and result are each one term: ~a takes or gives a value of several words"
                   (list1 (short (-> info name)))))
      (generated (if (erased-def? (-> info name))
                     `(begin ,@(map (lambda ([a datum]) -> datum `(#%app %bend-rt:drop ,a)) (cdr l)) (i64.const 0))
                     (substrate-call (code-of (-> info name)) (borrow-mask (-> info name)) (cdr l))))))

  (define (substrate-call [f datum] [mask u32] [args datum]) -> datum
    (if (== mask 0)
        `(#%app ,f ,@args)
        (let ([binds nil] [ts nil] [drops nil] [j u32 0])
          (for/each ([arg args])
            (let ([t (string->symbol (format-message "bend-arg.~a" `(,(make-integer j))))])
              (set! binds (cons `[,t ,arg] binds))
              (set! ts (cons t ts))
              (when (and (< j 32) (!= (bit-and mask (<< (cast u32 1) j)) 0))
                (set! drops (cons `(#%app %bend-rt:drop ,t) drops))))
            (+= j 1))
          `(let* ,(reverse binds)
             (let ([bend-result (#%app ,f ,@(reverse ts))])
               ,@(reverse drops)
               bend-result)))))

  (define (keyword-alone [s datum]) -> datum
    (bend-fail s "expected this form of Bend's only in a Bend term" nil)
    s)
)

(define-macro (bend-module-begin s)
  #`(begin #,(core-syntax #'here `(begin (require %bend-rt "runtime.sub") (memory from %bend-rt) (table from %bend-rt)) #'here)
           #,@(cdr (syntax->list s))))

(define-macro (bend-type s)
  (start!)
  (let* ([l (syntax->list s)] [head (if (and (!= l 0) (>= (length l) 3)) (cadr l) 0)]
         [d (cond [(== head 0) 0] [(identifier? head) head]
                  [else (let ([h (syntax->list head)]) (if (and (!= h 0) (pair? h) (identifier? (car h))) (car h) 0))])])
    (when (== d 0) (bend-fail s "expected (type (D parameter ...) K [C field ...] ...)" nil))
    (let ([binds (list1 #`(define-syntax #,d bend-name))] [cs (cdddr l)])
      (for/each ([ctor cs])
        (let ([c (constructor-name ctor)])
          (set! binds (cons #`(define-syntax #,c bend-name) binds))))
      #`(begin #,@(reverse binds) (type-info #,s)))))

(define-macro (type-info stx)
  (let* ([s (cadr (syntax->list stx))] [l (syntax->list s)] [head (cadr l)]
         [d (if (identifier? head) head (car (syntax->list head)))]
         [ps (if (identifier? head) nil (param-specs (cdr (syntax->list head))))]
         [n (length ps)] [g (leading-quantities ps)] [name (identifier-name d)]
         [cs (cdddr l)] [nc (length cs)])
    (kind! name 2 n g)
    (let ([c cs])
      (for/each ([x c])
        (kind! (identifier-name (constructor-name x)) 3 (length (constructor-fields x)) 0)))
    (begin-check!)
    (where! s)
    (check-in-scratch!)
    (reset-fresh! 0)
    (set! template-read 0)
    (let* ([T0 (read-arrow ps (caddr l) 0 (loc s))]
           [tip (if (null? ps) d #`(#,d #,@(spec-names ps)))]
           [cts (term-array nc)] [c cs])
      (for ([j u32 0]) (< j nc) (+= j 1)
        (set! (@ cts j) (read-arrow (append ps (constructor-fields (car c))) tip 0 (loc s)))
        (set! c (cdr c)))
      (in-module-arena!)
      (let ([T (resolved (canonical T0))] [ctrs (cast (ptr (ptr tld)) (arena-alloc (current-arena) (* nc 4)))] [b (make-buffer)]
            [facts nil] [read cts])
        (set! cts (term-array nc))
        (set! c cs)
        (for ([j u32 0]) (< j nc) (+= j 1)
          (set! (@ cts j) (resolved (canonical (@ read j))))
          (set! (@ ctrs j) (new-tld (CtrD (identifier-name (constructor-name (car c))) (length (constructor-fields (car c)))
                                          (higher (@ cts j)))))
          (set! c (cdr c)))
        (validate-adt! name n g (higher T) ctrs nc)
        (end-check!)
        (enc-start!)
        (buffer-add-byte! (& b) 1)
        (enc-u (& b) n)
        (enc-u (& b) g)
        (enc-term (& b) T)
        (enc-u (& b) nc)
        (for ([j u32 0]) (< j nc) (+= j 1)
          (enc-sym (& b) (ctrd-k (@ ctrs j)))
          (enc-u (& b) (ctrd-n (@ ctrs j)))
          (enc-term (& b) (@ cts j)))
        (set! facts (list1 (fact d (& b))))
        (set! c cs)
        (for ([j u32 0]) (< j nc) (+= j 1)
          (let ([cb (make-buffer)])
            (enc-start!)
            (buffer-add-byte! (& cb) 2)
            (enc-sym (& cb) (ctrd-k (@ ctrs j)))
            (enc-u (& cb) (ctrd-n (@ ctrs j)))
            (enc-term (& cb) (@ cts j))
            (set! facts (cons (fact (constructor-name (car c)) (& cb)) facts)))
          (set! c (cdr c)))
        #`(begin #,@(reverse facts))))))

(define-macro (bend-def s)
  (start!)
  (let ([l (syntax->list s)])
    (unless (and (!= l 0) (>= (length l) 3) (syntax->list (cadr l)) (pair? (syntax->list (cadr l)))
                 (identifier? (car (syntax->list (cadr l)))))
      (bend-fail s "expected (def (f [q x : A] ...) R body), or (def (f x ...) body) to fill a law" nil))
    (let ([head (syntax->list (cadr l))])
      (cond [(and (== (length l) 3) (all-identifiers? (cdr head))) (fill-info s (car head) (cdr head) (caddr l))]
            [(== (length l) 4)
             (if (> (leading-templates (def-specs (cdr head) 0)) 0)
                 #`(begin (define-syntax #,(car head) bend-name) (template-info #,s))
                 #`(begin (define-syntax #,(car head) bend-name) (def-info #,s)))]
            [else (bend-fail s "expected (def (f [q x : A] ...) R body), or (def (f x ...) body) to fill a law" nil)
                  s]))))

(define-macro (def-info stx)
  (let* ([s (cadr (syntax->list stx))] [l (syntax->list s)] [head (syntax->list (cadr l))] [f (car head)]
         [name (identifier-name f)])
    (kind! name 1 0 0)
    (begin-check!)
    (where! s)
    (check-in-scratch!)
    (reset-fresh! 0)
    (set! template-read 0)
    (let* ([specs (def-specs (cdr head) 0)] [n (length specs)]
           [T0 (read-arrow specs (caddr l) 0 (loc s))]
           [v (resolved (read-value (spec-names specs) (cadddr l)))]
           [T (resolved (canonical T0))]
           [b (make-buffer)]
           [Th (higher T)]
           [code (function! name n Th (validate-def! name n Th (higher v)) 1)])
      (end-check!)
      (enc-start!)
      (buffer-add-byte! (& b) 3)
      (enc-u (& b) n)
      (enc-term (& b) T)
      (buffer-add-byte! (& b) 1)
      (enc-term (& b) v)
      (enc-code (& b) name code)
      (fact f (& b)))))

(define-macro (template-info stx)
  (let* ([s (cadr (syntax->list stx))] [l (syntax->list s)] [head (syntax->list (cadr l))] [f (car head)]
         [name (identifier-name f)] [specs (def-specs (cdr head) 0)] [m (leading-templates specs)] [n (length specs)])
    (kind! name 4 m 0)
    (erase-templates! specs)
    (begin-check!)
    (where! s)
    (check-in-scratch!)
    (reset-fresh! 0)
    (let* ([T0 (read-arrow specs (caddr l) 0 (loc s))]
           [v (read-value (spec-names specs) (cadddr l))]
           [T (canonical T0)]
           [b (make-buffer)])
      (end-check!)
      (hash-set! templates (cast u64 name) (cast u32 (new-tmpl m n T v s)))
      (enc-start!)
      (buffer-add-byte! (& b) 5)
      (enc-u (& b) m)
      (enc-u (& b) n)
      (enc-located (& b) T)
      (enc-located (& b) v)
      (fact f (& b)))))

(define-macro (bend-law s)
  (start!)
  (let ([l (syntax->list s)])
    (unless (and (!= l 0) (== (length l) 3) (syntax->list (cadr l)) (pair? (syntax->list (cadr l)))
                 (identifier? (car (syntax->list (cadr l)))))
      (bend-fail s "expected (law (f [q x : A] ...) R)" nil))
    #`(begin (define-syntax #,(car (syntax->list (cadr l))) bend-name) (law-info #,s))))

(define-macro (law-info stx)
  (let* ([s (cadr (syntax->list stx))] [l (syntax->list s)] [head (syntax->list (cadr l))] [f (car head)]
         [name (identifier-name f)])
    (kind! name 1 0 0)
    (begin-check!)
    (where! s)
    (check-in-scratch!)
    (reset-fresh! 0)
    (set! template-read 0)
    (let* ([specs (def-specs (cdr head) 1)] [n (length specs)]
           [T0 (read-arrow specs (caddr l) 0 (loc s))]
           [T (begin (in-module-arena!) (resolved (canonical T0)))]
           [b (make-buffer)])
      (validate-def! name n (higher T) 0)
      (end-check!)
      (enc-start!)
      (buffer-add-byte! (& b) 3)
      (enc-u (& b) n)
      (enc-term (& b) T)
      (buffer-add-byte! (& b) 0)
      (fact f (& b)))))

(define-macro (bend-print s)
  (start!)
  (let ([l (syntax->list s)])
    (unless (and (!= l 0) (== (length l) 2)) (bend-fail s "expected (print e)" nil))
    (begin-check!)
    (where! s)
    (check-in-scratch!)
    (reset-fresh! 0)
    (set! template-read 0)
    (let* ([r (infer-closed (higher (resolved (read-term (cadr l) 0))))]
           [code (print-code (cast (ptr term) (car r)) (cast (ptr term) (cadr r)))]
           [helpers (lowered-forms!)]
           [f (fresh-global 'print)])
      (in-module-arena!)
      (let ([out (copy-code code)] [hs (copy-code helpers)])
        (end-check!)
        (unless (null? hs) (lift-code! `(begin ,@hs)))
        (lift-code! `(func (,f) ,out))
        (generated `(#%app ,f))))))

(define-macro (bend-live-nodes s)
  (start!)
  (let ([l (syntax->list s)])
    (unless (and (!= l 0) (== (length l) 1)) (bend-fail s "expected (live-nodes)" nil))
    (generated `(#%app %bend-rt:live))))
