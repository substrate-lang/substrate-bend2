;; Bend: + binders in patterns, (+ x), and Nat patterns, (nat n) and (nat n p).
(language bend bend)
(require-unqualified tests std/test/test)

(type Pt Data [Pt0 [x : U32] [y : U32]])

(def (sq [p : Pt]) U32
  (match p [(Pt0 (+ x) y) (U32.add (U32.mul x x) y)]))

(def (pick [p : Pt] [b : Bool]) U32
  (match p [(Pt0 (+ x) y) (match b [True (U32.add x x)] [False (U32.add x y)])]))

(def (small [n : Nat]) U32 (match n [(nat 0) 10] [(nat 1) 11] [(nat 2 p) (U32.add 12 (U32.from_nat p))]))

(def (dup [xs : (List &2 Nat)]) (List &2 Nat)
  (match xs
    [Nil Nil]
    [(Con (+ h) t) (Con h (Con h (dup t)))]))

(define (main)
  (print (sq (Pt0 7 1)))
  (print (pick (Pt0 3 4) True))
  (print (pick (Pt0 3 4) False))
  (print (dup (Con (nat 1) (Con (nat 2) Nil))))
  (print (small (nat 0)))
  (print (small (nat 1)))
  (print (small (nat 7)))
  (printf "~a\n" (live-nodes)))

(test patterns (expect-output-file "patterns.out" (main)))
