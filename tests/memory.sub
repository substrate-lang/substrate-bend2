(language bend2)
(require-unqualified std/test/test)

(def (range [+ n : Nat]) (List Nat)
  (match n
    [Zero Nil]
    [(Succ p) (Con (Succ p) (range p))]))

(def (range2 [+ n : Nat]) (List &2 Nat)
  (match n
    [Zero Nil]
    [(Succ p) (Con (Succ p) (range2 p))]))

(def (sum [xs : (List Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (sum t (Nat.add h acc))]))

(def (sum2 [xs : (List &2 Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (sum2 t (Nat.add h acc))]))

(def (inc-all [xs : (List Nat)]) (List Nat)
  (match xs
    [Nil Nil]
    [(Con h t) (Con (Succ h) (inc-all t))]))

(def (first [xs : (List Nat)] [ys : (List Nat)]) (List Nat) xs)

(def (both [+ xs : (List &2 Nat)]) Nat (Nat.add (sum2 xs Zero) (sum2 xs Zero)))

(def (rows [+ n : Nat]) (List &2 (List &2 Nat))
  (match n
    [Zero Nil]
    [(Succ p) (Con (range2 (Succ p)) (rows p))]))

(def (sums [xss : (List &2 (List &2 Nat))] [acc : Nat]) Nat
  (match xss
    [Nil acc]
    [(Con h t) (sums t (sum2 h acc))]))

(def (both-rows [+ xss : (List &2 (List &2 Nat))]) Nat (Nat.add (sums xss Zero) (sums xss Zero)))

(def (holder [xs : (List Nat)]) (-> Nat Nat) (fn (m) (Nat.add m (sum xs Zero))))
(def (unused [xs : (List Nat)]) Nat (let ([f (holder xs)]) Zero))

(define (main)
  (print (sum (range (nat 10)) Zero))
  (print (inc-all (range (nat 3))))
  (print (first (range (nat 2)) (range (nat 5))))
  (print (both (range2 (nat 4))))
  (print (both-rows (rows (nat 3))))
  (print ((holder (range (nat 3))) (nat 1)))
  (print (unused (range (nat 4))))
  (printf "~a\n" (live-nodes)))

(test memory (expect-output-file "memory.out" (main)))
