;; A session in Bend: each definition is checked as it is entered; a failed one changes nothing.
(language bend "../../lib/bend/bend.sub")
(def (double [+ n : Nat]) Nat (Nat.add n n))
(print (double (nat 21)))
(def (sum [xs : (List Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (sum t (Nat.add h acc))]))
(print (sum (Con (nat 1) (Con (nat 2) (Con (nat 3) Nil))) Zero))
(def (twice [n : Nat]) Nat (Nat.add n n))
(print (double True))
(print (twice (nat 1)))
(print (double (nat 4)))
