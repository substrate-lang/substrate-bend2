;; Bend: proofs by induction and rewriting, add_comm and constructor discrimination.
(language bend "../../lib/bend/bend.sub")

(type N Data [Z] [S [p : N]])

(law (add [a : N] [b : N]) N)
(def (add a b)
  (match a
    [Z b]
    [(S p) (S (add p b))]))

(law (add_zero [a : N]) (== (add a Z) a N))
(def (add_zero a)
  (match a
    [Z refl]
    [(S p) (rewrite (add_zero p) (== (S (add p Z)) (S _) N) refl)]))

(law (add_succ [a : N] [- b : N]) (== (S (add a b)) (add a (S b)) N))
(def (add_succ a b)
  (match a
    [Z refl]
    [(S p) (rewrite (add_succ p b) (== (S (S (add p b))) (S _) N) refl)]))

(law (add_comm [a : N] [+ b : N]) (== (add a b) (add b a) N))
(def (add_comm a b)
  (match a
    [Z (rewrite (add_zero b) (== _ (add b Z) N) refl)]
    [(S p) (rewrite (add_succ b p) (== (S (add p b)) _ N)
             (rewrite (add_comm p b) (== (S (add p b)) (S _) N) refl))]))

(law (result) (== (add (S (S Z)) (S Z)) (add (S Z) (S (S Z))) N))
(def (result) (add_comm (S (S Z)) (S Z)))

(type Uni Data [U])
(type Emp Data)
(type Bit Data [T2] [F2])

(law (TF [b : Bit]) Type)
(def (TF b)
  (match b
    [T2 Uni]
    [F2 Emp]))

(law (t_ne_f [e : (== T2 F2 Bit)]) Emp)
(def (t_ne_f e) (rewrite e (TF _) U))

(law (ne) (-> (== T2 F2 Bit) Emp))
(def (ne) (fn (e) (t_ne_f e)))

(define (main) (print (result)))
