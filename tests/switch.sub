(language bend bend)
(require-unqualified tests std/test/test)

(type Sh Data [Dot] [One [a : U32]] [Two [a : U32] [b : U32]] [More [s : Sh]] [Emp])

(def (size [s : Sh]) U32
  (match s
    [Dot 0]
    [(One a) a]
    [(Two a b) (U32.add a b)]
    [(More t) (U32.add 1 (size t))]
    [Emp 100]))

(def (kind [s : Sh]) U32
  (match s
    [(Two a b) 2]
    [(More t) 3]
    [Emp 4]
    [_ 9]))

(type Op Data [Inc [n : U32]] [Dec [n : U32]] [Set [n : U32] [m : U32]] [Nop] [Halt [n : U32]])

(def (step [o : Op] [+ x : U32]) U32
  (match o
    [(Inc n) (U32.add x n)]
    [(Dec n) (U32.sub x n)]
    [(Set n m) (U32.mul n m)]
    [Nop x]
    [(Halt n) n]))

(def (run [ops : (List Op)] [+ x : U32]) U32
  (match ops [Nil x] [(Con o t) (run t (step o x))]))

(def (name [n : Nat]) U32
  (match n [(nat 0) 10] [(nat 1) 11] [(nat 2) 12] [(nat 3) 13] [(nat 4 p) (U32.add 100 (U32.from_nat p))]))

(def (near [n : Nat]) Nat
  (match n
    [Zero (nat 0)]
    [(Succ p) (match p [Zero p] [(Succ q) (match q [Zero (nat 7)] [(Succ r) r])])]))

(type Day Data [Mon] [Tue] [Wed] [Thu] [Fri])

(def (hours [d : Day]) U32 (match d [Mon 8] [Tue 9] [Wed 7] [Thu 9] [Fri 5]))

(def (key [n : Nat]) U32 (match n [(nat 0) 5] [(nat 1) 6] [(nat 2) 7] [(nat 3 p) 8]))

(define (main)
  (print (size Dot))
  (print (size (One 5)))
  (print (size (Two 3 4)))
  (print (size (More (More (Two 2 3)))))
  (print (size Emp))
  (print (kind (One 1)))
  (print (kind (More Dot)))
  (print (kind Dot))
  (print (run (Con (Inc 5) (Con (Dec 2) (Con Nop (Con (Set 6 7) (Con (Inc 1) (Con (Halt 99) Nil)))))) 10))
  (print (run (Con (Set 2 3) (Con (Inc 4) Nil)) 0))
  (print (name (nat 0)))
  (print (name (nat 3)))
  (print (name (nat 4)))
  (print (name (nat 9)))
  (print (near (nat 0)))
  (print (near (nat 1)))
  (print (near (nat 2)))
  (print (near (nat 6)))
  (print (hours Mon))
  (print (hours Wed))
  (print (hours Fri))
  (print (key (nat 0)))
  (print (key (nat 2)))
  (print (key (nat 3)))
  (print (key (nat 40)))
  (printf "~a\n" (live-nodes)))

(test switch (expect-output-file "switch.out" (main)))
