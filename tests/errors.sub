(require-unqualified std/test/build)

(test err-computed (expect-compile-error "fail/err-computed.sub" "expected a parameter or field scrutinee (a match cannot scrutinize a computed value: give it its own def)"))
(test err-descent (expect-compile-error "fail/err-descent.sub" "expected a decreasing self-call"))
(test err-fill (expect-compile-error "fail/err-fill.sub" "expected a law to fill (Pair is not one, or is filled already)"))
(test err-flat (expect-compile-error "fail/err-flat.sub" "origin takes or gives a value of several words"))
(test err-hole (expect-compile-error "fail/err-hole.sub" "err-hole.sub:3:44: error: bend: expected (== (nat 1) (nat 2) Nat)"))
(test err-law (expect-compile-error "fail/err-law.sub" "expected a filled definition"))
(test err-law-twice (expect-compile-error "fail/err-law-twice.sub" "err-law-twice.sub:7:1: error: bend: law half is filled twice"))
(test err-pattern (expect-compile-error "fail/err-pattern.sub" "expected a Succ pattern with 1 field"))
(test err-print (expect-compile-error "fail/err-print.sub" "a value of type (-> Nat Nat) cannot be written"))
(test err-proof (expect-compile-error "fail/err-proof.sub" "expected (Nat.add a Zero)"))
(test err-quantity (expect-compile-error "fail/err-quantity.sub" "observed b (consumed more than once)"))
(test err-scrutinee (expect-compile-error "fail/err-scrutinee.sub" "expected a live scrutinee (a - scrutinee matches only in a dead region)"))
(test err-template-arguments (expect-compile-error "fail/err-template-arguments.sub" "expected app applied to its 1 template argument first"))
(test err-template-dup (expect-compile-error "fail/err-template-dup.sub" "observed x (consumed more than once)"))
(test err-template-grow (expect-compile-error "fail/err-template-grow.sub" "expected the template arguments of grow to stop growing"))
(test err-template-imported (expect-compile-error "fail/err-template-imported.sub" "fixtures/app.sub:5:50: error: bend: expected Bool"))
(test err-template-law (expect-compile-error "fail/err-template-law.sub" "expected ~ only on a def's first parameters"))
(test err-template-open (expect-compile-error "fail/err-template-open.sub" "expected closed template arguments to app"))
(test err-template-type (expect-compile-error "fail/err-template-type.sub" "expected Bool"))
(test err-type (expect-compile-error "fail/err-type.sub" "observed Bool"))
