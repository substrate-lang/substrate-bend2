(language bend2)
(require-unqualified std/test/test)
(require-unqualified "fixtures/map.sub")
(require-unqualified "fixtures/incs.sub")

(def (same [xs : (List Nat)]) (== (inc-all xs) (map Nat Nat inc xs) (List Nat)) refl)

(define (main)
  (print (map Nat Nat inc (Con (nat 1) Nil)))
  (print (same (Con (nat 1) Nil))))

(test share (expect-output "(Con (nat 2) Nil)\nrefl" (main)))
