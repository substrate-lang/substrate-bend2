;; Bend: flat values.
(language bend2)
(require-unqualified std/test/test)

(type Pt Data [Pt0 [x : U32] [y : U32]])
(type Sh Data [Dot] [Seg [a : U32] [b : U32]] [Box3 [w : U32] [h : U32] [d : Nat]])

(def (add [p : Pt] [q : Pt]) Pt
  (match p q [((Pt0 a b) (Pt0 c d)) (Pt0 (U32.add a c) (U32.add b d))]))

(def (size [s : Sh]) U32
  (match s
    [Dot 0]
    [(Seg a b) (U32.sub b a)]
    [(Box3 w h d) (U32.mul w (U32.add h (U32.from_nat d)))]))

(def (grow [s : Sh]) Sh
  (match s
    [Dot (Seg 0 1)]
    [(Seg a b) (Box3 a b (nat 2))]
    [(Box3 w h d) Dot]))

(def (sum [ps : (List Pt)] [acc : Pt]) Pt
  (match ps
    [Nil acc]
    [(Con p t) (sum t (add acc p))]))

(def (sizes [ss : (List Sh)]) U32
  (match ss
    [Nil 0]
    [(Con s t) (U32.add (size s) (sizes t))]))

(def (shift [p : Pt]) (-> Pt Pt) (fn (q) (add p q)))
(def (id [- A : Type] [x : A]) A x)

(define (main)
  (print (add (Pt0 1 2) (Pt0 10 20)))
  (print (sum (Con (Pt0 1 1) (Con (Pt0 2 3) (Con (Pt0 4 5) Nil))) (Pt0 0 0)))
  (print (sizes (Con Dot (Con (Seg 3 10) (Con (Box3 2 3 (nat 4)) Nil)))))
  (print (grow (grow Dot)))
  (print ((shift (Pt0 5 6)) (Pt0 1 1)))
  (print (size (id Sh (Seg 1 9))))
  (print (the (List Pt) (Con (Pt0 7 8) Nil)))
  (printf "~a\n" (live-nodes)))

(test flat (expect-output-file "flat.out" (main)))
