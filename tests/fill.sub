;; Bend: laws another module declares, filled here.
(language bend2)
(require-unqualified std/test/test)
(require-unqualified "fixtures/laws.sub")

(def (half n)
  (match n
    [Zero Zero]
    [(Succ Zero) Zero]
    [(Succ (Succ p)) (Succ (half p))]))

(def (half_double n)
  (match n
    [Zero refl]
    [(Succ p) (rewrite (half_double p) (== (Succ (half (Nat.double p))) (Succ _) Nat) refl)]))

(def (half_4) (== (half (nat 4)) (nat 2) Nat) refl)

(define (main) (print (half (nat 9))))

(test fill (expect-output "(nat 4)" (main)))
