(type Bl@ Data [Bn@] [Bc@ [head : Nat] [tail : Bl@]])
(law (bcat@ [xs : Bl@] [ys : Bl@]) Bl@)
(def (bcat@ xs ys) (match xs [Bn@ ys] [(Bc@ h t) (Bc@ h (bcat@ t ys))]))
(law (blen@ [xs : Bl@]) Nat)
(def (blen@ xs) (match xs [Bn@ Z] [(Bc@ h t) (S (blen@ t))]))
(law (bcat@_nil [xs : Bl@]) (== (bcat@ xs Bn@) xs Bl@))
(def (bcat@_nil xs) (match xs [Bn@ refl] [(Bc@ h t) (rewrite (bcat@_nil t) (== (Bc@ h (bcat@ t Bn@)) (Bc@ h _) Bl@) refl)]))
(law (bcat@_assoc [xs : Bl@] [- ys : Bl@] [- zs : Bl@]) (== (bcat@ (bcat@ xs ys) zs) (bcat@ xs (bcat@ ys zs)) Bl@))
(def (bcat@_assoc xs ys zs)
  (match xs [Bn@ refl] [(Bc@ h t) (rewrite (bcat@_assoc t ys zs) (== (Bc@ h (bcat@ (bcat@ t ys) zs)) (Bc@ h _) Bl@) refl)]))
(law (blen@_cat [xs : Bl@] [- ys : Bl@]) (== (add (blen@ xs) (blen@ ys)) (blen@ (bcat@ xs ys)) Nat))
(def (blen@_cat xs ys)
  (match xs [Bn@ refl] [(Bc@ h t) (rewrite (blen@_cat t ys) (== (S (add (blen@ t) (blen@ ys))) (S _) Nat) refl)]))
