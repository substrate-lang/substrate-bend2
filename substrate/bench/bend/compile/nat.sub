(type An@ Data [Az@] [As@ [pred : An@]])
(law (aadd@ [a : An@] [b : An@]) An@)
(def (aadd@ a b) (match a [Az@ b] [(As@ a) (As@ (aadd@ a b))]))
(law (An@.cpy [n : An@]) (Pair (Cpy An@ n) (Cpy An@ n)))
(law (An@.cpy.succ [- p : An@] [c : (Pair (Cpy An@ p) (Cpy An@ p))]) (Pair (Cpy An@ (As@ p)) (Cpy An@ (As@ p))))
(def (An@.cpy.succ p c)
  (match c [(Tuple (Tuple a ea) (Tuple b eb))
            (Tuple (Tuple (As@ a) (cong An@ An@ (fn (x) (As@ x)) p a ea)) (Tuple (As@ b) (cong An@ An@ (fn (x) (As@ x)) p b eb)))]))
(def (An@.cpy n) (match n [Az@ (Tuple (Tuple Az@ refl) (Tuple Az@ refl))] [(As@ p) (An@.cpy.succ p (An@.cpy p))]))
(law (aadd@_zero [a : An@]) (== (aadd@ a Az@) a An@))
(def (aadd@_zero a) (match a [Az@ refl] [(As@ a) (rewrite (aadd@_zero a) (== (As@ (aadd@ a Az@)) (As@ _) An@) refl)]))
(law (aadd@_succ [a : An@] [- b : An@]) (== (As@ (aadd@ a b)) (aadd@ a (As@ b)) An@))
(def (aadd@_succ a b) (match a [Az@ refl] [(As@ a) (rewrite (aadd@_succ a b) (== (As@ (As@ (aadd@ a b))) (As@ _) An@) refl)]))
(law (aadd@_comm [a : An@] [+ b : An@]) (== (aadd@ a b) (aadd@ b a) An@))
(def (aadd@_comm a b)
  (match a
    [Az@ (rewrite (aadd@_zero b) (== _ (aadd@ b Az@) An@) refl)]
    [(As@ a) (rewrite (aadd@_succ b a) (== (As@ (aadd@ a b)) _ An@) (rewrite (aadd@_comm a b) (== (As@ (aadd@ a b)) (As@ _) An@) refl))]))
