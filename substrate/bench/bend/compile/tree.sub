;; Lifecycle: benchmark. A block of the proofs module (proofs.sh): a tree of its own, Ct@, its mirror and size, copying, and mir_mir and size_mir on them; @ is the block's number.
(type Ct@ Data [Cl@ [val : Nat]] [Cn@ [lft : Ct@] [rgt : Ct@]])
(law (cmir@ [t : Ct@]) Ct@)
(def (cmir@ t) (match t [(Cl@ v) (Cl@ v)] [(Cn@ l r) (Cn@ (cmir@ r) (cmir@ l))]))
(law (csize@ [t : Ct@]) Nat)
(def (csize@ t) (match t [(Cl@ v) (S Z)] [(Cn@ l r) (add (csize@ l) (csize@ r))]))
(law (Ct@.cpy [t : Ct@]) (Pair (Cpy Ct@ t) (Cpy Ct@ t)))
(law (Ct@.cpy.leaf [- v : Nat] [c : (Pair (Cpy Nat v) (Cpy Nat v))]) (Pair (Cpy Ct@ (Cl@ v)) (Cpy Ct@ (Cl@ v))))
(def (Ct@.cpy.leaf v c)
  (match c [(Tuple (Tuple v1 e1) (Tuple v2 e2))
            (Tuple (Tuple (Cl@ v1) (cong Nat Ct@ (fn (x) (Cl@ x)) v v1 e1)) (Tuple (Cl@ v2) (cong Nat Ct@ (fn (x) (Cl@ x)) v v2 e2)))]))
(law (Ct@.cpy.node [- l : Ct@] [- r : Ct@] [cl : (Pair (Cpy Ct@ l) (Cpy Ct@ l))] [cr : (Pair (Cpy Ct@ r) (Cpy Ct@ r))])
     (Pair (Cpy Ct@ (Cn@ l r)) (Cpy Ct@ (Cn@ l r))))
(def (Ct@.cpy.node l r cl cr)
  (match cl cr
    [((Tuple (Tuple l1 el1) (Tuple l2 el2)) (Tuple (Tuple r1 er1) (Tuple r2 er2)))
     (Tuple (Tuple (Cn@ l1 r1) (Equal.cong2 Ct@ Ct@ Ct@ (fn (x y) (Cn@ x y)) l l1 r r1 el1 er1))
            (Tuple (Cn@ l2 r2) (Equal.cong2 Ct@ Ct@ Ct@ (fn (x y) (Cn@ x y)) l l2 r r2 el2 er2)))]))
(def (Ct@.cpy t) (match t [(Cl@ v) (Ct@.cpy.leaf v (Nat.cpy v))] [(Cn@ l r) (Ct@.cpy.node l r (Ct@.cpy l) (Ct@.cpy r))]))
(law (cmir@_mir [t : Ct@]) (== (cmir@ (cmir@ t)) t Ct@))
(def (cmir@_mir t)
  (match t
    [(Cl@ v) refl]
    [(Cn@ l r) (rewrite (cmir@_mir l) (== (Cn@ (cmir@ (cmir@ l)) (cmir@ (cmir@ r))) (Cn@ _ r) Ct@)
                   (rewrite (cmir@_mir r) (== (Cn@ (cmir@ (cmir@ l)) (cmir@ (cmir@ r))) (Cn@ (cmir@ (cmir@ l)) _) Ct@) refl))]))
(law (csize@_mir [+ t : Ct@]) (== (csize@ (cmir@ t)) (csize@ t) Nat))
(def (csize@_mir t)
  (match t
    [(Cl@ v) refl]
    [(Cn@ l r)
     (rewrite (csize@_mir r) (== (add (csize@ (cmir@ r)) (csize@ (cmir@ l))) (add (csize@ l) _) Nat)
       (rewrite (csize@_mir l) (== (add (csize@ (cmir@ r)) (csize@ (cmir@ l))) (add _ (csize@ (cmir@ r))) Nat)
         (rewrite (add_comm (csize@ (cmir@ l)) (csize@ (cmir@ r))) (== _ (add (csize@ (cmir@ l)) (csize@ (cmir@ r))) Nat) refl)))]))
