;; Bend as the new compiler builds it (lib/languages/bend): a call of a small
;; definition is its code, inlined (lower.sub). A match of it, in the
;; middle of an expression, frees the nodes it takes and does not reuse,
;; and gives its value on; a switch's cases give theirs from a block, a
;; flat value's several values.
(require-unqualified bend "../../lib/languages/bend/bend.sub")
(require-unqualified base "../../lib/languages/bend/base.sub")
(require print "../../lib/print.sub" write-int newline)

(type T Data [L [v : U32]] [N [l : T] [r : T]])

(def (sum [t : T]) U32 (match t [(L v) v] [(N l r) (U32.add (sum l) (sum r))]))

;; A node taken, as an argument: freed, its field dropped; reused.
(def (left [t : T]) T (match t [(L v) (L v)] [(N l r) l]))
(def (swap [t : T]) T (match t [(L v) (L v)] [(N l r) (N r l)]))

;; Many ways, a switch, as an argument.
(type Op Data [A] [B] [C] [D [n : U32]] [E [t : T]])

(def (val [o : Op]) U32 (match o [A 1] [B 2] [C 3] [(D n) n] [(E t) (sum t)]))

;; A flat value's switch, as an argument: several values.
(type Pr Data [P [a : U32] [b : U32]] [Q [a : U32]] [R] [S [a : U32] [b : U32] [c : U32]])

(def (norm [p : Pr]) Pr (match p [(P a b) (P b a)] [(Q (+ a)) (P a a)] [R (P 0 0)] [(S a b c) (P a (U32.add b c))]))
(def (fst [p : Pr]) U32 (match p [(P a b) a] [(Q a) a] [R 0] [(S a b c) a]))

(func (main)
  (print (sum (left (N (N (L 1) (L 2)) (L 3)))))
  (print (sum (swap (N (L 4) (L 5)))))
  (print (U32.add (val A) (val (E (N (L 10) (L 20))))))
  (print (U32.add (val (D 7)) (val C)))
  (print (fst (norm (S 1 2 3))))
  (print (fst (norm (P 8 9))))
  (print (norm R))
  (write-int (live-cells))
  (newline))
