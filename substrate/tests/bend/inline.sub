;; Bend: a call of a small definition is inlined; its match frees or reuses what it takes.
(require-unqualified bend "../../lib/bend/bend.sub")
(require-unqualified base "../../lib/bend/base.sub")
(require print "../../compiler/print.sub" write-int newline)

(type T Data [L [v : U32]] [N [l : T] [r : T]])

(def (sum [t : T]) U32 (match t [(L v) v] [(N l r) (U32.add (sum l) (sum r))]))

(def (left [t : T]) T (match t [(L v) (L v)] [(N l r) l]))
(def (swap [t : T]) T (match t [(L v) (L v)] [(N l r) (N r l)]))

(type Op Data [A] [B] [C] [D [n : U32]] [E [t : T]])

(def (val [o : Op]) U32 (match o [A 1] [B 2] [C 3] [(D n) n] [(E t) (sum t)]))

(type Pr Data [P [a : U32] [b : U32]] [Q [a : U32]] [R] [S [a : U32] [b : U32] [c : U32]])

(def (norm [p : Pr]) Pr (match p [(P a b) (P b a)] [(Q (+ a)) (P a a)] [R (P 0 0)] [(S a b c) (P a (U32.add b c))]))
(def (fst [p : Pr]) U32 (match p [(P a b) a] [(Q a) a] [R 0] [(S a b c) a]))

(func (main)
  (print (sum (left (N (N (L 1) (L 2)) (L 3)))))
  (print (sum (swap (N (L 4) (L 5)))))
  (print (U32.add (val A) (val (E (N (L 10) (L 20))))))
  (print (U32.add (val (D 7)) (val C)))
  (print (fst (norm (S 1 2 3))))
  (print (fst (norm (P 8 9))))
  (print (norm R))
  (write-int (live-nodes))
  (newline))
