;; Bend (examples/bend): templates, ported from Bend's tests/comptime. A
;; def's first parameters may be ~, a template's: an application gives
;; its template arguments first, closed terms, and is of the template's
;; instance at them, a definition of the rest. Each print is one of
;; Bend's tests, whose result it gives.
(require-unqualified bend "../../examples/bend/bend.sub")
(require-unqualified base "../../examples/bend/base.sub")

(def (inc [n : Nat]) Nat (Succ n))

(def (sum [xs : (List Nat)]) Nat
  (match xs
    [Nil Zero]
    [(Con h t) (Nat.add h (sum t))]))

(def (flat [xs : (List (List Nat))]) Nat
  (match xs
    [Nil Zero]
    [(Con h t) (Nat.add (sum h) (flat t))]))

;; Bend's List.map: its function, and so its types, are template
;; arguments, so its instance calls the function directly; its self-call
;; is of the instance.
(def (map [~ A : Type] [~ B : Type] [~ f : (-> A B)] [xs : (List A)]) (List B)
  (match xs
    [Nil Nil]
    [(Con h t) (Con (f h) (map A B f t))]))

(def (one-two-three) (List Nat) (Con (nat 1) (Con (nat 2) (Con (nat 3) Nil))))

;; name: 9.
(def (name) Nat (sum (map Nat Nat inc (one-two-three))))

;; two_instances: two arguments, two instances, shared by later calls: 34.
(def (two-instances) Nat
  (Nat.add (sum (map Nat Nat inc (one-two-three)))
           (Nat.add (sum (map Nat Nat (fn (x) (Nat.mul x (nat 2))) (one-two-three)))
                    (Nat.add (sum (map Nat Nat inc (Con (nat 4) Nil)))
                             (sum (map Nat Nat (fn (x) (Nat.mul x (nat 2))) (Con (nat 4) Nil)))))))

;; nested: a template that applies a template at its own ~f, a lambda
;; argument that applies a template, and one applied in a template at a
;; closed argument: 28.
(def (map2 [~ f : (-> Nat Nat)] [xs : (List Nat)]) (List Nat)
  (map Nat Nat f (map Nat Nat f xs)))

(def (incs [~ f : (-> Nat Nat)] [xs : (List Nat)]) (List Nat)
  (map Nat Nat inc (map Nat Nat f xs)))

(def (app [~ f : (-> Nat Nat)] [x : Nat]) Nat (f x))

(def (nested) Nat
  (Nat.add (sum (map2 (fn (x) (Nat.mul x (nat 2))) (Con (nat 1) (Con (nat 2) Nil))))
           (Nat.add (app (fn (y) (app (fn (z) (Nat.add z (nat 1))) y)) (nat 3))
                    (sum (incs inc (one-two-three))))))

;; lambda: a lambda argument is put where it is applied, so a constructor
;; body checks there; an application given fewer arguments is closed too: 38.
(def (lambda) Nat
  (Nat.add (sum (map Nat Nat (fn (x) (Nat.mul x (nat 2))) (one-two-three)))
           (Nat.add (flat (map Nat (List Nat) (fn (x) (Con x Nil)) (Con (nat 1) (Con (nat 2) Nil))))
                    (sum (map Nat Nat (Nat.add (nat 10)) (Con (nat 1) (Con (nat 2) Nil)))))))

;; fold: a function of two arguments, the second applied by the checker: 16.
(def (fold [~ f : (-> Nat Nat Nat)] [xs : (List Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (fold f t (f h acc))]))

(def (folds) Nat
  (Nat.add (fold (fn (a b) (Nat.add a b)) (one-two-three) Zero)
           (fold Nat.add (Con (nat 2) (Con (nat 3) (Con (nat 4) Nil))) (nat 1))))

;; closed_shadow: a lambda's binder, and a let in it, named as the caller's
;; locals are, are the lambda's own: 8.
(def (g [x : Nat]) Nat (app (fn (x) (Nat.add x (nat 1))) x))
(def (h [k : Nat]) Nat (app (fn (y) (let ([k (the Nat (nat 1))]) (Nat.add y k))) k))

;; shadow_arg: a lambda's binder named as the template's binder is its
;; own: 12.
(def (shadow-arg) Nat (sum (map Nat Nat (fn (h) (Nat.mul h (nat 2))) (one-two-three))))

;; dup_many: a lambda that uses its parameter twice, at a + parameter: 6.
(def (app+ [~ f : (-> Nat Nat)] [+ x : Nat]) Nat (f x))
(def (dup-many) Nat (app+ (fn (y) (Nat.add y y)) (nat 3)))

;; plain_tilde: a ~ after a def's first parameter is an erased one: 3.
(def (keep [x : Nat] [~ k : Nat]) Nat x)

(func (main)
  (print (name))
  (print (two-instances))
  (print (nested))
  (print (lambda))
  (print (folds))
  (print (Nat.add (g (nat 3)) (h (nat 3))))
  (print (shadow-arg))
  (print (dup-many))
  (print (keep (nat 3) (nat 5))))
