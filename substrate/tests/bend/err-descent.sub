;; Bend: a self-call that does not descend: its first argument passed unchanged, its second grows.
(require-unqualified bend "../../lib/bend/bend.sub")
(require-unqualified base "../../lib/bend/base.sub")

(def (add [a : Nat] [b : Nat]) Nat
  (match a
    [Zero b]
    [(Succ p) (Succ (add b p))]))

(func (main))
