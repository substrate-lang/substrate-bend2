;; Bend as the new compiler builds it (lib/bend): a Nat literal is one
;; term however large, (nat n) kept as a number by the checker
;; (core.sub's Nat), unfolded a level where a match takes it, and
;; compared along a chain of Succs by a loop: so (nat 100000) checks,
;; compares and prints, where a term of as many Succs exhausted the
;; stack. A chain the normalizer makes, Nat.add's Succs, compares with a
;; literal the same way.
(require-unqualified bend "../../lib/bend/bend.sub")
(require-unqualified base "../../lib/bend/base.sub")

(def (big) Nat (nat 100000))

;; Checked by comparing Nats: a literal with a literal, a sum's chain of
;; Succs with a literal, and a match's result with a literal.
(def (same) (== (big) (nat 100000) Nat) refl)
(def (sum) (== (Nat.add (nat 7000) (nat 3000)) (nat 10000) Nat) refl)

(def (half [n : Nat]) Nat
  (match n
    [Zero Zero]
    [(Succ Zero) Zero]
    [(Succ (Succ p)) (Succ (half p))]))

(def (halved) (== (half (nat 10)) (nat 5) Nat) refl)
(def (zero) (== (half (nat 1)) (nat 0) Nat) refl)

(def (len [+ n : Nat] [acc : U32]) U32
  (match n
    [Zero acc]
    [(Succ p) (len p (U32.add acc 1))]))

(func (main)
  (print (big))
  (print (same))
  (print (sum))
  (print (half (nat 11)))
  (print (len (nat 1000) 0))
  (print (Nat.add (nat 700) (nat 300))))
