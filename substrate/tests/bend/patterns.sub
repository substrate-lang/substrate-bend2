;; Bend as the new compiler builds it (lib/bend): a + binder in a
;; pattern, (+ x), as Bend's +x: the field bound, then x a + let of it,
;; around the row's body, or each row of a match the body is; and a
;; Nat pattern, (nat n) or (nat n p), as Bend's n and n+p.
(require-unqualified bend "../../lib/bend/bend.sub")
(require-unqualified base "../../lib/bend/base.sub")
(require print "../../compiler/print.sub" write-int newline)

(type Pt Data [Pt0 [x : U32] [y : U32]])

(def (sq [p : Pt]) U32
  (match p [(Pt0 (+ x) y) (U32.add (U32.mul x x) y)]))

;; The + field's row body a match: the let in each of its rows.
(def (pick [p : Pt] [b : Bool]) U32
  (match p [(Pt0 (+ x) y) (match b [True (U32.add x x)] [False (U32.add x y)])]))

;; Nat patterns, (nat n) and (nat n p).
(def (small [n : Nat]) U32 (match n [(nat 0) 10] [(nat 1) 11] [(nat 2 p) (U32.add 12 (U32.from_nat p))]))

(def (dup [xs : (List &2 Nat)]) (List &2 Nat)
  (match xs
    [Nil Nil]
    [(Con (+ h) t) (Con h (Con h (dup t)))]))

(func (main)
  (print (sq (Pt0 7 1)))
  (print (pick (Pt0 3 4) True))
  (print (pick (Pt0 3 4) False))
  (print (dup (Con (nat 1) (Con (nat 2) Nil))))
  (print (small (nat 0)))
  (print (small (nat 1)))
  (print (small (nat 7)))
  (write-int (live-nodes))
  (newline))
