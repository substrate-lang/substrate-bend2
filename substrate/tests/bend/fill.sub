;; Bend as the new compiler builds it (lib/languages/bend): laws another module declares, filled here, which
;; then compute, as the checker sees and as the program runs.
(require-unqualified bend "../../lib/languages/bend/bend.sub")
(require-unqualified base "../../lib/languages/bend/base.sub")
(require-unqualified laws "fixtures/laws.sub")

(def (half n)
  (match n
    [Zero Zero]
    [(Succ Zero) Zero]
    [(Succ (Succ p)) (Succ (half p))]))

(def (half_double n)
  (match n
    [Zero refl]
    [(Succ p) (rewrite (half_double p) (== (Succ (half (Nat.double p))) (Succ _) Nat) refl)]))

(def (half_4) (== (half (nat 4)) (nat 2) Nat) refl)

(func (main) (print (half (nat 9))))
