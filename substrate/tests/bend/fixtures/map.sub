;; A template, map, and inc, for other modules to apply.
(require-unqualified bend "../../../lib/bend/bend.sub")
(provide map inc)

(def (inc [n : Nat]) Nat (Succ n))

(def (map [~ A : Type] [~ B : Type] [~ f : (-> A B)] [xs : (List A)]) (List B)
  (match xs
    [Nil Nil]
    [(Con h t) (Con (f h) (map A B f t))]))
