;; Bend: templates, from Bend's tests/comptime.
(require-unqualified bend "../../lib/languages/bend/bend.sub")
(require-unqualified base "../../lib/languages/bend/base.sub")

(def (inc [n : Nat]) Nat (Succ n))
(def (app [~ f : (-> Nat Nat)] [x : Nat]) Nat (f x))

;; dup_lone: a lambda that uses its parameter twice, at a parameter of one use.
(def (g) Nat (app (fn (y) (Nat.add y y)) (nat 3)))
