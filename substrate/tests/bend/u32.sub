;; Bend: U32 as 32 Bools to the checker and a machine word to the code.
(require-unqualified bend "../../lib/bend/bend.sub")
(require-unqualified base "../../lib/bend/base.sub")
(require print "../../compiler/print.sub" write-int newline)

(def (two-three) (== (U32.add 2 3) 5 U32) refl)
(def (wraps) (== (U32.sub 0 1) 4294967295 U32) refl)
(def (less) (== (U32.is_lt 3 7) True Bool) refl)
(def (by-zero) (== (U32.div 7 0) 0 U32) refl)

(def (sum-to [+ n : Nat] [acc : U32]) U32
  (match n
    [Zero acc]
    [(Succ p) (sum-to p (U32.add acc (U32.from_nat (Succ p))))]))

(def (mix [+ a : U32] [+ b : U32]) U32
  (U32.xor (U32.mul a 2654435761) (U32.add (U32.shln b (nat 3)) (U32.shrn a (nat 40)))))

(def (ones) U32 (u32 (Word.not (nat 32) (Word.zero (nat 32)))))
(def (low-bit [a : U32]) Bool (match a [(u32 w) (match w [(WCon b t) b])]))

(type Item Data [Gap] [Item0 [n : U32]])
(def (bump [i : Item]) Item (match i [Gap Gap] [(Item0 n) (Item0 (U32.inc n))]))

(func (main)
  (print (U32.add 2 3))
  (print (U32.sub 0 1))
  (print (U32.mul 65536 65536))
  (print (U32.div 100 7))
  (print (U32.mod 100 7))
  (print (U32.div 7 0))
  (print (U32.mod 7 0))
  (print (U32.shln 1 (nat 31)))
  (print (U32.shln 1 (nat 32)))
  (print (U32.shrn 4294967295 (nat 28)))
  (print (U32.is_lt 3 7))
  (print (U32.cmp 9 2))
  (print (U32.to_nat 5))
  (print (U32.from_nat (nat 7)))
  (print (sum-to (nat 100) 0))
  (print (mix 12345 678))
  (print (ones))
  (print (low-bit 6))
  (print (low-bit 7))
  (print (bump (Item0 41)))
  (print (bump Gap))
  (print (two-three))
  (write-int (live-nodes))
  (newline))
