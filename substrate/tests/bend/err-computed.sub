;; Bend: a match of a computed value.
(require-unqualified bend "../../lib/bend/bend.sub")

(def (isz [n : Nat]) Bool (match n [Zero True] [(Succ p) False]))
(def (orb [a : Bool] [b : Bool]) Bool (match a [True True] [False b]))
(law (or_true [n : Nat]) (== (orb (isz n) True) True Bool))
(def (or_true n)
  (match (isz n)
    [True refl]
    [False refl]))

(func (main))
