;; Bend: a template argument that uses a local.
(require-unqualified bend "../../lib/bend/bend.sub")
(require-unqualified base "../../lib/bend/base.sub")

(def (inc [n : Nat]) Nat (Succ n))
(def (app [~ f : (-> Nat Nat)] [x : Nat]) Nat (f x))

(def (g [x : Nat]) Nat (app (fn (y) (Nat.add y x)) (nat 1)))
