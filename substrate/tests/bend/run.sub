;; Bend as the new compiler builds it (lib/languages/bend): a program's code (lower.sub). Each element of
;; result's list exercises a way code runs: closures that capture, a
;; definition given fewer arguments than it takes and more, a lambda-match
;; as a value, erased arguments and binders, a let, a rewrite, and a loop.
;; Kernel code calls definitions directly, with their live arguments.
(require-unqualified bend "../../lib/languages/bend/bend.sub")
(require-unqualified base "../../lib/languages/bend/base.sub")

;; A closure that captures n; one that captures a, which the one it makes
;; captures too.
(def (adder [n : Nat]) (-> Nat Nat) (fn (m) (Nat.add n m)))
(def (add3 [a : Nat]) (-> Nat Nat Nat) (fn (b) (fn (c) (Nat.add a (Nat.add b c)))))

(def (apply [- A : Type] [f : (-> A A)] [x : A]) A (f x))

;; compose, given two functions, is a function.
(def (compose [- A : Type] [- B : Type] [- C : Type] [g : (-> B C)] [f : (-> A B)]) (-> A C)
  (fn (x) (g (f x))))

(def (flip) (-> Bool Bool) (split True False (split False True (absurd))))

(def (poly) (-> [- A : Type] A A) (fn (A x) x))

(def (sum [xs : (List Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (sum t (Nat.add h acc))]))

(def (range [+ n : Nat]) (List Nat)
  (match n
    [Zero Nil]
    [(Succ p) (Con (Succ p) (range p))]))

(def (ones [b : Bool]) Nat
  (match b
    [True (nat 1)]
    [False Zero]))

;; A rewrite runs as its body.
(def (cast [- n : Nat] [e : (== n (nat 2) Nat)] [x : Nat]) Nat (rewrite e Nat x))

(def (nat-two) Nat (nat 2))

(def (result) (List Nat)
  (Con (apply Nat (adder (nat 3)) (nat 1))
  (Con (add3 (nat 1) (nat 2) (nat 3))
  (Con ((compose Nat Nat Nat (Nat.add (nat 1)) Nat.double) (nat 3))
  (Con (ones ((flip) False))
  (Con (cast (nat 2) refl (nat 8))
  (Con ((poly) Nat (nat 7))
  (Con (let ([x (the Nat (nat 2))] [- T Type] [y (Nat.add (nat 1) (nat 1))]) (Nat.mul x y))
  (Con (sum (range (nat 100)) Zero)
       Nil)))))))))

(func (main) (print (result)) (drop (Nat.add (Nat.double (nat-two)) (nat-two))))
