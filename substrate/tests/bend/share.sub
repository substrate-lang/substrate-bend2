;; Bend: a template instance a required module made is this one's too, so proofs agree.
(require-unqualified bend "../../lib/bend/bend.sub")
(require-unqualified base "../../lib/bend/base.sub")
(require-unqualified m "fixtures/map.sub")
(require-unqualified i "fixtures/incs.sub")

(def (same [xs : (List Nat)]) (== (inc-all xs) (map Nat Nat inc xs) (List Nat)) refl)

(func (main)
  (print (map Nat Nat inc (Con (nat 1) Nil)))
  (print (same (Con (nat 1) Nil))))
