;; A session test in Bend (lib/bend). Each definition is type-checked when
;; it is entered; one that fails the check changes nothing in the session.
;; Bend does not print an expression's value itself, so `print` is used.
(require-unqualified bend "../../lib/bend/bend.sub")
(require-unqualified base "../../lib/bend/base.sub")
(def (double [+ n : Nat]) Nat (Nat.add n n))
(print (double (nat 21)))
(def (sum [xs : (List Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (sum t (Nat.add h acc))]))
(print (sum (Con (nat 1) (Con (nat 2) (Con (nat 3) Nil))) Zero))
;; Rejected: n is used twice, but it is not marked + (which allows that).
(def (twice [n : Nat]) Nat (Nat.add n n))
(print (double True))
(print (twice (nat 1)))
(print (double (nat 4)))
