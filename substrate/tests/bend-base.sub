;; Bend (examples/bend): a module that uses another's definitions, the
;; slice of Bend's Base in examples/bend/base.sub, which it finds by
;; their names' facts (spec 6.6, 6.7), under any name.
(require-unqualified bend "../examples/bend/bend.sub")
(require-unqualified base "../examples/bend/base.sub")
(require b "../examples/bend/base.sub" Nat.add)

;; Computation in types: each side normalizes to the same Nat.
(def (two) Nat (nat 2))
(def (four) Nat (b:Nat.add (nat 2) (two)))
(def (four_is_4) (== (four) (nat 4) Nat) refl)
(def (six_is_6) (== (Nat.mul (nat 2) (nat 3)) (Nat.double (nat 3)) Nat) refl)

;; Pair, a law Base fills.
(def (swap [- A : Type] [- B : Type] [p : (Pair A B)]) (Pair B A)
  (match p [(Tuple a x) (Tuple x a)]))

;; List and Maybe, their leading quantity left out: (List A) is (List &1
;; A).
(def (len [- A : Type] [xs : (List A)]) Nat
  (match xs
    [Nil Zero]
    [(Con _ t) (Succ (len A t))]))

(def (head [- A : Type] [xs : (List A)]) (Maybe A)
  (match xs
    [Nil None]
    [(Con h _) (Some h)]))

;; A match on two scrutinees.
(def (both [x : Bool] [y : Bool]) Bool
  (match x y
    [(True True) True]
    [(_ _) False]))

(def (not_not [b : Bool]) (== (Bool.not (Bool.not b)) b Bool)
  (match b
    [False refl]
    [True refl]))

;; Base's equality kit, as Bend's tests/proof/equality_kit.bend uses it.
(law (flip [- x : Nat] [e : (== x (nat 3) Nat)]) (== (nat 3) x Nat))
(def (flip x e) (Equal.sym Nat x (nat 3) e))

(law (chain [- x : Nat] [- y : Nat] [e1 : (== x y Nat)] [e2 : (== y (nat 5) Nat)]) (== x (nat 5) Nat))
(def (chain x y e1 e2) (Equal.trans Nat x y (nat 5) e1 e2))

(law (succ_eq [- x : Nat] [- y : Nat] [e : (== x y Nat)]) (== (Succ x) (Succ y) Nat))
(def (succ_eq x y e) (Equal.cong Nat Nat (fn (n) (Succ n)) x y e))

(def (main) (Pair Nat (Pair (Maybe Nat) Bool))
  (Tuple (len Nat (Con (four) (Con (two) Nil)))
         (Tuple (head Nat (Con (Nat.mul (two) (nat 3)) Nil)) (both True (Bool.not False)))))
