;; The runtime of Bend's compiled code: nodes, reference counting and printing.
;; A term: bit 63 shared; bits 56-62 tag (0 packed, 1 Nat, 2 node, 3 closure); bits 0-31 address;
;; bits 32-55 a node's constructor (low 12) and field count (high 12), or a closure's table index.

(require substrate "../../compiler/substrate.sub")
(require nodes "../nodes.sub" node-alloc node-free node-pop node-push nodes-live)

(provide node free-node node-pop node-push static share take drop node-of live word-u32 u32-word write-u32 write-byte newline write-nat)

(define (shared? [t u64]) -> i32 (!= (>> t 63) 0))
(define (tag-of [t u64]) -> u32 (cast u32 (bit-and (>> t 56) 127)))
(define (loc-of [t u64]) -> (ptr u64) (cast (ptr u64) (cast u32 t)))

(define (trivial? [t u64]) -> i32
  (and (not (shared? t)) (or (< (tag-of t) 2) (== (cast u32 t) 0))))

(define (node [n u32]) #:inline -> i32 (cast i32 (node-alloc (* n 8))))

(define (free-node [a i32] [n u32]) #:inline
  (unless (== a 0) (node-free (cast (ptr void) a) (* n 8))))

(define (static [n u32]) -> i32 (cast i32 (malloc n)))

(define (live) -> i32 (cast i32 (nodes-live)))

;; A shared term points at a one-word redirect: its node's address above, its owner count below.
(define (share [t u64] [k u32]) -> u64
  (cond [(shared? t)
         (let ([r (loc-of t)])
           (set! (@ r 0) (+ (@ r 0) k))
           t)]
        [(trivial? t) t]
        [else
         (let ([r (node 1)])
           (set! (@ (cast (ptr u64) r) 0) (bit-or (<< (cast u64 (cast u32 t)) 32) (cast u64 (+ k 1))))
           (bit-or (bit-and t 9223372032559808512) (bit-or 9223372036854775808 (cast u64 (cast u32 r)))))]))

(define (take [t u64] [n u32]) -> i32
  (let* ([r (loc-of t)] [w (@ r 0)] [nd (cast (ptr u64) (cast u32 (>> w 32)))])
    (if (== (cast u32 w) 1)
        (begin (free-node (cast i32 r) 1) (cast i32 nd))
        (let ([c (cast (ptr u64) (node n))])
          (for ([j u32 0]) (< j n) (+= j 1)
            (set! (@ nd j) (share (@ nd j) 1))
            (set! (@ c j) (@ nd j)))
          (set! (@ r 0) (- w 1))
          (cast i32 c)))))

(define (node-of [t u64]) -> i32
  (if (shared? t) (cast i32 (>> (@ (loc-of t) 0) 32)) (cast i32 t)))

(define stack (ptr u64) 0)
(define room u32 0)

(define (drop [t u64])
  (let ([top u32 0])
    (push! top t)
    (+= top 1)
    (while (> top 0)
      (-= top 1)
      (let ([u (@ stack top)] [go 1])
        (when (shared? u)
          (let* ([r (loc-of u)] [w (@ r 0)])
            (if (> (cast u32 w) 1)
                (begin (set! (@ r 0) (- w 1)) (set! go 0))
                (begin
                  (set! u (bit-or (bit-and u 9223372032559808512) (>> w 32)))
                  (free-node (cast i32 r) 1)))))
        (when (and go (not (trivial? u)))
          (let ([nd (loc-of u)] [n u32 0] [from u32 0])
            (if (== (tag-of u) 2)
                (set! n (cast u32 (bit-and (>> u 44) 4095)))
                (begin (set! n (+ (cast u32 (@ nd 0)) 1)) (set! from 1)))
            (for ([j u32 from]) (< j n) (+= j 1)
              (unless (trivial? (@ nd j))
                (push! top (@ nd j))
                (+= top 1)))
            (free-node (cast i32 nd) n)))))))

(define (push! [top u32] [t u64])
  (when (>= top room)
    (set! room (if (== room 0) 64 (* room 2)))
    (set! stack (cast (ptr u64) (realloc stack (* room 8)))))
  (set! (@ stack top) t))

;; The checker's U32 is a Word: 32 WCon nodes, low bit first, each a packed Bool (True is 1 << 32),
;; ending in WNil (0). At run time a U32 is a machine word.

(define (word-u32 [w u64]) -> u64
  (let ([v u64 0] [bit u32 0] [x w])
    (while (and (not (trivial? x)) (< bit 32))
      (let ([nd (cast (ptr u64) (node-of x))])
        (unless (== (@ nd 0) 0) (set! v (bit-or v (<< (cast u64 1) bit))))
        (set! x (@ nd 1))
        (+= bit 1)))
    (drop w)
    v))

(define (u32-word [t u64]) -> u64
  (let ([w u64 0])
    (for ([i i32 31]) (>= i 0) (-= i 1)
      (let ([nd (cast (ptr u64) (node 2))])
        (set! (@ nd 0) (if (!= (bit-and (>> t i) 1) 0) 4294967296 0))
        (set! (@ nd 1) w)
        (set! w (bit-or 144150372447944704 (cast u64 (cast u32 nd))))))
    w))

(define (write-u32 [t u64]) (substrate:write-u64 (cast i64 (bit-and t 4294967295))))

(define (write-byte [b i32]) (substrate:write-byte b))
(define (newline) (substrate:newline))

;; As Bend prints a Nat: Zero, or (nat n).
(define (write-nat [t u64])
  (let ([n (bit-and t 281474976710655)])
    (if (== n 0)
        (begin (write-byte 90) (write-byte 101) (write-byte 114) (write-byte 111))
        (begin
          (write-byte 40) (write-byte 110) (write-byte 97) (write-byte 116) (write-byte 32)
          (substrate:write-u64 (cast i64 n))
          (write-byte 41)))))
