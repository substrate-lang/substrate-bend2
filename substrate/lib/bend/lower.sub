;; Lifecycle: experimental. The lowering of Bend as the new compiler builds
;; it (lib/bend): examples/bend/lower.sub, which follows Bend's compiler
;; (bend2/comp.ts), but to code in linear memory, whose values are owned
;; as Bend2's runtime owns them: a module's checked definitions to kernel
;; code, as data, which bend.sub turns into syntax. A symbol in the code
;; means what it means in the module it is lifted into, where bend.sub has
;; required runtime.sub as %bend-rt; syntax in it, the function of a
;; definition, is kept as it is.
;;
;; A value is held as its type's layout says (below): a word, a term that
;; owns nothing, such as a U32, a Nat or a constructor of no live field;
;; flat, a few words, the fields of a small datatype of words; or uniform,
;; a term that may own a node in memory (runtime.sub), a constructor's of
;; its live fields, or a closure's, the table index of its code, a function
;; of the closure and its argument, and the values it captures. What is
;; erased, a binder, argument or field of quantity -, a type, a proof's
;; rewrite, is left out, and where a value is needed for it, it is 0. A
;; definition is a function of its live parameters, each as many locals as
;; its layout has words, of as many results as its result's layout has; an
;; application of it to that many live arguments is a direct call, and
;; any other, as of a variable, applies closures, one argument at a time: a
;; definition given fewer is made a closure first, by eta-expansion. A
;; closure's function is lifted, and its captured values found as its body
;; is made (lookup).
;;
;; A checked term is annotated with each node's type, which says what is
;; erased, and how each value is held. Its binders are opened with probes,
;; variables of ids of their own, which the function being made maps to
;; its locals. The code is made in two steps: a term to a function's code,
;; below (ir), whose variables are its locals; then that to kernel code,
;; each variable that may own a node owned, used once on each path through
;; the code: a use but the last of a variable on the way shares its value,
;; one never used is dropped, and a match on a node frees it, or gives it
;; to a constructor of as many fields on the way, which reuses it. The code
;; is made in the current arena, from a checked term in core.sub's scratch
;; arena.

(require-unqualified base "../../compiler/base/base.sub")
(require-unqualified kd "../../compiler/kernel.sub")
(require-unqualified forms "../../compiler/base/forms.sub")
(require-unqualified core "core.sub")
(memory from base)
(table from base)

(provide lower-start! def-function kernel-callable? borrow-mask set-borrow-mask! print-code lowered-forms! fresh-global
         erased-type? erased-def?)

;; ---- the module ----
;;
;; A module's code is made a piece at a time: each definition's function,
;; and each print's code. What a piece needs at module level, its
;; closures' functions, the functions that box and unbox its flat values,
;; and those that write values, is lifted, taken with lowered-forms!.

;; A definition's function, an identifier, by the definition's name.
(define code-of (fn (datum) -> datum) 0)
(define forms datum 0)
(define used (ptr arena-table) 0)
(define printers (ptr arena-table) 0)
(define probes i32 0)
(define locals u32 0)

;; The arena the module's tables, and what they keep, are in: the current
;; one as it starts.
(define home (ptr arena) 0)

(define (lower-start! [code (fn (datum) -> datum)] [prefix datum])
  (set! home (current-arena))
  (set! code-of code)
  (set! forms nil)
  (set! used (make-table))
  (set! tried (make-table))
  ;; The names the module's memory and table are exported by.
  (table-set! used (cast u64 (sym memory)) 1)
  (table-set! used (cast u64 (sym table)) 1)
  (set! printers (make-table))
  (set! erasures (make-table))
  (set! nats (make-table))
  (set! plain (make-table))
  (set! word-families (make-table))
  (set! words (make-table))
  (set! layouts (make-table))
  (set! shapes (make-table))
  (set! signatures (make-table))
  (set! inlines (make-table))
  (set! borrows (make-table))
  (set! in-progress nil)
  (set! uniform-lay (new-lay uniform-kind 1 0 0))
  (set! word-lay (new-lay word-kind 1 0 0))
  (prims-start! prefix))

;; The forms the pieces made so far need, not taken before, in order.
(define (lowered-forms!) -> datum
  (let ([fs (reverse forms)])
    (set! forms nil)
    fs))

(define (lift! [form datum]) (set! forms (cons form forms)))

(define (list1 [x datum]) -> datum (cons x nil))

;; A module-level name that no other this module's code made has, from
;; base: base, then base.1, and so on, each base's count kept.
(define tried (ptr arena-table) 0)

(define (fresh-global [base datum]) -> datum
  (let ([n i64 (cast i64 (table-ref tried (cast u64 base)))] [s datum 0])
    (while 1
      (set! s (if (== n 0) base (string->symbol (fmt "~a.~a" base (make-integer n)))))
      (+= n 1)
      (when (== (table-ref used (cast u64 s)) 0)
        (table-set! used (cast u64 s) 1)
        (table-set! tried (cast u64 base) (cast u32 n))
        (return s)))
    s))

;; A local of the module's code no other has, from k.
(define (local! [k datum]) -> datum
  (+= locals 1)
  (string->symbol (fmt "~a.~a" k (make-integer locals))))

(define (int [n i64]) -> datum (make-integer n))
(define (i32-const [n i64]) -> datum `(i32.const ,(int n)))
(define (i64-const [n i64]) -> datum `(i64.const ,(int n)))

;; An error in the code of the definition being lowered, or about what,
;; written at loc.
(define (lower-error [message datum] [what datum] [loc (ptr srcloc)]) -> datum
  (raise-syntax-error (sym bend) message (if (!= loc 0) (datum->syntax 0 what (make-syntax what no-scopes loc nil)) (where)))
  0)

(define (c-text [p (ptr u8)]) -> datum (bytes->string p (strlen p)))

;; ---- the term word ----

;; A Nat's 0, and the tags of a node and of a closure, in place.
(define nat-zero i64 72057594037927936)
(define node-tag i64 144115188075855872)
(define closure-tag i64 216172782113783808)

;; The term of constructor number v with no live field, and the high bits
;; of one with n, whose node's address is its low bits.
(define (packed [v u32]) -> i64 (<< (cast i64 v) 32))
(define (node-bits [v u32] [n u32]) -> i64 (bit-or node-tag (bit-or (<< (cast i64 n) 44) (<< (cast i64 v) 32))))

;; Kernel code for term t's constructor number, and its code's table index.
(define (variant-code [t datum]) -> datum `(i32.and (i32.wrap_i64 (i64.shr_u ,t (i64.const 32))) (i32.const 4095)))
(define (index-code [t datum]) -> datum `(i32.and (i32.wrap_i64 (i64.shr_u ,t (i64.const 32))) (i32.const 16777215)))

;; ---- erased definitions ----
;;
;; A definition whose type ends, past all its domains, in an equality, a
;; type or a quantity has values the code leaves out, as it does a proof
;; and a type: its value is always 0, and it terminates, as the checker
;; sees, with no effect. So it needs no function, and an application of
;; it to its live arguments is 0, with no call; one given fewer is a
;; closure, as another's is, whose code is 0.

;; Each definition's name -> 1 if it is erased, 2 if not.
(define erasures (ptr arena-table) 0)

(define (erased-type? [T (ptr term)]) -> i32
  (let ([tip (-> (tele-unbind T) tip)]) (or (Eql? tip) (Typ? tip) (Qnt? tip))))

(define (erased-def? [k datum]) -> i32
  (let ([known (table-ref erasures (cast u64 k))])
    (if (!= known 0)
        (== known 1)
        (let* ([d (book-tld k)] [e (and (DefD? d) (erased-type? (defd-T d)))])
          (table-set! erasures (cast u64 k) (if e 1 2))
          e))))

;; ---- U32 ----
;;
;; Base's U32 (base.sub), a word of 32 Bools to the checker, is a machine
;; word here, packed in its term, as Bend2 compiles it: a number's U32 is
;; its value; its operations, Base's definitions on words, are the word's
;; instructions, at each application of one to its live arguments and in
;; its function; a Bool or Cmp they give is packed, its constructor's
;; number. A U32 of a computed word, or a U32's word, as only Base's own
;; definitions on words make, is converted at run time (runtime.sub).

;; Base's names this needs, and each operation's number, by its
;; definition's name, plus 1.
(define base datum 0)
(define u32-family datum 0)
(define u32-name datum 0)
(define true-name datum 0)
(define prims (ptr arena-table) 0)

;; The operation that makes a U32 of its word.
(define op-word u32 100)

(define (base-name [s (ptr u8)]) -> datum (string->symbol (fmt "~a~a" base (c-text s))))

(define (prims-start! [prefix datum])
  (set! base prefix)
  (set! u32-family (base-name "U32"))
  (set! u32-name (base-name "u32"))
  (set! true-name (base-name "True"))
  (set! prims (make-table))
  (let ([names (array-of (ptr u8) "U32.inc" "U32.add" "U32.sub" "U32.mul" "U32.not" "U32.and" "U32.or" "U32.xor"
                         "U32.shl" "U32.shr" "U32.shln" "U32.shrn" "U32.cmp" "U32.is_eq" "U32.is_ne" "U32.is_lt"
                         "U32.is_le" "U32.is_gt" "U32.is_ge" "U32.is_zero" "U32.to_nat" "U32.from_nat" "U32.div"
                         "U32.mod")])
    (for ([j u32 0]) (< j 24) (+= j 1)
      (table-set! prims (cast u64 (base-name (@ names j))) (+ j 1)))))

;; The operation definition k is, or -1.
(define (prim-of [k datum]) -> i32 (- (cast i32 (table-ref prims (cast u64 k))) 1))

;; The value of t, a word's term, if it is a number's, its bits each True
;; or False; else -1.
(define (word-value [t (ptr term)]) -> i64
  (let ([v i64 0] [bit i64 1] [x (term-strip t)])
    (while (and (Ctr? x) (== (ctr-n x) 2))
      (let ([b (term-strip (@ (ctr-x x) 0))])
        (unless (and (Ctr? b) (== (ctr-n b) 0)) (return -1))
        (when (== (ctr-k b) true-name) (set! v (bit-or v bit)))
        (set! bit (<< bit 1))
        (set! x (term-strip (@ (ctr-x x) 1)))))
    (if (and (Ctr? x) (== (ctr-n x) 0)) v -1)))

;; A U32's low 32 bits, an i32, from term code e, which is an extension of
;; one, or a number, again; and the term of an i32.
(define (w32 [e datum]) -> datum
  (cond [(and (pair? e) (== (car e) (sym i64.extend_i32_u))) (cadr e)]
        [(and (pair? e) (== (car e) (sym i64.const)))
         (let ([v (bit-and (integer-value (cadr e)) 4294967295)]) (i32-const (if (>= v 2147483648) (- v 4294967296) v)))]
        [else `(i32.wrap_i64 ,e)]))
(define (ext64 [e datum]) -> datum `(i64.extend_i32_u ,e))

;; The term of a Bool or Cmp, constructor number e, an i32.
(define (packed-code [e datum]) -> datum `(i64.shl (i64.extend_i32_u ,e) (i64.const 32)))

;; A shift of U32 a by Nat n, by instruction i, x and y its locals; by a
;; number, the shift by it, or 0.
(define (shift-code [i datum] [a datum] [n datum] [x datum] [y datum]) -> datum
  (if (and (pair? n) (== (car n) (sym i64.const)))
      (let ([k (- (integer-value (cadr n)) nat-zero)])
        (if (>= k 32)
            `(i64.const 0)
            (ext64 `(,i ,(w32 a) ,(i32-const k)))))
      `(let ([,x ,a] [,y (i64.and ,n (i64.const 281474976710655))])
         (if (i64.ge_u ,y (i64.const 32))
             (i64.const 0)
             ,(ext64 `(,i ,(w32 x) ,(w32 y)))))))

;; Operation op's kernel code, on the code of its arguments, es: a U32's
;; low 32 bits are its value; a shift by a Nat of 32 or more gives 0, a
;; division by 0 gives 0 and a remainder by 0 the number, as Base's do.
(define (prim-code [op u32] [es datum]) -> datum
  (let ([a (if (pair? es) (car es) 0)] [b (if (and (pair? es) (pair? (cdr es))) (cadr es) 0)]
        [x (local! (sym x))] [y (local! (sym y))])
    (case op
      [(0) (ext64 `(i32.add ,(w32 a) (i32.const 1)))]
      [(1) (ext64 `(i32.add ,(w32 a) ,(w32 b)))]
      [(2) (ext64 `(i32.sub ,(w32 a) ,(w32 b)))]
      [(3) (ext64 `(i32.mul ,(w32 a) ,(w32 b)))]
      [(4) (ext64 `(i32.xor ,(w32 a) (i32.const -1)))]
      [(5) (ext64 `(i32.and ,(w32 a) ,(w32 b)))]
      [(6) (ext64 `(i32.or ,(w32 a) ,(w32 b)))]
      [(7) (ext64 `(i32.xor ,(w32 a) ,(w32 b)))]
      [(8) (ext64 `(i32.shl ,(w32 a) (i32.const 1)))]
      [(9) (ext64 `(i32.shr_u ,(w32 a) (i32.const 1)))]
      [(10) (shift-code `i32.shl a b x y)]
      [(11) (shift-code `i32.shr_u a b x y)]
      [(12)
       `(let ([,x ,(w32 a)] [,y ,(w32 b)])
          ,(packed-code `(if (i32.lt_u ,x ,y) (i32.const 0) (if (i32.eq ,x ,y) (i32.const 1) (i32.const 2)))))]
      [(13) (packed-code `(i32.eq ,(w32 a) ,(w32 b)))]
      [(14) (packed-code `(i32.ne ,(w32 a) ,(w32 b)))]
      [(15) (packed-code `(i32.lt_u ,(w32 a) ,(w32 b)))]
      [(16) (packed-code `(i32.le_u ,(w32 a) ,(w32 b)))]
      [(17) (packed-code `(i32.gt_u ,(w32 a) ,(w32 b)))]
      [(18) (packed-code `(i32.ge_u ,(w32 a) ,(w32 b)))]
      [(19) (packed-code `(i32.eqz ,(w32 a)))]
      [(20) `(i64.or ,a ,(i64-const nat-zero))]
      [(21) `(i64.and ,a (i64.const 4294967295))]
      [(22) `(let ([,x ,(w32 a)] [,y ,(w32 b)]) ,(ext64 `(if (i32.eqz ,y) (i32.const 0) (i32.div_u ,x ,y))))]
      [(23) `(let ([,x ,(w32 a)] [,y ,(w32 b)]) ,(ext64 `(if (i32.eqz ,y) ,x (i32.rem_u ,x ,y))))]
      [else `(#%app %bend-rt:word-u32 ,a)])))

;; ---- nodes ----
;;
;; A node of n words comes from runtime.sub's list of freed ones of n, if
;; it has one, and goes back to it, here, in the code, as Bend2 inlines
;; them; the runtime makes a new one, or one of more than 32 words.

;; Kernel code for a new node of n words: its address.
(define (node-code [n u32]) -> datum
  (if (> n 32)
      `(#%app %bend-rt:node ,(i32-const n))
      (let ([p (local! (sym node))])
        `(let ([,p (i32.load %bend-rt:lists ,(int (* 4 n)))])
           (if (i32.eqz ,p)
               (#%app %bend-rt:node ,(i32-const n))
               (begin
                 (i32.store %bend-rt:lists (i32.wrap_i64 (i64.load ,p)) ,(int (* 4 n)))
                 (i32.store %bend-rt:live-count (i32.add (i32.load %bend-rt:live-count) (i32.const 1)))
                 ,p))))))

;; Kernel code that frees node a, a variable, of n words.
(define (free-code [a datum] [n u32]) -> datum
  (if (> n 32)
      `(#%app %bend-rt:free-node ,a ,(i32-const n))
      `(begin
         (i64.store ,a (i64.extend_i32_u (i32.load %bend-rt:lists ,(int (* 4 n)))))
         (i32.store %bend-rt:lists ,a ,(int (* 4 n)))
         (i32.store %bend-rt:live-count (i32.sub (i32.load %bend-rt:live-count) (i32.const 1))))))

;; Kernel code for node a's field j, and that sets it to e.
(define (load-code [base datum] [j u32]) -> datum
  (if (== j 0) `(i64.load ,base) `(i64.load ,base ,(int (* 8 j)))))

(define (store-code [nd datum] [j u32] [e datum]) -> datum
  (if (== j 0) `(i64.store ,nd ,e) `(i64.store ,nd ,e ,(int (* 8 j)))))

;; ---- what is live ----

;; The domains of type T, each a ctx (q k T).
(define (domains [T (ptr term)]) -> datum (let ([u (tele-unbind T)]) (-> u doms)))

(define (dom-q [d datum]) -> u32 (-> (cast (ptr ctx) d) q))
(define (dom-k [d datum]) -> datum (-> (cast (ptr ctx) d) k))
(define (dom-T [d datum]) -> (ptr term) (-> (cast (ptr ctx) d) T))

;; Constructor k's fields: the last of its type's domains; and those of
;; constructor c of datatype t, an ADT term, its parameters t's.
(define (fields [k datum]) -> datum
  (let* ([c (book-ctr k)] [ds (domains (ctrd-T c))])
    (list-tail ds (- (length ds) (ctrd-n c)))))

(define (fields-of [c (ptr tld)] [t (ptr term)]) -> datum
  (let ([ds (domains (tele-fill (ctrd-T c) (adt-x t) (adt-n t) 0 0))])
    (list-tail ds (- (length ds) (ctrd-n c)))))

(define (live-fields [k datum]) -> u32
  (let ([fs (fields k)] [n u32 0])
    (for/each ([f fs])
      (unless (== (dom-q f) 0) (+= n 1)))
    n))

;; Constructor k's number in its family.
(define (number-of [k datum]) -> u32
  (let ([d (book-tld (book-fam k))])
    (for ([j u32 0]) (< j (adtd-nc d)) (+= j 1)
      (when (== (ctrd-k (@ (adtd-cs d) j)) k) (return j)))
    0))

;; Is family k a Nat's: no parameters, a constructor of no field, then
;; one of a live field of the family itself?
(define nats (ptr arena-table) 0)

(define (nat-family? [k datum]) -> i32
  (let ([known (table-ref nats (cast u64 k))])
    (if (!= known 0)
        (== known 1)
        (let ([d (book-tld k)] [e i32 0])
          (when (and (AdtD? d) (== (adtd-n d) 0) (== (adtd-nc d) 2)
                     (== (ctrd-n (@ (adtd-cs d) 0)) 0) (== (ctrd-n (@ (adtd-cs d) 1)) 1))
            (let ([fd (car (fields (ctrd-k (@ (adtd-cs d) 1))))])
              (when (!= (dom-q fd) 0)
                (let ([ft (term-wnf (dom-T fd))]) (set! e (and (ADT? ft) (== (adt-k ft) k)))))))
          (table-set! nats (cast u64 k) (if e 1 2))
          e))))

;; Is constructor k one of a single live field, a U32? Its value is
;; packed in its term, as Bend2 packs one of a word-sized field: its
;; number, then the U32's 32 bits.
(define words (ptr arena-table) 0)

(define (word-ctor? [k datum]) -> i32
  (let ([known (table-ref words (cast u64 k))])
    (if (!= known 0)
        (== known 1)
        (let ([fs (fields k)] [n u32 0] [e i32 0])
          (for/each ([f fs])
            (unless (== (dom-q f) 0)
              (+= n 1)
              (let ([ft (term-wnf (dom-T f))]) (set! e (and (ADT? ft) (== (adt-k ft) u32-family))))))
          (set! e (and e (== n 1)))
          (table-set! words (cast u64 k) (if e 1 2))
          e))))

;; Are family k's values words, terms that own nothing: a Nat's, U32, or
;; one whose constructors each have no live field, or one, a U32?
(define word-families (ptr arena-table) 0)

(define (word-family? [k datum]) -> i32
  (let ([known (table-ref word-families (cast u64 k))])
    (if (!= known 0)
        (== known 1)
        (let ([d (book-tld k)] [e i32 0])
          (cond [(or (nat-family? k) (== k u32-family)) (set! e 1)]
                [(AdtD? d)
                 (set! e 1)
                 (for ([j u32 0]) (< j (adtd-nc d)) (+= j 1)
                   (let ([ck (ctrd-k (@ (adtd-cs d) j))])
                     (unless (or (== (live-fields ck) 0) (word-ctor? ck)) (set! e 0))))])
          (table-set! word-families (cast u64 k) (if e 1 2))
          e))))

;; ---- layouts ----
;;
;; How a value of a type is held, decided from the type alone, so that
;; every module decides it alike: a word, a term that owns nothing: of a
;; word family, or what is erased; flat, words, up to max-flat of them: a
;; datatype, not recursive, of more than one word, whose live fields are
;; words, a single constructor's fields, or a sum's constructor number then
;; its fields; or uniform, a term that may own a node, as every other
;; datatype's value, a function's or a type variable's is. A node's
;; fields, a closure's argument and result and a polymorphic parameter
;; hold values uniform: a flat value is boxed into its constructor's node
;; there, and unboxed from it where it is flat again, by functions made for
;; its layout. A word value's term is its uniform one.

(struct lay [kind u32] [words u32] [nc u32] [counts (ptr u32)] [box datum] [unbox datum])

(define uniform-kind u32 0)
(define word-kind u32 1)
(define flat-kind u32 2)
(define max-flat u32 8)

(define uniform-lay (ptr lay) 0)
(define word-lay (ptr lay) 0)
;; Each layout made, by the family, for one of no parameters, or else the
;; type as shown; and the families whose layout is being found.
(define layouts (ptr arena-table) 0)
(define in-progress datum 0)

(define (new-lay [kind u32] [w u32] [nc u32] [counts (ptr u32)]) -> (ptr lay)
  (let ([l (cast (ptr lay) (alloc-in home (sizeof lay)))])
    (set! (-> l kind) kind)
    (set! (-> l words) w)
    (set! (-> l nc) nc)
    (set! (-> l counts) counts)
    (set! (-> l box) 0)
    (set! (-> l unbox) 0)
    l))

(define (flat? [l (ptr lay)]) -> i32 (== (-> l kind) flat-kind))

(define (layout-of [T (ptr term)]) -> (ptr lay)
  (if (== T 0)
      uniform-lay
      (let ([t (term-wnf T)])
        (cond [(or (Eql? t) (Typ? t) (Qnt? t)) word-lay]
              [(ADT? t) (adt-layout t)]
              [else uniform-lay]))))

(define (adt-layout [t (ptr term)]) -> (ptr lay)
  (let ([k (adt-k t)])
    (cond [(word-family? k) word-lay]
          [(!= (memq k in-progress) 0) uniform-lay]
          [else
           (let* ([key (cast u64 (if (== (adt-n t) 0) k (string->symbol (term-show-string (term-lower t 0)))))]
                  [known (cast (ptr lay) (table-ref layouts key))])
             (if (!= known 0)
                 known
                 (let ([l (flat-layout t)])
                   (table-set! layouts key (cast u32 l))
                   l)))])))

(define (flat-layout [t (ptr term)]) -> (ptr lay)
  (let* ([k (adt-k t)] [d (book-tld k)])
    (unless (AdtD? d) (return uniform-lay))
    (set! in-progress (cons k in-progress))
    (let ([nc (adtd-nc d)] [most u32 0] [ok i32 1] [counts (cast (ptr u32) (alloc-in home (* (+ (adtd-nc d) 1) 4)))])
      (for ([j u32 0]) (< j nc) (+= j 1)
        (let ([fs (fields-of (@ (adtd-cs d) j) t)] [m u32 0])
          (for/each ([f fs])
            (unless (== (dom-q f) 0)
              (+= m 1)
              (unless (== (layout-of (dom-T f)) word-lay) (set! ok 0))))
          (set! (@ counts j) m)
          (when (> m most) (set! most m))))
      (set! in-progress (cdr in-progress))
      (let ([w (+ most (if (> nc 1) 1 0))])
        (if (and ok (>= w 1) (<= w max-flat))
            (shape-lay w nc counts)
            uniform-lay)))))

;; The flat layout of nc constructors, each of counts' live fields, w
;; words: one for each such shape, whose box and unbox, which depend on it
;; alone, every type of it shares.
(define shapes (ptr arena-table) 0)

(define (shape-lay [w u32] [nc u32] [counts (ptr u32)]) -> (ptr lay)
  (let ([key nil])
    (for ([j u32 nc]) (> j 0) (-= j 1) (set! key (cons (make-integer (@ counts (- j 1))) key)))
    (let* ([k (cast u64 (string->symbol (fmt "~a" key)))] [known (cast (ptr lay) (table-ref shapes k))])
      (if (!= known 0)
          known
          (let ([l (new-lay flat-kind w nc counts)])
            (table-set! shapes k (cast u32 l))
            l)))))

;; A definition's signature: the layout of each of its n live parameters,
;; in order, and of its result, decided from its type alone, as every
;; module that calls it decides it; kept, so in memory of its own.
(struct sig [n u32] [params (ptr (ptr lay))] [result (ptr lay)])
(define signatures (ptr arena-table) 0)

(define (signature [k datum] [T (ptr term)] [n u32]) -> (ptr sig)
  (let ([known (cast (ptr sig) (table-ref signatures (cast u64 k)))])
    (if (!= known 0)
        known
        (let ([s (cast (ptr sig) (alloc-in home (sizeof sig)))] [u (tele-unbind T)] [ds datum 0] [m u32 0])
          (set! ds (-> u doms))
          (set! (-> s params) (cast (ptr (ptr lay)) (alloc-in home (* (+ n 1) 4))))
          (for ([j u32 0]) (< j n) (+= j 1)
            (cond [(pair? ds)
                   (unless (== (dom-q (car ds)) 0)
                     (set! (@ (-> s params) m) (layout-of (dom-T (car ds))))
                     (+= m 1))]
                  [else (set! (@ (-> s params) m) uniform-lay) (+= m 1)])
            (when (pair? ds) (set! ds (cdr ds))))
          (set! (-> s n) m)
          (set! (-> s result) (if (pair? ds) uniform-lay (layout-of (-> u tip))))
          (table-set! signatures (cast u64 k) (cast u32 s))
          s))))

;; Can kernel code call definition k: are its live parameters and its
;; result each one term?
(define (kernel-callable? [k datum]) -> i32
  (let* ([d (book-tld k)] [s (signature k (defd-T d) (defd-n d))])
    (when (flat? (-> s result)) (return 0))
    (for ([j u32 0]) (< j (-> s n)) (+= j 1)
      (when (flat? (@ (-> s params) j)) (return 0)))
    1))

;; ---- plain values ----
;;
;; A word owns nothing in memory: sharing and dropping it do nothing, so
;; the code does neither, for a variable whose layout says it is a word.
;; Another value is tested at run time, as its term says: below a node's
;; tag, it owns nothing.

;; Each plain variable -> 1.
(define plain (ptr arena-table) 0)

(define (plain! [v datum]) (table-set! plain (cast u64 v) 1))
(define (plain? [v datum]) -> i32 (!= (table-ref plain (cast u64 v)) 0))

;; Kernel code that drops v; and that shares it k times more: nothing for
;; a plain one, a test of its term for another.
(define (drop-code [v datum]) -> datum
  (if (plain? v) 0 `(if (i64.ge_u ,v ,(i64-const node-tag)) (#%app %bend-rt:drop ,v))))

(define (share-code [v datum] [k i64]) -> datum
  (if (plain? v) 0 `(if (i64.ge_u ,v ,(i64-const node-tag)) (set! ,v (#%app %bend-rt:share ,v ,(i32-const k))))))

;; l with c in front, unless c is 0.
(define (cons-code [c datum] [l datum]) -> datum (if (== c 0) l (cons c l)))

;; ---- a function's code ----
;;
;; What a term's code does, its variables a function's locals, each a
;; symbol holding a word or a term, before what owns what is said, each
;; giving as many values as its layout has words: a variable; a term word;
;; values, of parts; a call of a definition's function, by its name; a
;; U32 operation (above); an application of a closure; a Nat's successor;
;; a constructor's node, of its term's high bits, or its packed term; a
;; closure of a lifted function, of the variables it captures; a flat
;; value boxed, or unboxed; values bound; a match on a variable, or a flat
;; value's variables, by constructor, of a kind, a node's (0), a Nat's
;; (1), a U32's (2) or a flat value's (3), each branch's fields bound, and
;; what the others do; or a fault.

(variant ir
  [Use [v datum]]
  [Lit [x i64]]
  [Values [n u32] [xs (ptr (ptr ir))]]
  [Call [f datum] [n u32] [xs (ptr (ptr ir))] [k u32] [key datum]]
  [Prim [op u32] [n u32] [xs (ptr (ptr ir))]]
  [Apply [g (ptr ir)] [x (ptr ir)]]
  [Succ [x (ptr ir)]]
  [Make [bits i64] [n u32] [xs (ptr (ptr ir))]]
  [Pack [bits i64] [x (ptr ir)]]
  [Close [f datum] [n u32] [vs (ptr datum)]]
  [Box [l (ptr lay)] [x (ptr ir)]]
  [Unbox [l (ptr lay)] [x (ptr ir)]]
  [Bind [vs datum] [x (ptr ir)] [then (ptr ir)]]
  [Case [s datum] [kind i32] [n u32] [bs (ptr (ptr branch))] [other (ptr ir)]]
  [Fail])

(struct branch [number u32] [n u32] [word i32] [vs (ptr datum)] [then (ptr ir)])

(define (new-ir [c ir]) -> (ptr ir)
  (let ([p (cast (ptr ir) (alloc-in (current-arena) (sizeof ir)))]) (set! (@ p) c) p))

(define (lit [x i64]) -> (ptr ir) (new-ir (Lit x)))

(define (ir-array [n u32]) -> (ptr (ptr ir)) (cast (ptr (ptr ir)) (alloc-in (current-arena) (* (+ n 1) 4))))
(define (sym-array [n u32]) -> (ptr datum) (cast (ptr datum) (alloc-in (current-arena) (* (+ n 1) 4))))

;; How many values c gives.
(define (ir-words [c (ptr ir)]) -> u32
  (match c
    [(Values n xs)
     (let ([w u32 0])
       (for ([j u32 0]) (< j n) (+= j 1) (+= w (ir-words (@ xs j))))
       w)]
    [(Call _ _ _ k _) k]
    [(Unbox l _) (-> l words)]
    [(Bind _ _ r) (ir-words r)]
    [(Case _ _ n bs o)
     (let ([w u32 (if (!= o 0) (ir-words o) 0)])
       (for ([j u32 0]) (< j n) (+= j 1)
         (let ([bw (ir-words (-> (@ bs j) then))]) (when (> bw w) (set! w bw))))
       (if (== w 0) 1 w))]
    [_ 1]))

;; A value's code and its layout.
(struct val [c (ptr ir)] [l (ptr lay)])

(define (mkval [c (ptr ir)] [l (ptr lay)]) -> val
  (let ([v val])
    (set! (-> v c) c)
    (set! (-> v l) l)
    v))

;; Value v's code, held as want says: boxed, or unboxed, where it is flat
;; and want is not, or the other way; a word as it is, its term uniform.
(define (to [v val] [want (ptr lay)]) -> (ptr ir)
  (let ([have (-> v l)] [c (-> v c)])
    (cond [(== have want) c]
          [(flat? have)
           (let ([u (box-ir have c)]) (if (flat? want) (new-ir (Unbox want u)) u))]
          [(flat? want) (new-ir (Unbox want c))]
          [else c])))

;; Flat value c, of layout l, boxed: if it is a constructor's values, its
;; node, made here, or its packed term; else by l's function.
(define (box-ir [l (ptr lay)] [c (ptr ir)]) -> (ptr ir)
  (match c
    [(Values n xs)
     (let ([j u32 0] [from u32 0])
       (when (> (-> l nc) 1)
         (match (@ xs 0) [(Lit y) (set! j (cast u32 y))] [_ (return (new-ir (Box l c)))])
         (set! from 1))
       (let ([m (@ (-> l counts) j)])
         (if (== m 0)
             (lit (packed j))
             (let ([ys (ir-array m)])
               (for ([i u32 0]) (< i m) (+= i 1) (set! (@ ys i) (@ xs (+ from i))))
               (new-ir (Make (node-bits j m) m ys))))))]
    [_ (new-ir (Box l c))]))

;; ---- functions being made ----
;;
;; A function has its locals, each probe's binding, its layout and its
;; variables, or erased; and the function it is in, if it is a closure's,
;; whose variables it captures as it finds them: those, the latest first,
;; and its own for them.

(struct lfn [parent (ptr lfn)] [locals (ptr arena-table)] [captured datum] [caps datum] [ncap u32])

(define erased datum (sym %erased))

(define (new-lfn [parent (ptr lfn)]) -> (ptr lfn)
  (let ([f (cast (ptr lfn) (alloc-in (current-arena) (sizeof lfn)))])
    (set! (-> f parent) parent)
    (set! (-> f locals) (make-table))
    (set! (-> f captured) nil)
    (set! (-> f caps) nil)
    (set! (-> f ncap) 0)
    f))

;; A binding: a layout, and its variables, as many as it has words.
(define (binding [l (ptr lay)] [syms datum]) -> datum (cons (cast datum l) syms))
(define (b-lay [b datum]) -> (ptr lay) (cast (ptr lay) (car b)))
(define (b-syms [b datum]) -> datum (cdr b))

;; A new binding of layout l, its variables named from k, a word's plain.
(define (new-binding [l (ptr lay)] [k datum]) -> datum
  (let ([syms nil])
    (for ([j u32 0]) (< j (-> l words)) (+= j 1)
      (let ([s (local! k)])
        (unless (== (-> l kind) uniform-kind) (plain! s))
        (set! syms (cons s syms))))
    (binding l (reverse syms))))

;; The code of binding b's value.
(define (binding-ir [b datum]) -> (ptr ir)
  (let ([syms (b-syms b)])
    (if (null? (cdr syms))
        (new-ir (Use (car syms)))
        (let* ([n (length syms)] [xs (ir-array n)] [l syms])
          (for ([j u32 0]) (< j n) (+= j 1)
            (set! (@ xs j) (new-ir (Use (car l))))
            (set! l (cdr l)))
          (new-ir (Values n xs))))))

(define (probe [k datum]) -> (ptr term)
  (+= probes 1)
  (new-term (Var k probes 0 0)))

(define (bind! [f (ptr lfn)] [p (ptr term)] [v datum]) (table-set! (-> f locals) (cast u64 (cast u32 (var-i p))) (cast u32 v)))

(define (erased! [f (ptr lfn)] [k datum]) -> (ptr term)
  (let ([p (probe k)])
    (bind! f p erased)
    p))

;; The binding of probe p in f; or, in a closure, its own for the
;; parent's, each variable of which it captures; or erased.
(define (lookup [f (ptr lfn)] [p (ptr term)]) -> datum
  (let ([v (cast datum (table-ref (-> f locals) (cast u64 (cast u32 (var-i p)))))])
    (cond [(!= v 0) v]
          [(== (-> f parent) 0) (lower-error (c-text "a variable out of scope") 0 0)]
          [else
           (let ([pb (lookup (-> f parent) p)])
             (if (== pb erased)
                 pb
                 (let ([syms nil] [ps (b-syms pb)])
                   (for/each ([param ps])
                     (let ([c (local! (var-k p))])
                       (when (plain? param) (plain! c))
                       (set! (-> f captured) (cons param (-> f captured)))
                       (set! (-> f caps) (cons c (-> f caps)))
                       (+= (-> f ncap) 1)
                       (set! syms (cons c syms))))
                   (let ([b (binding (b-lay pb) (reverse syms))])
                     (bind! f p b)
                     b))))])))

;; ---- terms ----

;; t under its annotations and rewrites, and its type, from the innermost
;; annotation, or ty.
(struct peeled [x (ptr term)] [ty (ptr term)])

(define (peel [t (ptr term)] [ty (ptr term)]) -> peeled
  (let ([out peeled] [x (term-force t)])
    (while (or (Ann? x) (Rwt? x))
      (if (Ann? x)
          (begin (set! ty (ann-T x)) (set! x (term-force (ann-x x))))
          (set! x (term-force (rwt-f x)))))
    (set! (-> out x) x)
    (set! (-> out ty) ty)
    out))

;; Is x a function value: a match, or a lambda whose binder is live?
(define (function? [x (ptr term)] [ty (ptr term)]) -> i32
  (cond [(or (Mat? x) (Efq? x)) 1]
        [(Lam? x) (!= (all-q (ty-all ty)) 0)]
        [else 0]))

;; t as an expression's value, in function f, of type ty or its
;; annotation's; and held as want says.
(define (expr-ir [f (ptr lfn)] [t (ptr term)] [ty (ptr term)]) -> val
  (let* ([pl (peel t ty)] [x (-> pl x)] [xty (-> pl ty)])
    (cond
      [(Var? x)
       (let ([b (lookup f x)])
         (if (== b erased) (mkval (lit 0) word-lay) (mkval (binding-ir b) (b-lay b))))]
      [(or (Ref? x) (App? x)) (spine-ir f x xty)]
      [(Ctr? x) (construct-ir f x xty)]
      [(Nat? x) (nat-ir f x xty)]
      [(Let? x) (let-ir f x xty nil 0 0)]
      [(Hol? x)
       (lower-error (fmt "(? ~a) is a hole, which cannot run: fill it" (hol-k x)) `(? ,(hol-k x)) (term-s x))
       (mkval (lit 0) word-lay)]
      [(function? x xty) (mkval (closure-ir f x xty) uniform-lay)]
      [(Lam? x)
       (let* ([all (ty-all xty)] [p (erased! f (lam-k x))])
         (expr-ir f (body-apply (lam-bd x) p) (body-apply (all-bd all) p)))]
      [else (mkval (lit 0) word-lay)])))

(define (expr-at [f (ptr lfn)] [t (ptr term)] [want (ptr lay)]) -> (ptr ir) (to (expr-ir f t 0) want))

;; Nat literal x's value: its family's word, Zero's and n more, if its
;; family is a Nat's; else its constructors, unfolded.
(define (nat-ir [f (ptr lfn)] [x (ptr term)] [ty (ptr term)]) -> val
  (if (nat-family? (book-fam (nat-c x)))
      (mkval (lit (+ nat-zero (cast i64 (nat-n x)))) word-lay)
      (construct-ir f (nat-ctr x) ty)))

;; Constructor x's value, of type ty: a U32's machine word; its family's
;; Nat; flat, its number, if its family has more than one, then its live
;; fields, then 0s; packed; or a node of its live fields, each uniform.
(define (construct-ir [f (ptr lfn)] [x (ptr term)] [ty (ptr term)]) -> val
  (let* ([k (ctr-k x)] [v (number-of k)] [fam (book-fam k)] [fs (fields k)] [n u32 0] [xs (ir-array (ctr-n x))]
         [l (if (== k u32-name) word-lay (layout-of ty))])
    (when (== k u32-name)
      (let ([w (word-value (@ (ctr-x x) 0))])
        (when (>= w 0) (return (mkval (lit w) word-lay)))
        (set! (@ xs 0) (expr-at f (@ (ctr-x x) 0) uniform-lay))
        (return (mkval (new-ir (Prim op-word 1 xs)) word-lay))))
    (for ([j u32 0]) (< j (ctr-n x)) (+= j 1)
      (when (!= (dom-q (car fs)) 0)
        (set! (@ xs n) (expr-at f (@ (ctr-x x) j) (if (or (flat? l) (word-family? fam)) word-lay uniform-lay)))
        (+= n 1))
      (set! fs (cdr fs)))
    (cond [(nat-family? fam)
           (if (== n 0)
               (mkval (lit nat-zero) word-lay)
               (let ([a (@ xs 0)])
                 (match a [(Lit y) (mkval (lit (+ y 1)) word-lay)] [_ (mkval (new-ir (Succ a)) word-lay)])))]
          [(flat? l)
           (let* ([tagged (> (-> l nc) 1)] [w (-> l words)] [ys (ir-array w)] [i u32 0])
             (when tagged (set! (@ ys 0) (lit v)) (set! i 1))
             (for ([j u32 0]) (< j n) (+= j 1) (set! (@ ys i) (@ xs j)) (+= i 1))
             (while (< i w) (set! (@ ys i) (lit 0)) (+= i 1))
             (mkval (new-ir (Values w ys)) l))]
          [(word-ctor? k)
           (let ([a (@ xs 0)])
             (match a
               [(Lit y) (mkval (lit (bit-or (packed v) y)) word-lay)]
               [_ (mkval (new-ir (Pack (packed v) a)) word-lay)]))]
          [(== n 0) (mkval (lit (packed v)) (if (word-family? fam) word-lay uniform-lay))]
          [else (mkval (new-ir (Make (node-bits v n) n xs)) uniform-lay)])))

;; An application: its head, the annotated head, and its App nodes,
;; innermost first.
(struct spined [head (ptr term)] [h (ptr term)] [apps datum])

(define (spine [t (ptr term)]) -> spined
  (let ([out spined] [c (term-force t)] [h t] [apps nil])
    (while (or (App? c) (Ann? c))
      (if (App? c)
          (begin (set! apps (cons (cast datum c) apps)) (set! h (app-f c)) (set! c (term-force (app-f c))))
          (set! c (term-force (ann-x c)))))
    (set! (-> out head) c)
    (set! (-> out h) h)
    (set! (-> out apps) apps)
    out))

;; Which of definition k's n parameters are live, a list of 1 and 0, those
;; past its type's domains live.
(define (params-live [k datum]) -> datum
  (let* ([d (book-tld k)] [ds (domains (defd-T d))] [out nil])
    (for ([j u32 0]) (< j (defd-n d)) (+= j 1)
      (set! out (cons (if (pair? ds) (if (== (dom-q (car ds)) 0) 0 (int 1)) (int 1)) out))
      (when (pair? ds) (set! ds (cdr ds))))
    (reverse out)))

(define (count-live [flags datum]) -> u32
  (let ([n u32 0])
    (for/each ([flag flags])
      (when (!= flag 0) (+= n 1)))
    n))

(define (spine-ir [f (ptr lfn)] [t (ptr term)] [ty (ptr term)]) -> val
  (let* ([sp (spine t)] [head (-> sp head)] [apps (-> sp apps)] [napps (length apps)]
         [d (if (Ref? head) (book-tld (ref-k head)) 0)]
         [def (if (and (DefD? d) (!= (defd-v d) 0)) d 0)]
         [T (if (!= def 0) (defd-T def) (let ([hh (term-force (-> sp h))]) (if (Ann? hh) (ann-T hh) 0)))]
         [qs (if (!= T 0) (domains T) nil)]
         [live nil])
    ;; The applications whose arguments are live, those past the
    ;; domains too.
    (let ([a apps] [q qs])
      (while (pair? a)
        (when (or (null? q) (!= (dom-q (car q)) 0)) (set! live (cons (car a) live)))
        (set! a (cdr a))
        (when (pair? q) (set! q (cdr q)))))
    (set! live (reverse live))
    (cond
      [(!= def 0)
       (let ([need (count-live (params-live (ref-k head)))] [n (length live)])
         (cond [(and (>= n need) (erased-def? (ref-k head))) (mkval (lit 0) word-lay)]
               [(== n need)
                (let* ([s (signature (ref-k head) (defd-T def) (defd-n def))] [ps (-> s params)] [pi u32 0]
                       [xs (ir-array n)] [a live] [j u32 0] [op (prim-of (ref-k head))])
                  (while (pair? a)
                    (set! (@ xs j) (expr-at f (app-x (cast (ptr term) (car a))) (@ ps pi)))
                    (+= j 1)
                    (set! a (cdr a))
                    (+= pi 1))
                  (if (>= op 0)
                      (mkval (new-ir (Prim (cast u32 op) n xs)) word-lay)
                      (let ([inl (inline-ir f (ref-k head) def s xs n)])
                        (mkval (if (!= inl 0)
                                   inl
                                   (new-ir (Call (code-of (ref-k head)) n xs (-> (-> s result) words) (ref-k head))))
                               (-> s result)))))]
               [(> n need) (apply-last f live)]
               [else
                (let ([xs (term-array napps)] [a apps])
                  (for ([j u32 0]) (< j napps) (+= j 1)
                    (set! (@ xs j) (app-x (cast (ptr term) (car a))))
                    (set! a (cdr a)))
                  (expr-ir f (eta t (tele-fill (defd-T def) xs napps 0 0) (- (defd-n def) napps)) 0))]))]
      [(Ref? head) (mkval (lit 0) word-lay)]
      [(null? live) (expr-ir f (-> sp h) 0)]
      [else (apply-last f live)])))

;; The last live application of a spine, which applies a closure: its
;; argument and result uniform.
(define (apply-last [f (ptr lfn)] [live datum]) -> val
  (let ([a (cast (ptr term) (car (reverse live)))])
    (mkval (new-ir (Apply (expr-at f (app-f a) uniform-lay) (expr-at f (app-x a) uniform-lay))) uniform-lay)))

;; A let: its live values bound, then its body, an expression of type ty,
;; or, if tail, a function's body given args, held as want says.
(define (let-ir [f (ptr lfn)] [x (ptr term)] [ty (ptr term)] [args datum] [tail i32] [want (ptr lay)]) -> val
  (let ([n u32 0] [ks (ptr datum) 0] [qs (ptr u32) 0] [vs (ptr (ptr term)) 0] [bd (ptr body) 0])
    (match x [(Let ln lks _ lqs lvs _ lbd _) (set! n ln) (set! ks lks) (set! qs lqs) (set! vs lvs) (set! bd lbd)] [_ 0])
    (let ([ps (term-array n)] [names (sym-array n)] [vals (ir-array n)] [r val])
      (for ([j u32 0]) (< j n) (+= j 1)
        (if (== (@ qs j) 0)
            (begin (set! (@ ps j) (erased! f (@ ks j))) (set! (@ names j) 0))
            (let* ([p (probe (@ ks j))] [v (expr-ir f (@ vs j) 0)] [b (new-binding (-> v l) (@ ks j))])
              (set! (@ vals j) (-> v c))
              (bind! f p b)
              (set! (@ ps j) p)
              (set! (@ names j) (b-syms b)))))
      (let ([bdy (body-apply-n bd ps)])
        (set! r (if tail (mkval (body-ir f bdy ty args want) want) (expr-ir f bdy ty))))
      (let ([c (-> r c)])
        (for ([j u32 n]) (> j 0) (-= j 1)
          (unless (== (@ names (- j 1)) 0)
            (set! c (new-ir (Bind (@ names (- j 1)) (@ vals (- j 1)) c)))))
        (mkval c (-> r l))))))

;; A closure of x, a function value of type ty: its function lifted, a
;; function of the closure and the argument, uniform, made first, so that
;; what it captures is known; then the closure, of those values.
(define (closure-ir [f (ptr lfn)] [x (ptr term)] [ty (ptr term)]) -> (ptr ir)
  (let* ([g (new-lfn f)] [arg (local! (if (Lam? x) (lam-k x) (sym x)))] [name (fresh-global (sym closure))]
         [b (body-ir g x ty (list1 (binding uniform-lay (list1 arg))) uniform-lay)]
         [n (-> g ncap)] [vs (sym-array n)] [cs (reverse (-> g captured))])
    (for ([j u32 0]) (< j n) (+= j 1)
      (set! (@ vs j) (car cs))
      (set! cs (cdr cs)))
    (lift! (closure-func name (reverse (-> g caps)) n arg b))
    (new-ir (Close name n vs))))

;; t, of type ty, as the body of a function whose live arguments not yet
;; taken are args, bindings, its result held as want says: a lambda takes
;; one, if its binder is live, held as its binder's type says, and a match
;; takes its scrutinee and gives its case the constructor's live fields
;; (bend.ts's js_func).
(define (body-ir [f (ptr lfn)] [t (ptr term)] [ty (ptr term)] [args datum] [want (ptr lay)]) -> (ptr ir)
  (let* ([pl (peel t ty)] [x (-> pl x)] [xty (-> pl ty)])
    (cond
      [(and (null? args) (function? x xty)) (to (expr-ir f x xty) want)]
      [(Lam? x)
       (let* ([all (ty-all xty)] [p (probe (lam-k x))])
         (if (!= (all-q all) 0)
             ;; Its argument held as its binder's type says, or, a flat
             ;; value's held uniform, as it is, until it is needed flat.
             (let* ([a (car args)] [al (b-lay a)] [bl (layout-of (all-A all))]
                    [nb (if (or (== al bl) (and (flat? bl) (== al uniform-lay))) a (new-binding bl (lam-k x)))]
                    [rest (begin (bind! f p nb) (body-ir f (body-apply (lam-bd x) p) (body-apply (all-bd all) p) (cdr args) want))])
               (if (== nb a)
                   rest
                   (new-ir (Bind (b-syms nb) (to (mkval (binding-ir a) al) bl) rest))))
             (begin (bind! f p erased) (body-ir f (body-apply (lam-bd x) p) (body-apply (all-bd all) p) args want))))]
      [(Efq? x) (new-ir (Fail))]
      [(Mat? x) (match-ir f x xty args want)]
      [(Let? x) (-> (let-ir f x xty args 1 want) c)]
      [(pair? args) (body-ir f (eta x xty 1) xty args want)]
      [else (to (expr-ir f x xty) want)])))

;; A lambda-match's cases, each Mat node, in order, and what the last
;; one's m is.
(struct cased [arms datum] [rest (ptr term)])

(define (cases [t (ptr term)]) -> cased
  (let ([out cased] [arms nil] [cur t] [m (term-strip t)])
    (while (Mat? m)
      (set! arms (cons (cast datum m) arms))
      (set! cur (mat-m m))
      (set! m (term-strip cur)))
    (set! (-> out arms) (reverse arms))
    (set! (-> out rest) cur)
    out))

;; A match on the first of args, held as its type's layout says, or, a
;; flat value's held uniform, its node: if it is held otherwise, converted
;; first.
(define (match-ir [f (ptr lfn)] [x (ptr term)] [ty (ptr term)] [args datum] [want (ptr lay)]) -> (ptr ir)
  (let* ([all (ty-all ty)] [adt (term-wnf (all-A all))] [sl (layout-of (all-A all))] [a (car args)] [al (b-lay a)])
    (if (not (or (== al sl) (and (flat? sl) (== al uniform-lay))))
        (let ([nb (new-binding sl (sym s))])
          (new-ir (Bind (b-syms nb) (to (mkval (binding-ir a) al) sl)
                        (match-ir f x ty (cons nb (cdr args)) want))))
        (let* ([k (adt-k adt)] [total (adtd-nc (book-adt adt 0))]
               [kind (cond [(flat? al) 3] [(nat-family? k) 1] [(== k u32-family) 2] [else 0])]
               [cs (cases x)] [arms (-> cs arms)] [na (length arms)]
               [bs (cast (ptr (ptr branch)) (alloc-in (current-arena) (* (+ na 1) 4)))] [j u32 0])
          (for/each ([arm arms])
            (let ([mt (cast (ptr term) arm)])
              (set! (@ bs j) (branch-ir f (mat-k mt) (mat-h mt) (cdr args) adt sl kind (b-syms a) want)))
            (+= j 1))
          (new-ir (Case (if (== kind 3) (b-syms a) (car (b-syms a))) kind na bs
                        (if (< na total) (body-ir f (-> cs rest) 0 args want) 0)))))))

;; Case h of constructor k of datatype adt, its layout sl, of a match of
;; kind kind on the variables ss: its live fields bound, then the rest of
;; the arguments. A node's field is loaded as a term, and held uniform
;; until it is needed flat.
(define (branch-ir [f (ptr lfn)] [k datum] [h (ptr term)] [rest datum] [adt (ptr term)] [sl (ptr lay)] [kind i32]
                   [ss datum] [want (ptr lay)]) -> (ptr branch)
  (let ([fs (fields-of (book-ctr k) adt)] [bound nil] [loaded nil] [n u32 0]
        [b (cast (ptr branch) (alloc-in (current-arena) (sizeof branch)))]
        [w (if (and (== kind 3) (> (-> sl nc) 1)) (cdr ss) ss)])
    (for/each ([f fs])
      (unless (== (dom-q f) 0)
        (+= n 1)
        (if (== kind 3)
            ;; A flat value's field is one of its words.
            (begin (set! bound (cons (binding word-lay (list1 (car w))) bound)) (set! w (cdr w)))
            (let ([fl (layout-of (dom-T f))] [s (local! (dom-k f))])
              (when (or (== fl word-lay) (== kind 1) (word-ctor? k)) (plain! s))
              (set! loaded (cons s loaded))
              (set! bound (cons (binding (if (or (== kind 2) (flat? fl)) uniform-lay fl) (list1 s)) bound))))))
    (set! loaded (reverse loaded))
    (set! (-> b number) (number-of k))
    (set! (-> b word) (word-ctor? k))
    (set! (-> b n) (length loaded))
    (set! (-> b vs) (sym-array (length loaded)))
    (let ([l loaded])
      (for ([i u32 0]) (< i (-> b n)) (+= i 1)
        (set! (@ (-> b vs) i) (car l))
        (set! l (cdr l))))
    (set! (-> b then) (body-ir f h 0 (append (reverse bound) rest) want))
    b))

;; ---- inlining ----
;;
;; A call of a definition whose code is small is that code, made here, of
;; its value checked again (core.sub's checked-value), its parameters
;; bound to the arguments: if the code made is of size inline-limit or
;; less (ir-size), and the definition does not call itself. Code inlined
;; inlines too, max-inline deep. Whether a definition's code is small is
;; kept for the module; its checked value, in the arena of the piece of
;; code being made, for that piece.

(define inline-limit u32 40)
(define max-inline u32 2)
;; A value of more nodes than raw-limit, unchecked, is not small.
(define raw-limit u32 200)
(define inline-depth u32 0)
;; Each definition's name -> 1 if it is inlined, 2 if not; and -> its
;; checked value.
(define inlines (ptr arena-table) 0)
(define bodies (ptr arena-table) 0)

(define (inline-ir [f (ptr lfn)] [k datum] [d (ptr tld)] [s (ptr sig)] [xs (ptr (ptr ir))] [n u32]) -> (ptr ir)
  (when (or (>= inline-depth max-inline) (== (table-ref inlines (cast u64 k)) 2)) (return 0))
  (let ([v (cast (ptr term) (table-ref bodies (cast u64 k)))])
    (when (== v 0)
      ;; First, what its value says as it is, unchecked.
      (when (or (refers? (defd-v d) k) (> (term-size (defd-v d) raw-limit) raw-limit))
        (table-set! inlines (cast u64 k) 2)
        (return 0))
      (set! v (checked-value k))
      (when (or (== v 0) (refers? v k))
        (table-set! inlines (cast u64 k) 2)
        (return 0))
      (table-set! bodies (cast u64 k) (cast u32 v)))
    (let ([params nil] [ds (domains (defd-T d))] [j u32 0] [body (ptr ir) 0])
      (for ([i u32 0]) (< i (defd-n d)) (+= i 1)
        (when (or (null? ds) (!= (dom-q (car ds)) 0))
          (set! params (cons (new-binding (@ (-> s params) j) (if (pair? ds) (dom-k (car ds)) (sym x))) params))
          (+= j 1))
        (when (pair? ds) (set! ds (cdr ds))))
      (set! params (reverse params))
      (+= inline-depth 1)
      (set! body (body-ir f (higher v) (defd-T d) params (-> s result)))
      (-= inline-depth 1)
      (when (> (ir-size body) inline-limit)
        (table-set! inlines (cast u64 k) 2)
        (return 0))
      (table-set! inlines (cast u64 k) 1)
      ;; The arguments bound, in order.
      (let ([l (reverse params)])
        (for ([i u32 n]) (> i 0) (-= i 1)
          (set! body (new-ir (Bind (b-syms (car l)) (@ xs (- i 1)) body)))
          (set! l (cdr l))))
      body)))

;; How big c's code is, about: a variable's and a number's nothing, a
;; node's 4, a match's branch that takes a node 8, a closure's more than
;; any limit, anything else 1, with its parts.
(define (ir-size [c (ptr ir)]) -> u32
  (match c
    [(Use _) 0]
    [(Lit _) 0]
    [(Values n xs) (irs-size xs n)]
    [(Call _ n xs _ _) (+ 1 (irs-size xs n))]
    [(Prim _ n xs) (+ 1 (irs-size xs n))]
    [(Apply g x) (+ 1 (+ (ir-size g) (ir-size x)))]
    [(Succ x) (+ 1 (ir-size x))]
    [(Make _ n xs) (+ 4 (irs-size xs n))]
    [(Pack _ x) (+ 1 (ir-size x))]
    [(Close _ _ _) 1000000]
    [(Box _ x) (+ 4 (ir-size x))]
    [(Unbox _ x) (+ 4 (ir-size x))]
    [(Bind _ x r) (+ (ir-size x) (ir-size r))]
    [(Case _ kind n bs o)
     (let ([t u32 (if (!= o 0) (+ 1 (ir-size o)) 1)])
       (for ([j u32 0]) (< j n) (+= j 1)
         (let ([b (@ bs j)])
           (when (and (== kind 0) (> (-> b n) 0) (not (-> b word))) (+= t 8))
           (+= t (ir-size (-> b then)))))
       t)]
    [_ 1]))

(define (irs-size [xs (ptr (ptr ir))] [n u32]) -> u32
  (let ([t u32 0])
    (for ([j u32 0]) (< j n) (+= j 1) (+= t (ir-size (@ xs j))))
    t))

;; A piece of code started, a definition's or a print's: its checked
;; values in its arena.
(define (start-piece!)
  (set! bodies (make-table))
  (set! borrowed (make-table))
  (set! inline-depth 0))

;; Does t, a checked term, refer to definition k?
(define (refers? [t (ptr term)] [k datum]) -> i32
  (when (== t 0) (return 0))
  (match t
    [(Var _ i v _) (and (< i 0) (refers? v k))]
    [(Ref r _) (== r k)]
    [(Sub _ v _ b _) (or (refers? v k) (refers? b k))]
    [(Let n _ _ _ vs b _ _)
     (for ([j u32 0]) (< j n) (+= j 1) (when (refers? (@ vs j) k) (return 1)))
     (refers? b k)]
    [(Lam _ _ b _ _) (refers? b k)]
    [(App g x _) (or (refers? g k) (refers? x k))]
    [(Ctr _ n xs _)
     (for ([j u32 0]) (< j n) (+= j 1) (when (refers? (@ xs j) k) (return 1)))
     0]
    [(Mat _ h m _) (or (refers? h k) (refers? m k))]
    [(Rwt _ _ b _) (refers? b k)]
    [(Ann x _ _) (refers? x k)]
    [_ 0]))

;; How many nodes t has, a term, checked or not, a U32 number one, up to
;; past limit.
(define (term-size [t (ptr term)] [limit u32]) -> u32
  (when (== t 0) (return 0))
  (match t
    [(Var _ i v _) (if (and (< i 0) (!= v 0)) (term-size v limit) 1)]
    [(Sub _ v _ b _) (+ (term-size v limit) (term-size b limit))]
    [(Let n _ _ _ vs b _ _)
     (let ([s u32 1])
       (for ([j u32 0]) (< j n) (+= j 1)
         (+= s (term-size (@ vs j) limit))
         (when (> s limit) (return s)))
       (+ s (term-size b limit)))]
    [(Lam _ _ b _ _) (+ 1 (term-size b limit))]
    [(App g x _) (let ([s (+ 1 (term-size g limit))]) (if (> s limit) s (+ s (term-size x limit))))]
    [(Ctr k n xs _)
     (if (== k u32-name)
         1
         (let ([s u32 1])
           (for ([j u32 0]) (< j n) (+= j 1)
             (+= s (term-size (@ xs j) limit))
             (when (> s limit) (return s)))
           s))]
    [(Mat _ h m _) (let ([s (+ 1 (term-size h limit))]) (if (> s limit) s (+ s (term-size m limit))))]
    [(Rwt _ _ b _) (term-size b limit)]
    [(Ann x _ _) (term-size x limit)]
    [_ 1]))

;; ---- borrowing ----
;;
;; A + parameter of a definition, a term, that its code only reads is
;; borrowed, as Bend2's borrow inference finds: its caller keeps it, and
;; lends it for the call. The code matches it in place, neither taking
;; its node nor freeing it, and reads its fields borrowed too; it never
;; shares one, which would leave its owner's term out of date, nor drops
;; one. Each + parameter of a term starts borrowed; one whose value, or a
;; value read from it, reaches a place that owns it, as a constructor's
;; field, a result, a closure or a parameter not borrowed, is owned, and
;; again, until none does (infer-borrows!). A parameter of one use is
;; owned: its caller, done with it, gives it, and its code frees it as it
;; reads it, or reuses its nodes. A call lends a value it owns by holding
;; it, and drops it after, so it is not a tail call: a call of the
;; definition itself at the end of its way, then, owns what it would
;; lend; and a definition that calls one not made yet, a law to fill
;; later, which owns all its parameters, owns all its own, so that no
;; loop of calls grows the stack.

;; Each definition's name -> its mask, plus 1: bit j its j-th live
;; parameter's, if it is borrowed. A definition made has one.
(define borrows (ptr arena-table) 0)

(define (borrow-mask [k datum]) -> u32
  (let ([m (table-ref borrows (cast u64 k))]) (if (== m 0) 0 (- m 1))))

(define (set-borrow-mask! [k datum] [m u32]) (table-set! borrows (cast u64 k) (+ m 1)))

(define (lent? [k datum] [j u32]) -> i32 (and (< j 32) (!= (bit-and (borrow-mask k) (<< (cast u32 1) j)) 0)))

;; The variable c is, or 0.
(define (use-of [c (ptr ir)]) -> datum (match c [(Use v) v] [_ 0]))

;; For a pass: each variable read from a borrowed parameter -> its place
;; plus 1; the places of those that reach an owner; and the definition.
(define roots (ptr arena-table) 0)
(define escaped u32 0)
(define current-def datum 0)

(define (root-of [v datum]) -> u32 (if (plain? v) 0 (table-ref roots (cast u64 v))))

(define (escape-place! [r u32]) (unless (== r 0) (set! escaped (bit-or escaped (<< (cast u32 1) (- r 1))))))

;; What of c reaches an owner: c's value does, at the end of the
;; function's way if tail.
(define (scan! [c (ptr ir)] [tail i32])
  (match c
    [(Use v) (escape-place! (root-of v))]
    [(Values n xs) (scan-all! xs n)]
    [(Call _ n xs _ key)
     (for ([j u32 0]) (< j n) (+= j 1)
       (let* ([x (@ xs j)] [v (use-of x)])
         (cond [(not (lent? key j)) (scan! x 0)]
               [(== v 0)
                (scan! x 0)
                (when (and tail (== key current-def)) (escape-place! (+ j 1)))]
               ;; A value of its own lent to itself at the end of its way.
               [(and tail (== key current-def) (== (root-of v) 0) (not (plain? v))) (escape-place! (+ j 1))])))]
    [(Prim _ n xs) (scan-all! xs n)]
    [(Apply g x) (scan! g 0) (scan! x 0)]
    [(Succ x) (scan! x 0)]
    [(Make _ n xs) (scan-all! xs n)]
    [(Pack _ x) (scan! x 0)]
    [(Close _ n vs) (for ([j u32 0]) (< j n) (+= j 1) (escape-place! (root-of (@ vs j))))]
    [(Box _ x) (scan! x 0)]
    [(Unbox _ x) (scan! x 0)]
    [(Bind vs x r)
     (let ([v (use-of x)])
       (if (and (!= v 0) (null? (cdr vs)))
           (let ([rt (root-of v)]) (unless (== rt 0) (table-set! roots (cast u64 (car vs)) rt)))
           (scan! x 0)))
     (scan! r tail)]
    [(Case s kind n bs o)
     (let ([rt (if (or (pair? s) (!= kind 0)) 0 (root-of s))])
       (for ([j u32 0]) (< j n) (+= j 1)
         (let ([b (@ bs j)])
           (unless (== rt 0)
             (for ([i u32 0]) (< i (-> b n)) (+= i 1)
               (table-set! roots (cast u64 (@ (-> b vs) i)) rt)))
           (scan! (-> b then) tail)))
       (unless (== o 0) (scan! o tail)))]
    [_ 0]))

(define (scan-all! [xs (ptr (ptr ir))] [n u32])
  (for ([j u32 0]) (< j n) (+= j 1) (scan! (@ xs j) 0)))

;; Does c call a definition not made yet?
(define (calls-unmade? [c (ptr ir)]) -> i32
  (match c
    [(Call _ n xs _ key) (or (== (table-ref borrows (cast u64 key)) 0) (calls-unmade-any? xs n))]
    [(Values n xs) (calls-unmade-any? xs n)]
    [(Prim _ n xs) (calls-unmade-any? xs n)]
    [(Make _ n xs) (calls-unmade-any? xs n)]
    [(Apply g x) (or (calls-unmade? g) (calls-unmade? x))]
    [(Succ x) (calls-unmade? x)]
    [(Pack _ x) (calls-unmade? x)]
    [(Box _ x) (calls-unmade? x)]
    [(Unbox _ x) (calls-unmade? x)]
    [(Bind _ x r) (or (calls-unmade? x) (calls-unmade? r))]
    [(Case _ _ n bs o)
     (for ([j u32 0]) (< j n) (+= j 1) (when (calls-unmade? (-> (@ bs j) then)) (return 1)))
     (and (!= o 0) (calls-unmade? o))]
    [_ 0]))

(define (calls-unmade-any? [xs (ptr (ptr ir))] [n u32]) -> i32
  (for ([j u32 0]) (< j n) (+= j 1) (when (calls-unmade? (@ xs j)) (return 1)))
  0)

;; Which of definition k's parameters, params, bindings, its code body
;; borrows: each of a term of many uses, by many, a mask, starts borrowed,
;; and those that reach an owner are owned, again, until none does. Kept
;; as k's mask, which it gives.
(define (infer-borrows! [k datum] [params datum] [many u32] [body (ptr ir)]) -> u32
  (let ([mask u32 0] [j u32 0] [l params] [go i32 1])
    (for/each ([x l])
      (let ([b x])
        (when (and (< j 32) (== (b-lay b) uniform-lay) (not (plain? (car (b-syms b)))) (!= (bit-and many (<< (cast u32 1) j)) 0))
          (set! mask (bit-or mask (<< (cast u32 1) j)))))
      (+= j 1))
    (set-borrow-mask! k mask)
    (when (calls-unmade? body) (set! mask 0))
    (set! current-def k)
    (while (and go (!= mask 0))
      (set-borrow-mask! k mask)
      (set! roots (make-table))
      (set! escaped 0)
      (set! j 0)
      (set! l params)
      (for/each ([x l])
        (when (lent? k j) (table-set! roots (cast u64 (car (b-syms x))) (+ j 1)))
        (+= j 1))
      (scan! body 1)
      (set! go (!= escaped 0))
      (set! mask (bit-and mask (bit-xor escaped 4294967295))))
    (set-borrow-mask! k mask)
    mask))

;; The variables borrowed in the piece of code being made, each -> 1.
(define borrowed (ptr arena-table) 0)

(define (borrow! [v datum]) (table-set! borrowed (cast u64 v) 1))
(define (borrowed? [v datum]) -> i32 (!= (table-ref borrowed (cast u64 v)) 0))

;; ---- owning ----
;;
;; A function's code made kernel code, gamma the variables it owns, each
;; once, all of which it uses on its way or drops: those its code does
;; not use are dropped as it starts; one that more than one part of an
;; expression uses is shared, as many times more, before any of them
;; runs; a match takes its scrutinee. A node a match takes, its own, is a
;; spare, which the first constructor of as many fields on the way reuses;
;; one no constructor reuses is freed where the way ends. A word owns
;; nothing, and is neither shared nor dropped.

(struct spare [at datum] [n u32] [used i32] [next (ptr spare)])

(define (new-spare [at datum] [n u32] [next (ptr spare)]) -> (ptr spare)
  (let ([s (cast (ptr spare) (alloc-in (current-arena) (sizeof spare)))])
    (set! (-> s at) at)
    (set! (-> s n) n)
    (set! (-> s used) 0)
    (set! (-> s next) next)
    s))

;; The spares of sp not used, again, for a way of their own.
(define (pending [sp (ptr spare)]) -> (ptr spare)
  (if (== sp 0)
      0
      (let ([rest (pending (-> sp next))])
        (if (-> sp used) rest (new-spare (-> sp at) (-> sp n) rest)))))

;; Does c use v?
(define (uses? [c (ptr ir)] [v datum]) -> i32
  (match c
    [(Use x) (== x v)]
    [(Values n xs) (uses-any? xs n v)]
    [(Call _ n xs _ _) (uses-any? xs n v)]
    [(Prim _ n xs) (uses-any? xs n v)]
    [(Apply g x) (or (uses? g v) (uses? x v))]
    [(Succ x) (uses? x v)]
    [(Make _ n xs) (uses-any? xs n v)]
    [(Pack _ x) (uses? x v)]
    [(Box _ x) (uses? x v)]
    [(Unbox _ x) (uses? x v)]
    [(Close _ n vs)
     (for ([j u32 0]) (< j n) (+= j 1) (when (== (@ vs j) v) (return 1)))
     0]
    [(Bind _ x r) (or (uses? x v) (uses? r v))]
    [(Case s _ n bs o)
     (when (or (== s v) (and (pair? s) (!= (memq v s) 0))) (return 1))
     (for ([j u32 0]) (< j n) (+= j 1) (when (uses? (-> (@ bs j) then) v) (return 1)))
     (and (!= o 0) (uses? o v))]
    [_ 0]))

(define (uses-any? [xs (ptr (ptr ir))] [n u32] [v datum]) -> i32
  (for ([j u32 0]) (< j n) (+= j 1) (when (uses? (@ xs j) v) (return 1)))
  0)

(define (used-by [gamma datum] [c (ptr ir)]) -> datum
  (let ([out nil])
    (for/each ([x gamma])
      (when (uses? c x) (set! out (cons x out))))
    (reverse out)))

(define (sequence [pre datum] [e datum]) -> datum (if (null? pre) e `(begin ,@pre ,e)))

;; c's kernel code, owning gamma, with spares sp, at the end of its way
;; if tail.
(define (emit [c (ptr ir)] [gamma datum] [sp (ptr spare)] [tail i32]) -> datum
  (let ([live nil] [drops nil])
    (for/each ([x gamma])
      (if (uses? c x)
          (set! live (cons x live))
          (set! drops (cons-code (drop-code x) drops))))
    (sequence (reverse drops) (emit-live c (reverse live) sp tail))))

;; The kernel code of parts xs, which own gamma, all of which they use:
;; the shares, then each part's code.
(define (emit-parts [xs (ptr (ptr ir))] [n u32] [gamma datum] [sp (ptr spare)]) -> datum
  (let ([shares nil] [codes nil] [g gamma])
    (for/each ([x g])
      (let ([k i64 0])
        (for ([j u32 0]) (< j n) (+= j 1) (when (uses? (@ xs j) x) (+= k 1)))
        (when (> k 1)
          (set! shares (cons-code (share-code x (- k 1)) shares)))))
    (for ([j u32 0]) (< j n) (+= j 1)
      (set! codes (cons (emit (@ xs j) (used-by gamma (@ xs j)) sp 0) codes)))
    (cons (reverse shares) (reverse codes))))

;; The arguments of parts xs, whose codes are codes, each part as many as
;; it gives values: (bindings arguments temporaries). A part of one value
;; is its code; one of values, their codes, which run in order as
;; arguments do; another is bound to locals first, so that each argument
;; is one value, and so is a part that force says, a list of 1 and 0 or
;; nil, whose local is a temporary; and so is each part before them, so
;; that the parts run in order.
(define (part-args [xs (ptr (ptr ir))] [n u32] [codes datum] [force datum]) -> datum
  (let ([binds nil] [args nil] [temps nil] [cs codes] [fs force] [last i32 -1])
    (for ([j u32 0]) (< j n) (+= j 1)
      (when (or (and (!= (ir-words (@ xs j)) 1) (not (values-code? (car cs)))) (and (pair? fs) (!= (car fs) 0)))
        (set! last (cast i32 j)))
      (set! cs (cdr cs))
      (when (pair? fs) (set! fs (cdr fs))))
    (set! cs codes)
    (set! fs force)
    (for ([j u32 0]) (< j n) (+= j 1)
      (let ([w (ir-words (@ xs j))] [code (car cs)])
        (cond [(> (cast i32 j) last)
               (set! args (if (== w 1) (cons code args) (append (reverse (cdr code)) args)))]
              [else
               (let ([syms nil])
                 (for ([i u32 0]) (< i w) (+= i 1) (set! syms (cons (local! (sym v)) syms)))
                 (set! syms (reverse syms))
                 (set! binds (cons (if (== w 1) `[,(car syms) ,code] `[,syms ,code]) binds))
                 (set! args (append (reverse syms) args))
                 (when (and (pair? fs) (!= (car fs) 0)) (set! temps (cons (car syms) temps))))]))
      (set! cs (cdr cs))
      (when (pair? fs) (set! fs (cdr fs))))
    `(,(reverse binds) ,(reverse args) ,(reverse temps))))

(define (values-code? [code datum]) -> i32 (and (pair? code) (== (car code) (sym values))))

;; e in the let* of binds, if any.
(define (bound-code [binds datum] [e datum]) -> datum (if (null? binds) e `(let* ,binds ,e)))

;; Call code, of k results, then temps dropped, then its results.
(define (after-call [call datum] [k u32] [temps datum]) -> datum
  (let ([rs nil] [drops nil])
    (for ([i u32 0]) (< i k) (+= i 1) (set! rs (cons (local! (sym r)) rs)))
    (for/each ([temp temps])
      (set! drops (cons-code (drop-code temp) drops)))
    `(let ([,(if (== k 1) (car rs) rs) ,call])
       ,@(reverse drops)
       ,(if (== k 1) (car rs) `(values ,@rs)))))

;; Where the way ends, the spares no constructor on it reused freed
;; first.
(define (finish [e datum] [sp (ptr spare)] [tail i32]) -> datum
  (let ([frees nil])
    (when tail
      (while (!= sp 0)
        (unless (-> sp used)
          (set! frees (cons (free-code (-> sp at) (-> sp n)) frees)))
        (set! sp (-> sp next))))
    (sequence frees e)))

;; A node of n words for a constructor: a spare's, if one is free.
(define (alloc-code [n u32] [sp (ptr spare)]) -> datum
  (while (!= sp 0)
    (when (and (not (-> sp used)) (== (-> sp n) n))
      (set! (-> sp used) 1)
      (return (-> sp at)))
    (set! sp (-> sp next)))
  (node-code n))

(define (emit-live [c (ptr ir)] [gamma datum] [sp (ptr spare)] [tail i32]) -> datum
  (match c
    [(Use v) (finish v sp tail)]
    [(Lit x) (finish (i64-const x) sp tail)]
    [(Fail) `(unreachable)]
    [(Values n xs)
     (let* ([pc (emit-parts xs n gamma sp)] [pa (part-args xs n (cdr pc) nil)])
       (finish (sequence (car pc) (bound-code (car pa) (if (and (== n 1) (null? (car pa))) (car (cadr pa)) `(values ,@(cadr pa)))))
               sp tail))]
    ;; A part lent, a value of the caller's own or made for the call, held
    ;; in a temporary, which is dropped after.
    [(Call fn n xs k key)
     (let* ([pc (emit-parts xs n gamma sp)] [force nil] [pa datum 0])
       (for ([j u32 0]) (< j n) (+= j 1)
         (let ([v (use-of (@ xs j))])
           (set! force (cons (if (and (lent? key j) (not (and (!= v 0) (or (borrowed? v) (plain? v))))) (cast datum 1) 0) force))))
       (set! pa (part-args xs n (cdr pc) (reverse force)))
       (let ([call `(#%app ,fn ,@(cadr pa))])
         (finish (sequence (car pc) (bound-code (car pa) (if (null? (caddr pa)) call (after-call call k (caddr pa))))) sp tail)))]
    [(Prim op n xs)
     (let ([pc (emit-parts xs n gamma sp)])
       (finish (sequence (car pc) (prim-code op (cdr pc))) sp tail))]
    [(Apply g x)
     (let* ([xs (ir-array 2)] [cv (local! (sym g))] [av (local! (sym x))])
       (set! (@ xs 0) g)
       (set! (@ xs 1) x)
       (let ([pc (emit-parts xs 2 gamma sp)])
         (finish (sequence (car pc)
                           `(let ([,cv ,(cadr pc)])
                              (let ([,av ,(caddr pc)])
                                (call-indirect (i64 i64 -> i64) ,(index-code cv) ,cv ,av))))
                 sp tail)))]
    [(Succ x) (finish `(i64.add ,(emit x gamma sp 0) (i64.const 1)) sp tail)]
    [(Pack bits x)
     (let ([e (emit x gamma sp 0)]) (finish (if (== bits 0) e `(i64.or ,(i64-const bits) ,e)) sp tail))]
    [(Box l x)
     (let* ([xs (ir-array 1)] [pc datum 0] [pa datum 0])
       (set! (@ xs 0) x)
       (set! pc (emit-parts xs 1 gamma sp))
       (set! pa (part-args xs 1 (cdr pc) nil))
       (finish (sequence (car pc) (bound-code (car pa) `(#%app ,(box-name l) ,@(cadr pa)))) sp tail))]
    [(Unbox l x) (finish `(#%app ,(unbox-name l) ,(emit x gamma sp 0)) sp tail)]
    [(Make bits n xs)
     (let* ([nd (local! (sym nd))] [at (alloc-code n sp)] [pc (emit-parts xs n gamma sp)] [stores nil] [es (cdr pc)])
       (for ([j u32 0]) (< j n) (+= j 1)
         (set! stores (cons (store-code nd j (car es)) stores))
         (set! es (cdr es)))
       (finish (sequence (car pc)
                         `(let ([,nd ,at])
                            ,@(reverse stores)
                            (i64.or ,(i64-const bits) (i64.extend_i32_u ,nd))))
               sp tail))]
    [(Close fn n vs)
     (let ([word `(i64.or ,(i64-const closure-tag) (i64.shl (i64.extend_i32_u (func-index ,fn)) (i64.const 32)))])
       (if (== n 0)
           (finish word sp tail)
           (let ([nd (local! (sym nd))] [stores nil])
             (for ([j u32 0]) (< j n) (+= j 1)
               (set! stores (cons (store-code nd (+ j 1) (@ vs j)) stores)))
             (finish `(let ([,nd ,(node-code (+ n 1))])
                        (i64.store ,nd ,(i64-const n))
                        ,@(reverse stores)
                        (i64.or ,word (i64.extend_i32_u ,nd)))
                     sp tail))))]
    ;; A variable borrowed, bound again: borrowed.
    [(Bind vs x r)
     (let ([v (use-of x)])
       (if (and (!= v 0) (null? (cdr vs)) (borrowed? v))
           (begin
             (borrow! (car vs))
             `(let ([,(car vs) ,v]) ,(emit r gamma sp tail)))
           (let ([shares nil] [g gamma])
             (for/each ([y g])
               (when (and (uses? x y) (uses? r y))
                 (set! shares (cons-code (share-code y 1) shares))))
             (sequence (reverse shares)
                       `(let ([,(if (null? (cdr vs)) (car vs) vs) ,(emit x (used-by gamma x) sp 0)])
                          ,(emit r (append vs (used-by gamma r)) sp tail))))))]
    [(Case s kind n bs o) (emit-case s kind n bs o gamma sp tail)]))

;; A match on s, which owns gamma, s among them: each branch's way its
;; own, and, for a node it takes, that node a spare of it. At the end of
;; its function's way, tail 1, a branch has the spares not yet used too,
;; and returns; else its value flows on from the match, and it frees the
;; spares it does not use before it does. A flat value's match, kind 3,
;; is on its variables s, the first its constructor's number if its
;; family has more than one. A match of switch-ways ways or more is a
;; switch on its constructor's number, and a chain of a Nat's, one on its
;; count (nat-chain); a smaller one tests each branch in turn.
(define switch-ways u32 4)

(define (emit-case [s datum] [kind i32] [n u32] [bs (ptr (ptr branch))] [o (ptr ir)] [gamma datum] [sp (ptr spare)] [tail i32]) -> datum
  (let ([rest nil] [tg (local! (sym tag))] [codes nil] [tests nil] [numbers nil] [tagged i32 0] [nat (== kind 1)]
        [mode i32 (if (== tail 1) 1 2)] [bsp (if (== tail 1) sp (cast (ptr spare) 0))])
    (let ([g gamma])
      (for/each ([x g])
        (unless (or (== x s) (and (pair? s) (!= (memq x s) 0))) (set! rest (cons x rest)))))
    (set! rest (reverse rest))
    (when nat
      (let ([c (nat-chain s n bs o rest bsp mode)]) (when (!= c 0) (return c))))
    (for ([j u32 0]) (< j n) (+= j 1)
      (let ([b (@ bs j)])
        ;; The last branch, with no other code, is not tested; a test of
        ;; constructor 0 of no field is of the term 0, its packed word.
        (set! tests (cons (cond [nat (if (== (-> b number) 0) `(i64.eq ,s ,(i64-const nat-zero)) `(i64.ne ,s ,(i64-const nat-zero)))]
                                [(== kind 3) `(i64.eq ,(car s) ,(i64-const (-> b number)))]
                                [(and (== (-> b number) 0) (== (-> b n) 0)) `(i64.eqz ,s)]
                                [else
                                 (unless (and (== j (- n 1)) (== o 0)) (set! tagged 1))
                                 `(i32.eq ,tg ,(i32-const (-> b number)))])
                          tests))
        (set! numbers (cons (int (-> b number)) numbers))
        (set! codes (cons (branch-code s kind b rest (pending bsp) mode) codes))))
    (let ([chain (if (!= o 0) (emit o gamma (pending bsp) mode) 0)])
      (set! codes (reverse codes))
      (set! tests (reverse tests))
      (if (and (or (== kind 0) (== kind 3)) (>= (+ n (if (!= o 0) 1 0)) switch-ways))
          (if (== kind 3)
              (switch-code `(i32.wrap_i64 ,(car s)) (reverse numbers) codes chain 0 mode)
              `(let ([,tg ,(variant-code s)]) ,(switch-code tg (reverse numbers) codes chain 0 mode)))
          (let ([dispatch (if-chain tests codes chain)])
            (if tagged `(let ([,tg ,(variant-code s)]) ,dispatch) dispatch))))))

;; The ifs of tests, each running its code, the last code alone if there
;; is no other code.
(define (if-chain [tests datum] [codes datum] [other datum]) -> datum
  (cond [(null? codes) (if (!= other 0) other `(unreachable))]
        [(and (null? (cdr codes)) (== other 0)) (car codes)]
        [else `(if ,(car tests) ,(car codes) ,(if-chain (cdr tests) (cdr codes) other))]))
;; A switch on index, an i32: each of codes runs for its number, in
;; numbers, and other for any other number, or, if there is no other
;; code, the last code does. Each case is its block's, after the block,
;; and returns, if the switch ends its function's way, mode 1, or gives
;; its value from a block around them all, mode 2; the other code is past
;; them all. If each code is a number, it is a table's (const-table).
;; bounded says index is at most past the numbers by one.
(define (switch-code [index datum] [numbers datum] [codes datum] [other datum] [bounded i32] [mode i32]) -> datum
  (when (== other 0)
    (set! other (car (reverse codes)))
    (set! codes (reverse (cdr (reverse codes))))
    (set! numbers (reverse (cdr (reverse numbers)))))
  (let ([labels nil] [lf (local! (sym other))] [entries nil] [top i64 0] [l numbers])
    (for/each ([x l])
      (when (>= (integer-value x) top) (set! top (+ (integer-value x) 1))))
    (when (and (const-code? other) (all-const? codes))
      (return (const-table index numbers codes other top bounded)))
    (set! l codes)
    (for/each ([x l])
      (set! labels (cons (local! (sym case)) labels)))
    (set! labels (reverse labels))
    (for ([i i64 0]) (< i top) (+= i 1)
      (let ([e lf] [ns numbers] [ls labels])
        (while (pair? ns)
          (when (== (integer-value (car ns)) i) (set! e (car ls)))
          (set! ns (cdr ns))
          (set! ls (cdr ls)))
        (set! entries (cons e entries))))
    (let ([b `(block ,(car labels) (br-table ,(reverse entries) ,lf ,index))] [ls labels] [cs codes] [done (local! (sym done))])
      (for/each ([c cs])
        (set! b `(block ,(if (pair? (cdr ls)) (cadr ls) lf) ,b ,(if (== mode 1) `(return ,c) `(br ,done ,c))))
        (set! ls (cdr ls)))
      (if (== mode 1) `(begin ,b ,other) `(block ,done ,b ,other)))))

;; Is code a number, (i64.const n)? Is each of codes?
(define (const-code? [code datum]) -> i32 (and (pair? code) (== (car code) (sym i64.const))))

(define (all-const? [codes datum]) -> i32
  (for/each ([x codes])
    (unless (const-code? x) (return 0)))
  1)

;; A switch of numbers alone: the number at index in a table of each
;; number up to top the code's for it, or other's, then other's, past
;; them, in memory the module takes as it starts (runtime.sub's static),
;; as a string literal's bytes are.
(define (const-table [index datum] [numbers datum] [codes datum] [other datum] [top i64] [bounded i32]) -> datum
  (let ([g (fresh-global (sym constants))] [p (local! (sym p))] [ix (local! (sym i))] [stores nil])
    (for ([i i64 0]) (<= i top) (+= i 1)
      (let ([v other] [ns numbers] [cs codes])
        (while (pair? ns)
          (when (== (integer-value (car ns)) i) (set! v (car cs)))
          (set! ns (cdr ns))
          (set! cs (cdr cs)))
        (set! stores (cons (store-code p (cast u32 i) v) stores))))
    (lift! `(global ,g (mut i32)
              (let ([,p (#%app %bend-rt:static ,(i32-const (* 8 (+ top 1))))])
                ,@(reverse stores)
                ,p)))
    `(i64.load (i32.add ,g (i32.shl ,(if bounded
                                          index
                                          `(let ([,ix ,index]) (if (i32.lt_u ,ix ,(i32-const top)) ,ix ,(i32-const top))))
                                     (i32.const 3))))))

;; A chain of matches on a Nat s, each but the first on the one before's
;; predecessor, which nothing else uses, of each a Zero and a Succ branch,
;; of nat-levels levels or more, as a match on Nat numbers is: a switch
;; on s's count, each level's Zero branch its case, and past them the last
;; level's Succ branch, whose predecessor is s less the levels; or, if s's
;; match is not one, 0.
(define nat-levels u32 3)

(define (nat-chain [s datum] [n u32] [bs (ptr (ptr branch))] [o (ptr ir)] [rest datum] [sp (ptr spare)] [mode i32]) -> datum
  (let ([zeros nil] [k i64 0] [succ (ptr branch) 0] [go i32 (nat-level? n bs o)])
    (unless go (return 0))
    (while go
      (let ([sc (branch-of bs n 1)])
        (set! zeros (cons (cast datum (-> (branch-of bs n 0) then)) zeros))
        (+= k 1)
        (set! succ sc)
        (set! go 0)
        (match (-> sc then)
          [(Case ts tkind tn tbs to)
           (when (and (== tkind 1) (== ts (@ (-> sc vs) 0)) (nat-level? tn tbs to) (not (branches-use? tn tbs ts)))
             (set! n tn)
             (set! bs tbs)
             (set! o to)
             (set! go 1))]
          [_ 0])))
    (when (< k nat-levels) (return 0))
    (let ([p (@ (-> succ vs) 0)] [codes nil] [numbers nil] [z (reverse zeros)] [j i64 0])
      (for/each ([x z])
        (set! codes (cons (emit (cast (ptr ir) x) rest (pending sp) mode) codes))
        (set! numbers (cons (int j) numbers))
        (+= j 1))
      (switch-code `(if (i64.lt_u ,s ,(i64-const (+ nat-zero k))) (i32.wrap_i64 ,s) ,(i32-const k))
                   (reverse numbers) (reverse codes)
                   (let ([d (emit (-> succ then) (cons p rest) (pending sp) mode)])
                     (if (uses? (-> succ then) p) `(let ([,p (i64.sub ,s ,(i64-const k))]) ,d) d))
                   1 mode))))

;; Does a Nat's match of branches bs, n of them, and other code o, have
;; a Zero and a Succ branch and no other code?
(define (nat-level? [n u32] [bs (ptr (ptr branch))] [o (ptr ir)]) -> i32
  (and (== o 0) (!= (branch-of bs n 0) 0) (!= (branch-of bs n 1) 0)))

;; The branch of bs, n of them, of constructor number v, or 0.
(define (branch-of [bs (ptr (ptr branch))] [n u32] [v u32]) -> (ptr branch)
  (for ([j u32 0]) (< j n) (+= j 1) (when (== (-> (@ bs j) number) v) (return (@ bs j))))
  0)

;; Does a branch of bs, n of them, use v?
(define (branches-use? [n u32] [bs (ptr (ptr branch))] [v datum]) -> i32
  (for ([j u32 0]) (< j n) (+= j 1) (when (uses? (-> (@ bs j) then) v) (return 1)))
  0)

;; Branch b of a match on s: its fields bound, and its way. A node
;; borrowed is read where it is, through its redirect if it is shared,
;; neither taken nor freed, and its fields are borrowed.
(define (branch-code [s datum] [kind i32] [b (ptr branch)] [rest datum] [sp (ptr spare)] [mode i32]) -> datum
  (let ([n (-> b n)] [vs (-> b vs)] [fvs nil])
    (for ([j u32 n]) (> j 0) (-= j 1) (set! fvs (cons (@ vs (- j 1)) fvs)))
    (cond
      [(== n 0) (emit (-> b then) rest sp mode)]
      [(== kind 1)
       `(let ([,(@ vs 0) (i64.sub ,s (i64.const 1))])
          ,(emit (-> b then) (cons (@ vs 0) rest) sp mode))]
      [(== kind 2)
       `(let ([,(@ vs 0) (#%app %bend-rt:u32-word ,s)])
          ,(emit (-> b then) (cons (@ vs 0) rest) sp mode))]
      [(-> b word)
       `(let ([,(@ vs 0) (i64.and ,s (i64.const 4294967295))])
          ,(emit (-> b then) (cons (@ vs 0) rest) sp mode))]
      [(borrowed? s)
       (let ([a (local! (sym node))] [loads nil])
         (for ([j u32 0]) (< j n) (+= j 1)
           (borrow! (@ vs j))
           (set! loads (cons `[,(@ vs j) ,(load-code a j)] loads)))
         `(let ([,a (if (i64.lt_s ,s (i64.const 0))
                        (i32.wrap_i64 (i64.shr_u (i64.load (i32.wrap_i64 ,s)) (i64.const 32)))
                        (i32.wrap_i64 ,s))])
            (let ,(reverse loads)
              ,(emit (-> b then) rest sp mode))))]
      [else
       (let ([a (local! (sym node))] [loads nil])
         (for ([j u32 0]) (< j n) (+= j 1)
           (set! loads (cons `[,(@ vs j) ,(load-code a j)] loads)))
         `(let ([,a (if (i64.lt_s ,s (i64.const 0)) (#%app %bend-rt:take ,s ,(i32-const n)) (i32.wrap_i64 ,s))])
            (let ,(reverse loads)
              ,(emit (-> b then) (append fvs rest) (new-spare a n sp) mode))))])))

;; A closure's function: its captured values read, its node freed, then
;; its body, which owns them and its argument.
(define (closure-func [name datum] [caps datum] [n u32] [arg datum] [b (ptr ir)]) -> datum
  (let ([self (local! (sym self))] [nd (local! (sym nd))] [loads nil] [l caps] [j u32 1])
    (for/each ([x l])
      (set! loads (cons `[,x ,(load-code nd j)] loads))
      (+= j 1))
    `(func (,name [,self i64] [,arg i64]) -> i64
       ,(if (== n 0)
            (emit b (list1 arg) 0 1)
            `(let ([,nd (i32.wrap_i64 ,self)])
               (let ,(reverse loads)
                 ,(free-code nd (+ n 1))
                 ,(emit b (cons arg caps) 0 1)))))))

;; ---- boxing ----
;;
;; A flat value boxed is its constructor's term, its uniform value: a node
;; of its live fields, or, of none, packed; unboxed, its words again, the
;; node taken and freed. Each is a function of the module's, made once for
;; each layout that needs it.

(define (result-types [l (ptr lay)]) -> datum
  (if (== (-> l words) 1)
      `i64
      (let ([out nil]) (for ([j u32 0]) (< j (-> l words)) (+= j 1) (set! out (cons `i64 out))) out)))

(define (box-name [l (ptr lay)]) -> datum
  (when (== (-> l box) 0)
    (set! (-> l box) (fresh-global (sym box)))
    (lift! (box-func l)))
  (-> l box))

(define (unbox-name [l (ptr lay)]) -> datum
  (when (== (-> l unbox) 0)
    (set! (-> l unbox) (fresh-global (sym unbox)))
    (lift! (unbox-func l)))
  (-> l unbox))

(define (box-func [l (ptr lay)]) -> datum
  (let* ([w (-> l words)] [nc (-> l nc)] [ws nil] [from u32 (if (> nc 1) 1 0)] [arms nil] [tests nil])
    (for ([j u32 0]) (< j w) (+= j 1) (set! ws (cons (local! (sym w)) ws)))
    (set! ws (reverse ws))
    (for ([j u32 0]) (< j nc) (+= j 1)
      (let ([m (@ (-> l counts) j)])
        (set! tests (cons `(i64.eq ,(car ws) ,(i64-const j)) tests))
        (set! arms (cons (if (== m 0)
                             (i64-const (packed j))
                             (let ([nd (local! (sym nd))] [stores nil] [f (list-tail ws from)])
                               (for ([i u32 0]) (< i m) (+= i 1)
                                 (set! stores (cons (store-code nd i (car f)) stores))
                                 (set! f (cdr f)))
                               `(let ([,nd ,(node-code m)])
                                  ,@(reverse stores)
                                  (i64.or ,(i64-const (node-bits j m)) (i64.extend_i32_u ,nd)))))
                         arms))))
    `(func (,(-> l box) ,@(map (lambda ([s datum]) -> datum `[,s i64]) ws)) -> i64
       ,(if-chain (reverse tests) (reverse arms) 0))))

(define (unbox-func [l (ptr lay)]) -> datum
  (let* ([w (-> l words)] [nc (-> l nc)] [t (local! (sym t))] [tg (local! (sym tag))] [arms nil] [tests nil])
    (for ([j u32 0]) (< j nc) (+= j 1)
      (let ([m (@ (-> l counts) j)] [vals nil] [loads nil] [a (local! (sym node))])
        (when (> nc 1) (set! vals (cons (i64-const j) vals)))
        (for ([i u32 0]) (< i m) (+= i 1)
          (let ([fv (local! (sym f))])
            (set! loads (cons `[,fv ,(load-code a i)] loads))
            (set! vals (cons fv vals))))
        (while (< (length vals) w) (set! vals (cons `(i64.const 0) vals)))
        (set! vals (reverse vals))
        (set! tests (cons `(i32.eq ,tg ,(i32-const j)) tests))
        (set! arms (cons (if (== m 0)
                             (if (== w 1) (car vals) `(values ,@vals))
                             `(let ([,a (if (i64.lt_s ,t (i64.const 0)) (#%app %bend-rt:take ,t ,(i32-const m)) (i32.wrap_i64 ,t))])
                                (let ,(reverse loads)
                                  ,(free-code a m)
                                  ,(if (== w 1) (car vals) `(values ,@vals)))))
                         arms))))
    `(func (,(-> l unbox) [,t i64]) -> ,(result-types l)
       (let ([,tg ,(variant-code t)]) ,(if-chain (reverse tests) (reverse arms) 0)))))

;; ---- definitions ----

;; Definition k's function, named fsym, of type T, its first n binders its
;; parameters, of checked value e: a function of its live parameters, each
;; as many locals as its layout has words, which it owns, or, if borrow
;; and it only reads one, borrows (infer-borrows!), of as many results as
;; its result's layout has; a U32 operation's, its instructions.
(define (def-function [k datum] [fsym datum] [n u32] [T (ptr term)] [e (ptr term)] [borrow i32]) -> datum
  (start-piece!)
  (let* ([s (signature k T n)] [ds (domains T)] [ps (-> s params)] [pi u32 0] [params nil] [syms nil] [op (prim-of k)])
    (for ([j u32 0]) (< j n) (+= j 1)
      (when (or (null? ds) (!= (dom-q (car ds)) 0))
        (let ([b (new-binding (@ ps pi) (if (pair? ds) (dom-k (car ds)) (sym x)))])
          (set! params (cons b params))
          (set! syms (append (reverse (b-syms b)) syms))
          (+= pi 1)))
      (when (pair? ds) (set! ds (cdr ds))))
    (set! params (reverse params))
    (set! syms (reverse syms))
    `(func (,fsym ,@(map (lambda ([x datum]) -> datum `[,x i64]) syms)) -> ,(result-types (-> s result))
       ,(if (>= op 0)
            (begin (set-borrow-mask! k 0) (prim-code (cast u32 op) syms))
            (let ([body (body-ir (new-lfn 0) (higher e) T params (-> s result))] [owned nil] [j u32 0] [l datum 0])
              (if borrow (infer-borrows! k params (many-mask T n) body) (set-borrow-mask! k 0))
              (set! l params)
              (for/each ([x l])
                (if (lent? k j)
                    (borrow! (car (b-syms x)))
                    (set! owned (append (reverse (b-syms x)) owned)))
                (+= j 1))
              (emit body (reverse owned) 0 1))))))

;; The mask of the live parameters, of type T's first n domains, of many
;; uses, +.
(define (many-mask [T (ptr term)] [n u32]) -> u32
  (let ([ds (domains T)] [m u32 0] [j u32 0])
    (for ([i u32 0]) (< i n) (+= i 1)
      (cond [(null? ds) (+= j 1)]
            [(!= (dom-q (car ds)) 0)
             (when (and (== (dom-q (car ds)) 2) (< j 32)) (set! m (bit-or m (<< (cast u32 1) j))))
             (+= j 1)])
      (when (pair? ds) (set! ds (cdr ds))))
    m))

;; ---- print ----
;;
;; A print writes a value, and a newline, as the example writes terms: a
;; constructor's name and its fields, a Nat as (nat n), a proof as refl;
;; then drops it. What writes a value of a type is a function made for the
;; type, as Bend's show_main makes a descriptor for its main's, which
;; reads the value, uniform, and leaves it. A function, a type, or a
;; datatype with an erased field, or one whose type depends on another,
;; cannot be written.

;; The type being printed, shown, for errors.
(define printed datum 0)

;; The code of a print of checked term e, of type T.
(define (print-code [e (ptr term)] [T (ptr term)]) -> datum
  (start-piece!)
  (set! printed (term-show-string (term-lower (term-wnf T) 0)))
  (let ([v (local! (sym v))])
    `(let ([,v ,(emit (to (expr-ir (new-lfn 0) (higher e) T) uniform-lay) nil 0 0)])
       (#%app ,(printer T) ,v)
       (#%app %bend-rt:drop ,v)
       (#%app %bend-rt:newline))))

;; The function that writes values of type T, made the first time.
(define (printer [T (ptr term)]) -> datum
  (let* ([t (term-wnf T)] [shown (term-show-string (term-lower t 0))] [key (cast u64 (string->symbol shown))]
         [known (cast datum (table-ref printers key))])
    (if (!= known 0)
        known
        (let ([name (fresh-global (sym show))])
          (table-set! printers key (cast u32 name))
          (lift! (printer-func name t shown))
          name))))

(define (write-text [s datum]) -> datum
  (let ([out nil] [p (string-bytes s)])
    (for ([j u32 0]) (< j (string-length s)) (+= j 1)
      (set! out (cons `(#%app %bend-rt:write-byte ,(i32-const (@ p j))) out)))
    (reverse out)))

(define (refuse [shown datum]) -> datum
  (lower-error (fmt "a value of type ~a cannot be written: ~a is a function, a type, or a datatype with an erased or dependent field" printed (if (string=? shown printed) `"it" shown))
               0 0))

(define (printer-func [name datum] [t (ptr term)] [shown datum]) -> datum
  (cond
    [(Eql? t) `(func (,name [v i64]) ,@(write-text `"refl"))]
    [(ADT? t)
     (let ([d (book-tld (adt-k t))])
       (unless (AdtD? d) (refuse shown))
       (cond
         [(== (adt-k t) u32-family) `(func (,name [v i64]) (#%app %bend-rt:write-u32 v))]
         [(and (nat? d) (nat-family? (adt-k t))) `(func (,name [v i64]) (#%app %bend-rt:write-nat v))]
         [(nat-family? (adt-k t))
          (let ([z (short (ctrd-k (@ (adtd-cs d) 0)))] [s (short (ctrd-k (@ (adtd-cs d) 1)))])
            `(func (,name [v i64])
               (if (i64.eq v ,(i64-const nat-zero))
                   (begin ,@(write-text z))
                   (begin ,@(write-text (fmt "(~a " s))
                          (#%app ,name (i64.sub v (i64.const 1)))
                          (#%app %bend-rt:write-byte (i32.const 41))))))]
         [else
          (let ([arms nil])
            (for ([j u32 0]) (< j (adtd-nc d)) (+= j 1)
              (let* ([c (@ (adtd-cs d) j)]
                     [fs (fields-of c t)]
                     [writes nil] [m u32 0] [word (word-ctor? (ctrd-k c))])
                (for/each ([f fs])
                  (when (== (dom-q f) 0) (refuse shown))
                  (set! writes (cons `(#%app ,(printer (dom-T f)) ,(if word `(i64.and v (i64.const 4294967295)) (load-code `b m)))
                                     (cons `(#%app %bend-rt:write-byte (i32.const 32)) writes)))
                  (+= m 1))
                (set! arms (cons (if (== m 0)
                                     `(begin ,@(write-text (short (ctrd-k c))))
                                     `(let ([b ,(if word `(i32.const 0) `(#%app %bend-rt:node-of v))])
                                        ,@(write-text (fmt "(~a" (short (ctrd-k c))))
                                        ,@(reverse writes)
                                        (#%app %bend-rt:write-byte (i32.const 41))))
                                 arms))))
            `(func (,name [v i64]) (let ([tag ,(variant-code `v)]) ,(printer-arms (reverse arms) 0))))]))]
    [else (refuse shown)]))

(define (printer-arms [arms datum] [j u32]) -> datum
  (cond [(null? arms) `(unreachable)]
        [(null? (cdr arms)) (car arms)]
        [else `(if (i32.eq tag ,(i32-const j)) ,(car arms) ,(printer-arms (cdr arms) (+ j 1)))]))

;; Is datatype d Nat, Zero and Succ?
(define (nat? [d (ptr tld)]) -> i32
  (and (== (adtd-nc d) 2)
       (named? (ctrd-k (@ (adtd-cs d) 0)) "Zero") (== (ctrd-n (@ (adtd-cs d) 0)) 0)
       (named? (ctrd-k (@ (adtd-cs d) 1)) "Succ") (== (ctrd-n (@ (adtd-cs d) 1)) 1)))
