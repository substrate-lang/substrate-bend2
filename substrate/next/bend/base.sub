;; Lifecycle: experimental. examples/bend/base.sub, as the new compiler
;; builds it: a slice of Bend's Base (bend2/base.bend), ported:
;; its first datatypes, and arithmetic and equality on Nat. A constructor
;; named as its datatype is, which Bend's braces tell apart, is named in
;; lower case: Unit's is unit.
(require-unqualified bend "bend.sub")

(provide Empty Unit unit Bool False True Either Inl Inr Sigma Tuple Nat Zero Succ Maybe None Some
         List Nil Con Pair Equal.cong Equal.sym Equal.trans Bool.not Nat.double Nat.add Nat.mul)

(type Empty Data)

(type Unit Data [unit])

(type Bool Data [False] [True])

(type (Either a b [- A : (Kind a)] [- B : (Kind b)]) (Kind (meet a b))
  [Inl [value : A]]
  [Inr [value : B]])

(type (Sigma a b [- A : (Kind a)] [- B : (-> [- x : A] (Kind b))]) (Kind (meet a b))
  [Tuple [fst : A] [snd : (B fst)]])

(type Nat Data [Zero] [Succ [pred : Nat]])

(type (Maybe a [- A : (Kind a)]) (Kind a) [None] [Some [value : A]])

(type (List a [- A : (Kind a)]) (Kind a) [Nil] [Con [head : A] [tail : (List a A)]])

;; A & B, a law here, as in Bend, which fills it below.
(law (Pair [- A : Type] [- B : Type]) Type)
(def (Pair A B) (Sigma &1 &1 A (fn (_) B)))

(law (Equal.cong [- A : Type] [- B : Type] [- f : (-> A B)] [- a : A] [- b : A] [e : (== a b A)])
     (== (f a) (f b) B))
(def (Equal.cong A B f a b e)
  (rewrite e (== (f a) (f _) B) refl))

(law (Equal.sym [- A : Type] [- a : A] [- b : A] [e : (== a b A)]) (== b a A))
(def (Equal.sym A a b e)
  (rewrite e (== _ a A) refl))

(law (Equal.trans [- A : Type] [- a : A] [- b : A] [- c : A] [ab : (== a b A)] [bc : (== b c A)]) (== a c A))
(def (Equal.trans A a b c ab bc)
  (rewrite bc (== a _ A) ab))

(def (Bool.not [b : Bool]) Bool
  (match b [False True] [True False]))

(def (Nat.double [n : Nat]) Nat
  (match n
    [Zero Zero]
    [(Succ p) (Succ (Succ (Nat.double p)))]))

(def (Nat.add [a : Nat] [b : Nat]) Nat
  (match a
    [Zero b]
    [(Succ p) (Succ (Nat.add p b))]))

(def (Nat.mul [a : Nat] [+ b : Nat]) Nat
  (match a
    [Zero Zero]
    [(Succ p) (Nat.add b (Nat.mul p b))]))
