(define-syntax bend-split keyword-alone)
(define-syntax bend-absurd keyword-alone)
(define-syntax bend-eql keyword-alone)
(define-syntax bend-refl keyword-alone)
(define-syntax bend-rewrite keyword-alone)
(define-syntax bend-the keyword-alone)
(define-syntax bend-hole keyword-alone)
(define-syntax bend-nat keyword-alone)
(define-syntax bend-kind keyword-alone)
(define-syntax bend-meet keyword-alone)
(define-syntax bend-Type keyword-alone)
(define-syntax bend-Data keyword-alone)
(define-syntax bend-Quant keyword-alone)
(define-syntax bend-q0 keyword-alone)
(define-syntax bend-q1 keyword-alone)
(define-syntax bend-q2 keyword-alone)

;; A number in kernel code: the kernel's, typed by where it is.
(define-macro (bend-datum s)
  (let ([l (syntax->list s)])
    (unless (and (!= l 0) (== (length l) 2)) (bend-fail s "expected (#%datum n)" nil))
    #`(#%datum #,(cadr l))))
