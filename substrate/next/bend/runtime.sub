;; Lifecycle: experimental. What a program of Bend as the new compiler
;; builds it (next/bend) runs with, besides its own code, in the C-like
;; Lisp: cells in linear memory, made by bump allocation and never freed,
;; for now, as Bend's affine types will say when one can be; and what a
;; print, whose code lower.sub makes, writes with. A module whose Bend
;; definitions have code requires this one as %bend-rt, and shares its
;; memory and table.

(require-unqualified c "../c/c.sub")
(require print "../../lib/print.sub")
(memory from c)
(table from c)

(provide alloc write-byte write-nat newline)

;; Where the next cell goes, and the end of the chunk it is in.
(define next (ptr u8) 0)
(define end (ptr u8) 0)

;; A new cell of n bytes, a multiple of 4: its address. Cells come from
;; chunks of 1 MiB, or of n bytes if n is more.
(define (alloc [n u32]) -> i32
  (when (> (+ next n) end)
    (let ([size (if (> n 1048576) n 1048576)])
      (set! next (cast (ptr u8) (malloc size)))
      (set! end (+ next size))))
  (let ([p next])
    (+= next n)
    (cast i32 p)))

(define (write-byte [b i32]) (print:write-byte b))
(define (newline) (print:newline))

;; The Nat at x, as the example writes it: Zero, or (nat n). Its Succ is
;; constructor 1, its field the predecessor.
(define (write-nat [x i32])
  (let ([n u64 0] [c (cast (ptr i32) x)])
    (while (== (@ c 0) 1)
      (+= n 1)
      (set! c (cast (ptr i32) (@ c 1))))
    (if (== n 0)
        (begin (write-byte 90) (write-byte 101) (write-byte 114) (write-byte 111))
        (begin
          (write-byte 40) (write-byte 110) (write-byte 97) (write-byte 116) (write-byte 32)
          (print:write-u64 (cast i64 n))
          (write-byte 41)))))
