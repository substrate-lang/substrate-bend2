;; Bend as the new compiler builds it (next/bend): a + parameter a
;; definition only reads is borrowed (lower.sub): its caller lends the
;; value, holding one of its own and dropping it after; one whose value
;; escapes is owned, as is one of one use.
(require-unqualified bend "../../bend/bend.sub")
(require-unqualified base "../../bend/base.sub")
(require print "../../../lib/print.sub" write-int newline)

(type T Data [L [v : U32]] [N [l : T] [r : T]])

(def (gen [+ n : Nat] [+ s : U32]) T
  (match n [Zero (L s)] [(Succ p) (N (gen p (U32.mul s 2)) (gen p (U32.inc (U32.mul s 2))))]))

;; Read: borrowed.
(def (sum [+ t : T]) U32 (match t [(L v) v] [(N l r) (U32.add (sum l) (sum r))]))

;; A field given back: owned.
(def (left [+ t : T]) T (match t [(L v) (L v)] [(N l r) l]))

;; Of one use: owned, its nodes reused.
(def (mirror [t : T]) T (match t [(L v) (L v)] [(N l r) (N (mirror r) (mirror l))]))

;; Read, though it makes nodes: borrowed.
(def (copy [+ t : T]) T (match t [(L v) (L v)] [(N l r) (N (copy l) (copy r))]))

;; One owned, one borrowed, given one value twice.
(def (graft [t : T] [+ u : T]) T
  (match t [(L v) (L (U32.add v (sum u)))] [(N l r) (N (graft l u) (graft r u))]))

(def (twice [+ t : T]) U32 (U32.add (sum t) (sum t)))

(def (both [n : Nat]) U32 (let ([+ t (gen n 1)]) (U32.add (sum t) (sum (mirror t)))))

;; A value made, lent to itself at the end of its way: owned, so that the
;; call is a tail call, however deep.
(def (spin [n : Nat] [+ t : T]) U32 (match n [Zero (sum t)] [(Succ p) (spin p (copy t))]))

(def (small) T (gen (nat 2) 3))

(func (main)
  (print (sum (gen (nat 3) 1)))
  (print (sum (left (gen (nat 3) 1))))
  (print (graft (gen (nat 1) 1) (gen (nat 1) 5)))
  (print (twice (gen (nat 2) 1)))
  (print (both (nat 2)))
  (print (spin (U32.to_nat 100000) (gen (nat 2) 1)))
  ;; A call from kernel code, which lends.
  (write-int (i32.wrap_i64 (sum (small))))
  (newline)
  (write-int (live-cells))
  (newline))
