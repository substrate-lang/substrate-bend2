;; Bend as the new compiler builds it (next/bend): a program frees what it
;; is done with (runtime.sub). A value has one owner, which a match takes
;; it from, its node freed or reused, or which drops it, all it holds
;; freed, unless it is shared, through a + binder, which counts its
;; owners. So once each value printed is dropped, no node is in use:
;; (live-cells) is 0.
(require-unqualified bend "../../bend/bend.sub")
(require-unqualified base "../../bend/base.sub")
(require print "../../../lib/print.sub" write-int newline)

;; n is used twice, so it is +.
(def (range [+ n : Nat]) (List Nat)
  (match n
    [Zero Nil]
    [(Succ p) (Con (Succ p) (range p))]))

(def (range2 [+ n : Nat]) (List &2 Nat)
  (match n
    [Zero Nil]
    [(Succ p) (Con (Succ p) (range2 p))]))

(def (sum [xs : (List Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (sum t (Nat.add h acc))]))

(def (sum2 [xs : (List &2 Nat)] [acc : Nat]) Nat
  (match xs
    [Nil acc]
    [(Con h t) (sum2 t (Nat.add h acc))]))

;; Each node a match takes is reused for the Con it builds.
(def (inc-all [xs : (List Nat)]) (List Nat)
  (match xs
    [Nil Nil]
    [(Con h t) (Con (Succ h) (inc-all t))]))

;; ys is dropped, all of it.
(def (first [xs : (List Nat)] [ys : (List Nat)]) (List Nat) xs)

;; A shared list, taken apart twice: the first match leaves its node to
;; the other owner, and gives its fields another owner each.
(def (both [+ xs : (List &2 Nat)]) Nat (Nat.add (sum2 xs Zero) (sum2 xs Zero)))

;; A shared list of lists, whose inner lists a match shares as it takes
;; them.
(def (rows [+ n : Nat]) (List &2 (List &2 Nat))
  (match n
    [Zero Nil]
    [(Succ p) (Con (range2 (Succ p)) (rows p))]))

(def (sums [xss : (List &2 (List &2 Nat))] [acc : Nat]) Nat
  (match xss
    [Nil acc]
    [(Con h t) (sums t (sum2 h acc))]))

(def (both-rows [+ xss : (List &2 (List &2 Nat))]) Nat (Nat.add (sums xss Zero) (sums xss Zero)))

;; A closure that captures a list: called, and dropped uncalled.
(def (holder [xs : (List Nat)]) (-> Nat Nat) (fn (m) (Nat.add m (sum xs Zero))))
(def (unused [xs : (List Nat)]) Nat (let ([f (holder xs)]) Zero))

(func (main)
  (print (sum (range (nat 10)) Zero))
  (print (inc-all (range (nat 3))))
  (print (first (range (nat 2)) (range (nat 5))))
  (print (both (range2 (nat 4))))
  (print (both-rows (rows (nat 3))))
  (print ((holder (range (nat 3))) (nat 1)))
  (print (unused (range (nat 4))))
  (write-int (live-cells))
  (newline))
