;; Bend as the new compiler builds it (next/bend): a definition whose
;; values are erased, a proof or a type, has no function (lower.sub). An
;; application of one is 0, which print writes as refl; one given fewer
;; arguments is a closure, which a definition can apply; and kernel code
;; can call one, from this module or another.
(require-unqualified bend "../../bend/bend.sub")
(require-unqualified base "../../bend/base.sub")

(def (same [n : Nat]) (== n n Nat) refl)
(def (Two) Type (Pair Nat Nat))

;; A proof of each Nat, given as a function, applied.
(def (at-zero [f : (-> [n : Nat] (== n n Nat))]) (== Zero Zero Nat) (f Zero))

(def (three) Nat (nat 3))
(def (pair) (Two) (Tuple (nat 1) (nat 2)))

(func (main)
  (print (same (nat 3)))
  (print (at-zero same))
  (print (Equal.sym Nat (nat 1) (nat 1) refl))
  (print (pair))
  (drop (same (three)))
  (drop (Equal.sym (three))))
