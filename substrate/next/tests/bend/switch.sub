;; Bend as the new compiler builds it (next/bend): a match of four ways or
;; more is a switch on its constructor's number, of a node, a packed term
;; or a flat value, other code running for those it does not name; and a
;; chain of a Nat's matches, as Nat patterns make, a switch on its count.
(require-unqualified bend "../../bend/bend.sub")
(require-unqualified base "../../bend/base.sub")
(require print "../../../lib/print.sub" write-int newline)

;; Nodes, and packed terms, of no field or of a U32.
(type Sh Data [Dot] [One [a : U32]] [Two [a : U32] [b : U32]] [More [s : Sh]] [Emp])


(def (size [s : Sh]) U32
  (match s
    [Dot 0]
    [(One a) a]
    [(Two a b) (U32.add a b)]
    [(More t) (U32.add 1 (size t))]
    [Emp 100]))

;; Other code for the constructors a match does not name.
(def (kind [s : Sh]) U32
  (match s
    [(Two a b) 2]
    [(More t) 3]
    [Emp 4]
    [_ 9]))

;; A flat value's number, its first word; the last constructor's case is
;; the one past the others.
(type Op Data [Inc [n : U32]] [Dec [n : U32]] [Set [n : U32] [m : U32]] [Nop] [Halt [n : U32]])

(def (step [o : Op] [+ x : U32]) U32
  (match o
    [(Inc n) (U32.add x n)]
    [(Dec n) (U32.sub x n)]
    [(Set n m) (U32.mul n m)]
    [Nop x]
    [(Halt n) n]))

(def (run [ops : (List Op)] [+ x : U32]) U32
  (match ops [Nil x] [(Con o t) (run t (step o x))]))

;; Nat numbers: a chain, its last case the one past them, of its
;; predecessor; and one written out as matches, each on the one before's
;; predecessor, which in its Zero case is 0.
(def (name [n : Nat]) U32
  (match n [(nat 0) 10] [(nat 1) 11] [(nat 2) 12] [(nat 3) 13] [(nat 4 p) (U32.add 100 (U32.from_nat p))]))

(def (near [n : Nat]) Nat
  (match n
    [Zero (nat 0)]
    [(Succ p) (match p [Zero p] [(Succ q) (match q [Zero (nat 7)] [(Succ r) r])])]))

;; Switches of numbers alone, each a table's: of a constructor of no
;; field, and of a Nat.
(type Day Data [Mon] [Tue] [Wed] [Thu] [Fri])

(def (hours [d : Day]) U32 (match d [Mon 8] [Tue 9] [Wed 7] [Thu 9] [Fri 5]))

(def (key [n : Nat]) U32 (match n [(nat 0) 5] [(nat 1) 6] [(nat 2) 7] [(nat 3 p) 8]))

(func (main)
  (print (size Dot))
  (print (size (One 5)))
  (print (size (Two 3 4)))
  (print (size (More (More (Two 2 3)))))
  (print (size Emp))
  (print (kind (One 1)))
  (print (kind (More Dot)))
  (print (kind Dot))
  (print (run (Con (Inc 5) (Con (Dec 2) (Con Nop (Con (Set 6 7) (Con (Inc 1) (Con (Halt 99) Nil)))))) 10))
  (print (run (Con (Set 2 3) (Con (Inc 4) Nil)) 0))
  (print (name (nat 0)))
  (print (name (nat 3)))
  (print (name (nat 4)))
  (print (name (nat 9)))
  (print (near (nat 0)))
  (print (near (nat 1)))
  (print (near (nat 2)))
  (print (near (nat 6)))
  (print (hours Mon))
  (print (hours Wed))
  (print (hours Fri))
  (print (key (nat 0)))
  (print (key (nat 2)))
  (print (key (nat 3)))
  (print (key (nat 40)))
  (write-int (live-cells))
  (newline))
