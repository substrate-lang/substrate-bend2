;; A slice of Bend2's Base library: datatypes, equality, Nat, Bool, Cmp, words and U32.
(language "lang.sub")

(provide Empty Unit unit Bool False True Either Inl Inr Sigma Tuple Nat Zero Succ Maybe None Some
         List Nil Con Pair Equal.cong Equal.sym Equal.trans Bool.not Nat.double Nat.add Nat.mul
         Cmp LT EQ GT Bool.and Bool.or Bool.xor Bool.cmp Bool.pick Cmp.is_lt Cmp.is_eq Cmp.is_gt Cmp.is_le Cmp.is_ge
         Word Word.Nil WNil Word.Con WCon U32 u32 Word.zero Word.not Word.and Word.or Word.xor Word.shl.put Word.shl
         Word.shl.out.con Word.shl.out Word.shr.pad Word.shr Word.cmp.fin Word.cmp Word.inc Word.adc Word.add Word.sub
         Word.to_nat Word.mul.go Word.mul U32.inc U32.add U32.sub U32.mul U32.not U32.and U32.or U32.xor U32.shl U32.shr
         U32.shln U32.shrn U32.cmp U32.is_eq U32.is_ne U32.is_lt U32.is_le U32.is_gt U32.is_ge U32.is_zero U32.to_nat
         U32.from_nat U32.divmod.go.fin U32.divmod.go.shl U32.divmod.go.rec U32.divmod.go U32.div.fin U32.div.if U32.div
         U32.mod.fin U32.mod.if U32.mod U32.min U32.max U32.clamp U32.pow U32.is_even)

(type Empty Data)

(type Unit Data [unit])

(type Bool Data [False] [True])

(type (Either a b [- A : (Kind a)] [- B : (Kind b)]) (Kind (meet a b))
  [Inl [value : A]]
  [Inr [value : B]])

(type (Sigma a b [- A : (Kind a)] [- B : (-> [- x : A] (Kind b))]) (Kind (meet a b))
  [Tuple [fst : A] [snd : (B fst)]])

(type Nat Data [Zero] [Succ [pred : Nat]])

(type (Maybe a [- A : (Kind a)]) (Kind a) [None] [Some [value : A]])

(type (List a [- A : (Kind a)]) (Kind a) [Nil] [Con [head : A] [tail : (List a A)]])

(law (Pair [- A : Type] [- B : Type]) Type)
(def (Pair A B) (Sigma &1 &1 A (fn (_) B)))

(law (Equal.cong [- A : Type] [- B : Type] [- f : (-> A B)] [- a : A] [- b : A] [e : (== a b A)])
     (== (f a) (f b) B))
(def (Equal.cong A B f a b e)
  (rewrite e (== (f a) (f _) B) refl))

(law (Equal.sym [- A : Type] [- a : A] [- b : A] [e : (== a b A)]) (== b a A))
(def (Equal.sym A a b e)
  (rewrite e (== _ a A) refl))

(law (Equal.trans [- A : Type] [- a : A] [- b : A] [- c : A] [ab : (== a b A)] [bc : (== b c A)]) (== a c A))
(def (Equal.trans A a b c ab bc)
  (rewrite bc (== a _ A) ab))

(def (Bool.not [b : Bool]) Bool
  (match b [False True] [True False]))

(def (Nat.double [n : Nat]) Nat
  (match n
    [Zero Zero]
    [(Succ p) (Succ (Succ (Nat.double p)))]))

(def (Nat.add [a : Nat] [b : Nat]) Nat
  (match a
    [Zero b]
    [(Succ p) (Succ (Nat.add p b))]))

(def (Nat.mul [a : Nat] [+ b : Nat]) Nat
  (match a
    [Zero Zero]
    [(Succ p) (Nat.add b (Nat.mul p b))]))

(type Cmp Data [LT] [EQ] [GT])

(def (Bool.and [a : Bool] [b : Bool]) Bool (match a [False False] [True b]))
(def (Bool.or [a : Bool] [b : Bool]) Bool (match a [False b] [True True]))
(def (Bool.xor [a : Bool] [b : Bool]) Bool (match a [False b] [True (Bool.not b)]))

(def (Bool.cmp [a : Bool] [b : Bool]) Cmp
  (match a b
    [(False False) EQ]
    [(False True) LT]
    [(True False) GT]
    [(True True) EQ]))

(def (Bool.pick [- A : Type] [c : Bool] [a : A] [b : A]) A (match c [False b] [True a]))

(def (Cmp.is_lt [c : Cmp]) Bool (match c [LT True] [EQ False] [GT False]))
(def (Cmp.is_eq [c : Cmp]) Bool (match c [LT False] [EQ True] [GT False]))
(def (Cmp.is_gt [c : Cmp]) Bool (match c [LT False] [EQ False] [GT True]))
(def (Cmp.is_le [c : Cmp]) Bool (match c [LT True] [EQ True] [GT False]))
(def (Cmp.is_ge [c : Cmp]) Bool (match c [LT False] [EQ True] [GT True]))

;; The checker evaluates the definitions below, but lower.sub compiles U32 to a machine word and
;; these operations to wasm instructions, so the two versions must give the same results.
;; Word.adc is written out as a truth table because Bend2's version uses a helper that calls the
;; Word.adc law before Base fills it in.

(law (Word [n : Nat]) Data)

(type Word.Nil Data [WNil])
(type (Word.Con [- p : Nat]) Data [WCon [head : Bool] [tail : (Word p)]])

(type U32 Data [u32 [data : (Word (nat 32))]])

(def (Word n)
  (match n
    [Zero Word.Nil]
    [(Succ p) (Word.Con p)]))

(def (Word.zero [n : Nat]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (WCon False (Word.zero p))]))

(def (Word.not [n : Nat] [w : (Word n)]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (match w [(WCon b t) (WCon (Bool.not b) (Word.not p t))])]))

(def (Word.and [n : Nat] [a : (Word n)] [b : (Word n)]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (match a b [((WCon ab at) (WCon bb bt)) (WCon (Bool.and ab bb) (Word.and p at bt))])]))

(def (Word.or [n : Nat] [a : (Word n)] [b : (Word n)]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (match a b [((WCon ab at) (WCon bb bt)) (WCon (Bool.or ab bb) (Word.or p at bt))])]))

(def (Word.xor [n : Nat] [a : (Word n)] [b : (Word n)]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (match a b [((WCon ab at) (WCon bb bt)) (WCon (Bool.xor ab bb) (Word.xor p at bt))])]))

(def (Word.shl.put [n : Nat] [c : Bool] [w : (Word n)]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (match w [(WCon b t) (WCon c (Word.shl.put p b t))])]))

(def (Word.shl [n : Nat] [w : (Word n)]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (match w [(WCon b t) (WCon False (Word.shl.put p b t))])]))

(def (Word.shl.out.con [- p : Nat] [c : Bool] [r : (Pair Bool (Word p))]) (Pair Bool (Word (Succ p)))
  (match r [(Tuple hi t2) (Tuple hi (WCon c t2))]))

(def (Word.shl.out [n : Nat] [c : Bool] [w : (Word n)]) (Pair Bool (Word n))
  (match n
    [Zero (Tuple c WNil)]
    [(Succ p) (match w [(WCon b t) (Word.shl.out.con p c (Word.shl.out p b t))])]))

(def (Word.shr.pad [n : Nat] [w : (Word n)]) (Word (Succ n))
  (match n
    [Zero (WCon False w)]
    [(Succ p) (match w [(WCon b t) (WCon b (Word.shr.pad p t))])]))

(def (Word.shr [n : Nat] [w : (Word n)]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (match w [(WCon b t) (Word.shr.pad p t)])]))

(def (Word.cmp.fin [ab : Bool] [bb : Bool] [t : Cmp]) Cmp
  (match t [LT LT] [EQ (Bool.cmp ab bb)] [GT GT]))

(def (Word.cmp [n : Nat] [a : (Word n)] [b : (Word n)]) Cmp
  (match n
    [Zero EQ]
    [(Succ p) (match a b [((WCon ab at) (WCon bb bt)) (Word.cmp.fin ab bb (Word.cmp p at bt))])]))

(def (Word.inc [n : Nat] [w : (Word n)]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p) (match w [(WCon False t) (WCon True t)] [(WCon True t) (WCon False (Word.inc p t))])]))

;; a + b + c, or, if f, a + not b + c (a - b when c is True), bit by bit.
(def (Word.adc [n : Nat] [a : (Word n)] [b : (Word n)] [f : Bool] [c : Bool]) (Word n)
  (match n
    [Zero WNil]
    [(Succ p)
     (match a b f c
       [((WCon False at) (WCon False bt) False False) (WCon False (Word.adc p at bt False False))]
       [((WCon False at) (WCon False bt) False True) (WCon True (Word.adc p at bt False False))]
       [((WCon False at) (WCon True bt) False False) (WCon True (Word.adc p at bt False False))]
       [((WCon False at) (WCon True bt) False True) (WCon False (Word.adc p at bt False True))]
       [((WCon True at) (WCon False bt) False False) (WCon True (Word.adc p at bt False False))]
       [((WCon True at) (WCon False bt) False True) (WCon False (Word.adc p at bt False True))]
       [((WCon True at) (WCon True bt) False False) (WCon False (Word.adc p at bt False True))]
       [((WCon True at) (WCon True bt) False True) (WCon True (Word.adc p at bt False True))]
       [((WCon False at) (WCon False bt) True False) (WCon True (Word.adc p at bt True False))]
       [((WCon False at) (WCon False bt) True True) (WCon False (Word.adc p at bt True True))]
       [((WCon False at) (WCon True bt) True False) (WCon False (Word.adc p at bt True False))]
       [((WCon False at) (WCon True bt) True True) (WCon True (Word.adc p at bt True False))]
       [((WCon True at) (WCon False bt) True False) (WCon False (Word.adc p at bt True True))]
       [((WCon True at) (WCon False bt) True True) (WCon True (Word.adc p at bt True True))]
       [((WCon True at) (WCon True bt) True False) (WCon True (Word.adc p at bt True False))]
       [((WCon True at) (WCon True bt) True True) (WCon False (Word.adc p at bt True True))])]))

(def (Word.add [n : Nat] [a : (Word n)] [b : (Word n)]) (Word n) (Word.adc n a b False False))
(def (Word.sub [n : Nat] [a : (Word n)] [b : (Word n)]) (Word n) (Word.adc n a b True True))

(def (Word.to_nat [n : Nat] [w : (Word n)]) Nat
  (match n
    [Zero Zero]
    [(Succ p)
     (match w
       [(WCon False t) (Nat.double (Word.to_nat p t))]
       [(WCon True t) (Succ (Nat.double (Word.to_nat p t)))])]))

(def (Word.mul.go [+ n : Nat] [m : Nat] [a : (Word m)] [+ b : (Word n)] [acc : (Word n)]) (Word n)
  (match m
    [Zero acc]
    [(Succ mp)
     (match a
       [(WCon False at) (Word.mul.go n mp at (Word.shl n b) acc)]
       [(WCon True at) (Word.mul.go n mp at (Word.shl n b) (Word.add n acc b))])]))

(def (Word.mul [+ n : Nat] [a : (Word n)] [b : (Word n)]) (Word n) (Word.mul.go n n a b (Word.zero n)))

(def (U32.inc [a : U32]) U32 (match a [(u32 x) (u32 (Word.inc (nat 32) x))]))
(def (U32.add [a : U32] [b : U32]) U32 (match a b [((u32 x) (u32 y)) (u32 (Word.add (nat 32) x y))]))
(def (U32.sub [a : U32] [b : U32]) U32 (match a b [((u32 x) (u32 y)) (u32 (Word.sub (nat 32) x y))]))
(def (U32.mul [a : U32] [b : U32]) U32 (match a b [((u32 x) (u32 y)) (u32 (Word.mul (nat 32) x y))]))
(def (U32.not [a : U32]) U32 (match a [(u32 x) (u32 (Word.not (nat 32) x))]))
(def (U32.and [a : U32] [b : U32]) U32 (match a b [((u32 x) (u32 y)) (u32 (Word.and (nat 32) x y))]))
(def (U32.or [a : U32] [b : U32]) U32 (match a b [((u32 x) (u32 y)) (u32 (Word.or (nat 32) x y))]))
(def (U32.xor [a : U32] [b : U32]) U32 (match a b [((u32 x) (u32 y)) (u32 (Word.xor (nat 32) x y))]))
(def (U32.shl [a : U32]) U32 (match a [(u32 x) (u32 (Word.shl (nat 32) x))]))
(def (U32.shr [a : U32]) U32 (match a [(u32 x) (u32 (Word.shr (nat 32) x))]))

(def (U32.shln [a : U32] [n : Nat]) U32 (match n [Zero a] [(Succ p) (U32.shl (U32.shln a p))]))
(def (U32.shrn [a : U32] [n : Nat]) U32 (match n [Zero a] [(Succ p) (U32.shr (U32.shrn a p))]))

(def (U32.cmp [a : U32] [b : U32]) Cmp (match a b [((u32 x) (u32 y)) (Word.cmp (nat 32) x y)]))
(def (U32.is_eq [a : U32] [b : U32]) Bool (Cmp.is_eq (U32.cmp a b)))
(def (U32.is_ne [a : U32] [b : U32]) Bool (Bool.not (Cmp.is_eq (U32.cmp a b))))
(def (U32.is_lt [a : U32] [b : U32]) Bool (Cmp.is_lt (U32.cmp a b)))
(def (U32.is_le [a : U32] [b : U32]) Bool (Cmp.is_le (U32.cmp a b)))
(def (U32.is_gt [a : U32] [b : U32]) Bool (Cmp.is_gt (U32.cmp a b)))
(def (U32.is_ge [a : U32] [b : U32]) Bool (Cmp.is_ge (U32.cmp a b)))
(def (U32.is_zero [a : U32]) Bool (U32.is_eq a 0))

(def (U32.to_nat [a : U32]) Nat (match a [(u32 w) (Word.to_nat (nat 32) w)]))
(def (U32.from_nat [n : Nat]) U32 (match n [Zero 0] [(Succ p) (U32.inc (U32.from_nat p))]))

(def (U32.divmod.go.fin [- p : Nat] [q : (Word p)] [s : U32] [b : U32] [g : Bool]) (Pair (Word (Succ p)) U32)
  (match g
    [True (Tuple (WCon True q) (U32.sub s b))]
    [False (Tuple (WCon False q) s)]))

(def (U32.divmod.go.shl [- p : Nat] [q : (Word p)] [+ b : U32] [ts : (Pair Bool (Word (nat 32)))]) (Pair (Word (Succ p)) U32)
  (match ts
    [(Tuple t s)
     (let ([+ s2 (the U32 (u32 s))]) (U32.divmod.go.fin p q s2 b (Bool.or t (U32.is_ge s2 b))))]))

(def (U32.divmod.go.rec [- p : Nat] [a0 : Bool] [+ b : U32] [qr : (Pair (Word p) U32)]) (Pair (Word (Succ p)) U32)
  (match qr [(Tuple q r) (match r [(u32 rw) (U32.divmod.go.shl p q b (Word.shl.out (nat 32) a0 rw))])]))

(def (U32.divmod.go [m : Nat] [a : (Word m)] [+ b : U32]) (Pair (Word m) U32)
  (match m a
    [(Zero WNil) (Tuple WNil 0)]
    [((Succ p) (WCon a0 hi)) (U32.divmod.go.rec p a0 b (U32.divmod.go p hi b))]))

(def (U32.div.fin [qr : (Pair (Word (nat 32)) U32)]) U32 (match qr [(Tuple q r) (u32 q)]))

(def (U32.div.if [aw : (Word (nat 32))] [b : U32] [z : Bool]) U32
  (match z [True 0] [False (U32.div.fin (U32.divmod.go (nat 32) aw b))]))

(def (U32.div [a : U32] [+ b : U32]) U32 (match a [(u32 aw) (U32.div.if aw b (U32.is_zero b))]))

(def (U32.mod.fin [qr : (Pair (Word (nat 32)) U32)]) U32 (match qr [(Tuple q r) r]))

(def (U32.mod.if [aw : (Word (nat 32))] [b : U32] [z : Bool]) U32
  (match z [True (u32 aw)] [False (U32.mod.fin (U32.divmod.go (nat 32) aw b))]))

(def (U32.mod [a : U32] [+ b : U32]) U32 (match a [(u32 aw) (U32.mod.if aw b (U32.is_zero b))]))

(def (U32.min [+ a : U32] [+ b : U32]) U32 (Bool.pick U32 (U32.is_lt a b) a b))
(def (U32.max [+ a : U32] [+ b : U32]) U32 (Bool.pick U32 (U32.is_lt a b) b a))
(def (U32.clamp [x : U32] [lo : U32] [hi : U32]) U32 (U32.min (U32.max x lo) hi))

(def (U32.pow [+ a : U32] [n : Nat]) U32 (match n [Zero 1] [(Succ p) (U32.mul a (U32.pow a p))]))
(def (U32.is_even [a : U32]) Bool (U32.is_zero (U32.and a 1)))
